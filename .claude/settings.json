{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dart pub get)",
      "Bash(dart pub get *)",
      "Bash(dart pub add *)",
      "Bash(dart analyze)",
      "Bash(dart analyze *)",
      "Bash(dart format *)",
      "Bash(dart test)",
      "Bash(dart test *)",
      "Bash(dart fix *)",
      "Bash(flutter --version)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  }
}

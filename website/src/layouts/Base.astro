---
import '@fontsource/ancizar-serif/400.css';
import '@fontsource/ancizar-serif/700.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/stage.css';

import { Picture } from 'astro:assets';

import Icon from '../components/Icon.astro';
import emblem from '../../../design/source/brand/emblem.png';
import wordmark from '../assets/plates/nav-wordmark.png';
import village from '../../../app/assets/stage/village.webp';
import backstage from '../../../app/assets/stage/backstage.webp';
import theatre from '../../../app/assets/stage/theatre.webp';
import oak from '../../../app/assets/stage/scenery/oak.webp';
import house from '../../../app/assets/stage/scenery/house.webp';
import curtain from '../../../app/assets/stage/scenery/curtain.webp';
import { alternates, defaultLang, languages, langs, path, repoUrl, ui, type Lang, type Page } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Header floats over the hero image; its logo is the hero's wordmark, docked once scrolled. */
  overlay?: boolean;
  /** The page draws its own navigation (the game-box hero). */
  bare?: boolean;
  /** The localized page this is; omitted for single-language pages such as the German docs. */
  page?: Page;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** The stage set behind the page (task 012); home draws its own scenes. */
  backdrop?: 'village' | 'backstage' | 'theatre' | 'none';
}

const { lang, title, description, overlay = false, bare = false, page, noindex = false } = Astro.props;
const backdrop = Astro.props.backdrop ?? (overlay ? 'none' : 'backstage');
const sets = { village, backstage, theatre };
const wings = { village: [oak, house], backstage: [], theatre: [curtain, curtain] };
const t = ui[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const versions = alternates(page ?? 'home');
const others = versions.filter((version) => version.lang !== lang);
const home = path('home', lang);

const nav = [
  { href: `${home}#spiel`, label: t.nav.play },
  { href: `${home}#rollen`, label: t.nav.cast },
  { href: `${home}#wolfsspur`, label: t.nav.trail },
  { href: path('docs', lang), label: t.nav.docs },
  { href: path('download', lang), label: t.nav.download },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}#site`, url: site.toString(), name: 'Whowolf', inLanguage: langs },
    {
      '@type': 'VideoGame',
      name: 'Whowolf',
      url: site.toString(),
      description: ui[lang].meta.description,
      genre: ['Party game', 'Social deduction'],
      gamePlatform: ['Android', 'iOS', 'macOS', 'Windows', 'Linux'],
      playMode: 'MultiPlayer',
      numberOfPlayers: { '@type': 'QuantitativeValue', minValue: 5, maxValue: 20 },
      creativeWorkStatus: 'Beta',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      codeRepository: repoUrl,
      image: new URL('/og.jpg', site).toString(),
      inLanguage: langs,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#141a33" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {overlay && <noscript><style is:inline>.site-header--overlay .brand--wordmark { visibility: visible !important; }</style></noscript>}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      page && (
        <>
          {versions.map((version) => (
            <link rel="alternate" hreflang={version.lang} href={new URL(version.href, site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(path(page, defaultLang), site)} />
        </>
      )
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Whowolf" />
    <meta property="og:locale" content={languages[lang].og} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Whowolf: Werwolf, Seherin und Dorfbewohner als Pappfiguren vor einem nächtlichen Dorf" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={{ 'has-backdrop': backdrop !== 'none' }}>
    <a class="skip" href="#inhalt">{t.skip}</a>
    {
      backdrop !== 'none' && (
        <div class="backdrop" aria-hidden="true">
          <Picture src={sets[backdrop]} alt="" formats={['avif', 'webp']} widths={[640, 960, 1254]} sizes="100vw" quality={55} loading="eager" />
          {wings[backdrop].map((src, i) => (
            <div class:list={['piece', i === 0 ? 'piece--left' : 'piece--right', { 'piece--mirror': i === 1 && backdrop === 'theatre' }]} style={`--h: ${backdrop === 'theatre' ? '104%' : '80%'}; --hide: ${backdrop === 'theatre' ? '45%' : '55%'}`}>
              <Picture src={src} alt="" formats={['avif', 'webp']} widths={[240, 400]} sizes="min(28vw, 360px)" quality={62} loading="lazy" />
            </div>
          ))}
        </div>
      )
    }

    {(<header class:list={['site-header', { 'site-header--overlay': overlay, 'site-header--mobile-only': bare }]}>
      <div class="site-header__inner">
        {
          overlay ? (
            <a class="brand brand--wordmark" href={home} aria-label="Whowolf" data-brand>
              <Picture src={wordmark} alt="" formats={['avif', 'webp']} widths={[120, 240, 360]} sizes="120px" loading="eager" />
            </a>
          ) : (
            <a class="brand" href={home} aria-label="Whowolf">
              <Picture src={emblem} alt="" formats={['avif', 'webp']} widths={[48, 96]} sizes="44px" loading="eager" />
              <span>Whowolf</span>
            </a>
          )
        }

        <nav class="nav-desktop" aria-label={t.nav.menu}>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>

        <div class="header-actions">
          {
            others.map((version) => (
              <a
                class="lang-switch"
                href={version.href}
                hreflang={version.lang}
                lang={version.lang}
                aria-label={`${t.nav.language}: ${languages[version.lang].label}`}
              >
                {version.lang.toUpperCase()}
              </a>
            ))
          }
          <a class="github" href={repoUrl} aria-label="GitHub"><Icon name="github" /></a>

          <details class="menu" data-menu>
            <summary aria-label={t.nav.menu}>
              <span class="menu__bars" aria-hidden="true"></span>
              <span class="menu__label">{t.nav.menu}</span>
            </summary>
            <nav class="menu__panel" aria-label={t.nav.menu}>
              <ul>
                {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                <li><a href={repoUrl}>GitHub</a></li>
                {others.map((version) => (
                  <li><a href={version.href} hreflang={version.lang} lang={version.lang}>{languages[version.lang].label}</a></li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>)}

    <div id="inhalt">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <Picture src={emblem} alt="" formats={['avif', 'webp']} widths={[96, 192]} sizes="80px" />
          <div>
            <p class="site-footer__name">Whowolf</p>
            <p>{t.footer.tagline}</p>
            <p class="site-footer__status">
              <span class="stamp stamp--status">{t.status.badge}</span>
              <a class="site-footer__report" href={`${repoUrl}/issues/new/choose`}>{t.status.report}</a>
            </p>
          </div>
        </div>
        <nav aria-label="Footer">
          <ul>
            <li><a href={path('docs', lang)}>{t.nav.docs}</a></li>
            <li><a href={path('download', lang)}>{t.nav.download}</a></li>
            <li><a href={repoUrl}>GitHub</a></li>
            <li><a href={`${repoUrl}/blob/main/SECURITY.md`}>{t.footer.security}</a></li>
            <li><a href={path('imprint', lang)}>{t.footer.imprint}</a></li>
            <li><a href={path('privacy', lang)}>{t.footer.privacy}</a></li>
            {others.map((version) => (
              <li><a href={version.href} hreflang={version.lang} lang={version.lang}>{languages[version.lang].label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>

    <aside class="beta-strip" data-beta aria-label={t.status.badge}>
      <span class="beta-strip__stamp">{t.status.badge}</span>
      <span class="beta-strip__long">{t.status.line}</span>
      <span class="beta-strip__short">{t.status.short}</span>
      <a href={`${repoUrl}/issues`}>{t.status.report}</a>
      <button class="beta-strip__close" type="button" data-beta-close aria-label={t.nav.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
      </button>
    </aside>

    <div class="consent" data-consent hidden role="region" aria-label={t.consent.title}>
      <Picture class="consent__seal" src={emblem} alt="" formats={['avif', 'webp']} widths={[96, 192]} sizes="56px" />
      <div class="consent__text">
        <p class="consent__title">{t.consent.title}</p>
        <p>{t.consent.text} <a href={path('privacy', lang)}>{t.consent.more}</a></p>
      </div>
      <button class="consent__ok" type="button" data-consent-ok>{t.consent.ok}</button>
    </div>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  /* A small playbill slip in the corner: emblem seal, two lines, one button. */
  .consent {
    position: fixed;
    z-index: 80;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.9rem;
    align-items: center;
    width: min(100% - 1.5rem, 25rem);
    padding: 1.1rem 1.2rem 1.15rem;
    border-radius: 0.9rem;
    color: var(--ink);
    background: #f7ecd2;
    box-shadow:
      inset 0 0 0 0.3rem #f7ecd2,
      inset 0 0 0 0.38rem #b98a43,
      0 1.2rem 2.6rem rgb(0 0 0 / 0.55);
    animation: consent-in 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .consent[hidden] {
    display: none;
  }
  .consent :global(.consent__seal) {
    width: 3.2rem;
    height: auto;
    grid-row: span 2;
    align-self: start;
    filter: drop-shadow(0 0.3rem 0.4rem rgb(42 27 18 / 0.3));
  }
  .consent__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .consent__text p + p {
    margin-top: 0.2rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .consent a {
    color: var(--curtain-600);
    font-weight: 600;
  }
  .consent__ok {
    grid-column: 2;
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0.55rem 1.2rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: #f7ecd2;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.3s var(--ease-out);
  }
  .consent__ok:hover {
    background: var(--curtain-600);
    transform: translateY(-1px);
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(1rem) rotate(1deg);
    }
  }
  @media (max-width: 560px) {
    .consent {
      right: 0.6rem;
      left: 0.6rem;
      bottom: 0.6rem;
      width: auto;
      grid-template-columns: auto 1fr auto;
      padding: 0.8rem 0.9rem;
      gap: 0.3rem 0.7rem;
    }
    .consent :global(.consent__seal) {
      width: 2.4rem;
      grid-row: auto;
      align-self: center;
    }
    .consent__title {
      display: none;
    }
    .consent__text p + p {
      margin: 0;
      font-size: 0.8rem;
    }
    .consent__ok {
      grid-column: auto;
      margin: 0;
      padding: 0.5rem 0.9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent {
      animation: none;
    }
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -5rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-s);
    background: var(--lantern-400);
    color: var(--ink);
    font-weight: 800;
  }
  .skip:focus {
    top: 1rem;
  }

  /* The header stays with you: clear over the stage, solid once the page moves on. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgb(13 20 15 / 0.94);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
  .site-header--mobile-only {
    display: none;
  }
  /* Developer beta: a slip pinned to the foot of the window, above the
     page, until it is closed (remembered on this device). */
  .beta-strip {
    position: fixed;
    z-index: 70;
    left: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.4rem 0.9rem;
    max-width: min(100% - 2.5rem, 44rem);
    margin: 0;
    padding: 0.5rem 0.4rem 0.5rem 0.9rem;
    border-radius: 0.8rem;
    background: rgb(20 17 15 / 0.94);
    box-shadow:
      inset 0 0 0 1px rgb(255 200 120 / 0.28),
      0 0.8rem 2rem rgb(0 0 0 / 0.5);
    color: #efe2c4;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.35;
    animation: beta-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
  }
  .beta-strip[hidden] {
    display: none;
  }
  /* Beside the privacy notice in the right corner, never under it. */
  :global(body:has(.consent:not([hidden]))) .beta-strip {
    max-width: min(100% - 30rem, 44rem);
  }
  @keyframes beta-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
  .beta-strip__stamp {
    flex: none;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    background: repeating-linear-gradient(-45deg, var(--lantern-400) 0 10px, var(--lantern-300) 10px 20px);
    color: var(--night-950);
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .beta-strip a {
    flex: none;
    color: var(--lantern-300);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .beta-strip__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -0.4rem 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .beta-strip__close:hover,
  .beta-strip__close:focus-visible {
    background: rgb(255 255 255 / 0.1);
  }
  .beta-strip__short {
    display: none;
  }
  @media (max-width: 900px) {
    .beta-strip {
      left: 0.75rem;
      right: 0.75rem;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      max-width: none;
    }
    .beta-strip__long {
      display: none;
    }
    .beta-strip__short {
      display: inline;
      flex: 1;
    }
    /* The privacy notice comes first; the slip waits until it is read. */
    :global(body:has(.consent:not([hidden]))) .beta-strip {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .beta-strip__short {
      display: none;
    }
    .beta-strip a {
      margin-left: auto;
    }
  }
  @media (max-width: 900px) {
    .site-header--mobile-only {
      display: block;
      background: var(--night-900);
    }
  }
  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header--overlay.is-solid {
    background: rgb(13 20 15 / 0.94);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.35);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(100% - 2 * var(--gutter), 84rem);
    min-height: 4.75rem;
    margin-inline: auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: var(--moon-100);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
    text-shadow: 0 2px 10px rgb(5 8 20 / 0.6);
  }
  .brand :global(img) {
    width: 44px;
    height: auto;
  }
  .brand--wordmark :global(picture) {
    display: contents;
  }
  .brand--wordmark :global(img) {
    width: auto;
    height: 2.9rem;
    filter: drop-shadow(0 0.2rem 0.5rem rgb(8 10 28 / 0.6));
  }
  /* Over the hero its big wordmark is the logo; the header's own shows once the
     header turns solid (without script the noscript style in the head shows it). */
  .site-header--overlay:not(.is-solid) .brand--wordmark {
    visibility: hidden;
  }

  .nav-desktop ul {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-desktop a,
  .lang-switch,
  .github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 999px;
    color: var(--moon-100);
    font-weight: 700;
    text-decoration: none;
    text-shadow: 0 2px 10px rgb(5 8 20 / 0.6);
    transition: background-color 0.2s ease;
  }
  .nav-desktop a:hover,
  .lang-switch:hover,
  .github:hover {
    color: var(--moon-100);
    background: rgb(246 231 193 / 0.12);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .lang-switch {
    min-width: 44px;
    padding: 0 0.6rem;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    box-shadow: inset 0 0 0 2px rgb(246 231 193 / 0.35);
  }
  .github {
    width: 44px;
    padding: 0;
  }
  .github :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  /* Mobile menu: a details/summary disclosure, works without script. */
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0 0.95rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 800;
    list-style: none;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
  }
  .menu__bars {
    position: relative;
  }
  .menu__bars::before,
  .menu__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu__bars::before {
    top: -6px;
  }
  .menu__bars::after {
    top: 6px;
  }
  .menu[open] .menu__bars {
    background: transparent;
  }
  .menu[open] .menu__bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu[open] .menu__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }
  .menu__panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    width: min(18rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.75rem;
    border-radius: var(--radius-m);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
    box-shadow: 0 18px 40px rgb(5 8 20 / 0.5);
    transform-origin: top right;
    animation: menu-in 0.35s var(--ease-puppet);
  }
  .menu__panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__panel a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.85rem;
    border-radius: var(--radius-s);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-decoration: none;
  }
  .menu__panel a:hover {
    color: var(--ink);
    background: rgb(42 27 18 / 0.08);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.96) rotate(-1deg);
    }
  }

  @media (max-width: 900px) {
    .nav-desktop,
    .github {
      display: none;
    }
    .menu {
      display: block;
    }
  }
  @media (max-width: 420px) {
    .menu__label {
      display: none;
    }
    .menu summary {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
  }

  .site-footer {

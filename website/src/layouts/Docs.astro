---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import Base from './Base.astro';
import { docTitle, groupDocs } from '../lib/docs';

interface Props {
  title: string;
  description: string;
  current?: CollectionEntry<'docs'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, current, headings = [] } = Astro.props;
const groups = groupDocs(await getCollection('docs'));
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base lang="de" title={title} description={description}>
  <div class="docs container">
    <nav class="docs__nav" aria-label="Dokumentation">
      <a class="docs__home" href="/docs/" aria-current={current ? undefined : 'page'}>Übersicht</a>
      {
        groups.map((group) => (
          <div class="docs__group">
            <p class="docs__group-title">{group.title}</p>
            <ul>
              {group.items.map((entry) => (
                <li>
                  <a href={`/docs/${entry.id}/`} aria-current={entry.id === current?.id ? 'page' : undefined}>
                    {docTitle(entry)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <main class="docs__main">
      <slot />
    </main>

    {
      toc.length > 1 && (
        <aside class="docs__toc" aria-label="Auf dieser Seite">
          <p class="docs__group-title">Auf dieser Seite</p>
          <ul>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  /* The docs are the rule booklet: a contents column on the felt, the page itself on paper. */
  .docs {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 13rem;
    gap: var(--space-4);
    align-items: start;
    width: min(100% - 2rem, 88rem);
    padding-block: var(--space-4) var(--space-5);
  }
  .docs__main {
    min-width: 0;
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    border-radius: 0.6rem;
    color: var(--ink);
    background: #f7ecd2;
    box-shadow:
      inset 0 0 0 0.55rem #f7ecd2,
      inset 0 0 0 0.65rem #b98a43,
      inset 0 0 0 0.85rem #f7ecd2,
      inset 0 0 0 0.92rem #b98a43,
      0 1.4rem 2.6rem rgb(0 0 0 / 0.45);
  }
  .docs__nav,
  .docs__toc {
    position: sticky;
    top: var(--space-3);
    max-height: calc(100vh - 3rem);
    overflow: auto;
    font-size: 0.95rem;
  }
  .docs__home {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--moon-100);
    text-decoration: none;
  }
  .docs__home::before {
    content: '';
    width: 1.6rem;
    height: 2rem;
    border-radius: 0.2rem;
    background: #141d30;
    box-shadow: inset 0 0 0 0.15rem #b98a43;
  }
  .docs__group + .docs__group {
    margin-top: var(--space-3);
  }
  .docs__group-title {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--lantern-300);
  }
  .docs__nav ul,
  .docs__toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs__nav li a,
  .docs__toc li a {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-s);
    color: var(--moon-200);
    text-decoration: none;
    line-height: 1.35;
  }
  .docs__nav li a:hover,
  .docs__toc li a:hover {
    color: var(--moon-100);
    background: rgb(246 232 198 / 0.07);
  }
  .docs__nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--paper);
    font-weight: 700;
  }
  .docs__home[aria-current='page'] {
    color: var(--lantern-300);
  }
  .docs__toc {
    padding-left: 0.9rem;
    border-left: 1px dotted rgb(246 232 198 / 0.3);
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .docs__toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .docs {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      width: calc(100% - 1rem);
      padding-top: var(--space-3);
    }
    .docs__nav {
      position: static;
      max-height: none;
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 0.4rem;
      scrollbar-width: none;
    }
    .docs__home,
    .docs__group-title {
      display: none;
    }
    .docs__group,
    .docs__group + .docs__group,
    .docs__nav ul {
      display: contents;
      margin: 0;
    }
    .docs__nav li a {
      white-space: nowrap;
      padding: 0.45rem 0.85rem;
      border: 1px solid rgb(246 232 198 / 0.3);
      border-radius: 999px;
    }
    .docs__main {
      padding: 1.6rem 1.2rem;
      box-shadow:
        inset 0 0 0 0.4rem #f7ecd2,
        inset 0 0 0 0.48rem #b98a43,
        0 1rem 2rem rgb(0 0 0 / 0.4);
    }
  }
</style>

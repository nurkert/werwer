---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import Base from './Base.astro';
import { docTitle, groupDocs } from '../lib/docs';

interface Props {
  title: string;
  description: string;
  current?: CollectionEntry<'docs'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, current, headings = [] } = Astro.props;
const groups = groupDocs(await getCollection('docs'));
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base lang="de" title={title} description={description}>
  <div class="docs container">
    <nav class="docs__nav" aria-label="Dokumentation">
      <a class="docs__home" href="/docs/" aria-current={current ? undefined : 'page'}>Übersicht</a>
      {
        groups.map((group) => (
          <div class="docs__group">
            <p class="docs__group-title">{group.title}</p>
            <ul>
              {group.items.map((entry) => (
                <li>
                  <a href={`/docs/${entry.id}/`} aria-current={entry.id === current?.id ? 'page' : undefined}>
                    {docTitle(entry)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <main class="docs__main">
      <slot />
    </main>

    {
      toc.length > 1 && (
        <aside class="docs__toc" aria-label="Auf dieser Seite">
          <p class="docs__group-title">Auf dieser Seite</p>
          <ul>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr) 13rem;
    gap: var(--space-5);
    align-items: start;
    width: min(100% - 2rem, 84rem);
    padding-block: var(--space-4) var(--space-6);
  }
  .docs__nav,
  .docs__toc {
    position: sticky;
    top: var(--space-3);
    max-height: calc(100vh - 3rem);
    overflow: auto;
    font-size: 0.95rem;
  }
  .docs__home {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--moon-100);
    text-decoration: none;
  }
  .docs__group + .docs__group {
    margin-top: var(--space-3);
  }
  .docs__group-title {
    margin-bottom: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-500);
  }
  .docs__nav ul,
  .docs__toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs__nav li a,
  .docs__toc li a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-s);
    color: var(--moon-200);
    text-decoration: none;
    line-height: 1.35;
  }
  .docs__nav li a:hover,
  .docs__toc li a:hover {
    color: var(--moon-100);
    background: rgb(246 231 193 / 0.06);
  }
  .docs__nav a[aria-current='page'] {
    color: var(--night-900);
    background: var(--lantern-400);
  }
  .docs__home[aria-current='page'] {
    color: var(--lantern-400);
    background: none;
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .docs__toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .docs {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .docs__nav {
      position: static;
      max-height: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--night-700);
    }
    .docs__home,
    .docs__group-title {
      display: none;
    }
    .docs__group,
    .docs__group + .docs__group,
    .docs__nav ul {
      display: contents;
      margin: 0;
    }
    .docs__nav li a {
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--night-500);
      border-radius: 999px;
    }
  }
</style>

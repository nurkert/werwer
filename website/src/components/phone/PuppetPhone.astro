---
// A cardboard puppet phone: the frame picture, a status bar and the screens of its
// timeline stacked on top of each other. The story script shows one at a time by toggling
// `is-on` on the screen whose `data-from` beat was reached last; without script the first
// screen stays visible.
import { Picture } from 'astro:assets';

import phoneEdge from '../../../../design/source/brand/phone-edge.png';
import phoneIsland from '../../../../design/source/brand/phone-island.png';
import type { StoryPhone } from '../../lib/phone-screens';
import PhoneScreen from './PhoneScreen.astro';

interface Props {
  phone: StoryPhone;
}
const { phone } = Astro.props;
const formats = ['avif', 'webp'] as const;
---

<Picture class="frame" src={phone.frame === 'island' ? phoneIsland : phoneEdge} alt="" formats={formats} widths={[300, 600]} sizes="20vw" loading="eager" />
<div class:list={['pscreen', { 'pscreen--island': phone.frame === 'island' }]} data-phone>
  <p class="sb"><span>{phone.time}</span><span class="sb__icons"><i></i><i></i><i></i></span></p>
  {
    phone.timeline.map((step, i) => (
      <div class:list={['ps', { 'is-on': i === 0 }]} data-from={step.from}>
        <PhoneScreen screen={step.screen} />
      </div>
    ))
  }
</div>

<style>
  .pscreen {
    position: absolute;
    left: 10.8%;
    top: 5.5%;
    width: 78%;
    height: 89.2%;
    overflow: hidden;
    border-radius: 14% / 9.5%;
    container-type: inline-size;
    background:
      radial-gradient(ellipse 120% 60% at 50% 0%, #2b3a6e, transparent 70%),
      linear-gradient(180deg, #18213f, #0f1530);
    color: #f6e8c6;
    font-family: 'Manrope Variable', system-ui, sans-serif;
  }
  .sb {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    padding: 5cqw 9cqw 0 10cqw;
    font-size: 6.5cqw;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .pscreen--island .sb {
    padding-top: 4.2cqw;
  }
  .sb__icons {
    display: flex;
    gap: 1.6cqw;
    align-items: flex-end;
  }
  .sb__icons i {
    display: block;
    width: 2.2cqw;
    border-radius: 1cqw;
    background: currentColor;
  }
  .sb__icons i:nth-child(1) {
    height: 3cqw;
  }
  .sb__icons i:nth-child(2) {
    height: 4.4cqw;
  }
  .sb__icons i:nth-child(3) {
    width: 7cqw;
    height: 4cqw;
    border-radius: 1.2cqw;
    background: none;
    box-shadow: inset 0 0 0 0.9cqw currentColor;
  }
  .ps {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 4.5cqw;
    padding: 18cqw 9cqw 10cqw;
    text-align: center;
    opacity: 0;
    transform: translateY(4cqw) scale(0.98);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ps.is-on {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ps {
      transition: none;
    }
  }
</style>

---
// Night scene: painted backdrop plus flat cutouts on depth layers (2.5D).
// Puppets are held from below, like in a puppet show: their sticks run out of the frame.
import { Picture } from 'astro:assets';

import prospekt from '../../../design/source/stage/prospekt.png';
import wordmark from '../../../design/source/brand/wordmark.png';
import haeuser from '../../../design/source/props/haeuser.png';
import kirchturm from '../../../design/source/props/kirchturm.png';
import tanne1 from '../../../design/source/props/tanne_1.png';
import tanne2 from '../../../design/source/props/tanne_2.png';
import busch from '../../../design/source/props/busch.png';
import steine from '../../../design/source/props/steine.png';
import zaun from '../../../design/source/props/zaun.png';
import laterne from '../../../design/source/props/laterne.png';
import werwolf from '../../../design/source/figures/werwolf.png';
import seherin from '../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../design/source/figures/dorfbewohner.png';
import magd from '../../../design/source/figures/magd.png';

// x/bottom/width in % of the scene; depth drives parallax (0 = far, 1 = near).
const scenery = [
  { src: tanne1, x: 3, bottom: 25, w: 8, depth: 0.3 },
  { src: kirchturm, x: 21, bottom: 27, w: 6.5, depth: 0.25 },
  { src: haeuser, x: 29, bottom: 27, w: 24, depth: 0.25 },
  { src: tanne2, x: 86, bottom: 26, w: 7.5, depth: 0.3 },
  { src: steine, x: 8, bottom: 17, w: 11, depth: 0.55 },
  { src: zaun, x: 55.5, bottom: 17, w: 10, depth: 0.55 },
  { src: busch, x: 74, bottom: 17, w: 10, depth: 0.55 },
  { src: laterne, x: 90, bottom: 15, w: 5, depth: 0.6 },
];

const puppets = [
  { src: werwolf, alt: 'Der Werwolf, grinsend', x: 11, w: 16, delay: 0 },
  { src: seherin, alt: 'Die Seherin mit Laterne', x: 31, w: 12.5, delay: 0.15 },
  { src: dorfbewohner, alt: 'Ein Dorfbewohner mit Mistgabel', x: 50, w: 11.5, delay: 0.3 },
  { src: magd, alt: 'Eine Dorfbewohnerin mit Eimer', x: 66, w: 9.5, delay: 0.45 },
];

const widths = [240, 480, 800, 1200];
const formats = ['avif', 'webp'] as const;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="scene">
    <div class="layer backdrop" style="--depth: 0.08">
      <Picture
        src={prospekt}
        alt=""
        formats={formats}
        widths={[960, 1672]}
        sizes="(max-width: 700px) 180vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    {
      scenery.map((s) => (
        <div class="layer" style={`--depth: ${s.depth}`}>
          <Picture
            class="cutout"
            src={s.src}
            alt=""
            formats={formats}
            widths={widths}
            sizes={`${Math.ceil(s.w * 1.8)}vw`}
            loading="eager"
            style={`left: ${s.x}%; bottom: ${s.bottom}%; width: ${s.w}%`}
          />
        </div>
      ))
    }

    <div class="layer" style="--depth: 0.85">
      {
        puppets.map((p) => (
          <div class="puppet" style={`left: ${p.x}%; width: ${p.w}%; --delay: ${p.delay}s`}>
            <Picture src={p.src} alt={p.alt} formats={formats} widths={widths} sizes={`${Math.ceil(p.w * 1.8)}vw`} loading="eager" />
          </div>
        ))
      }
    </div>

    <div class="light" aria-hidden="true"></div>
    <div class="fade" aria-hidden="true"></div>
  </div>

  <div class="hero__title">
    <h1 id="hero-title">
      <Picture
        src={wordmark}
        alt="Whowolf"
        formats={formats}
        widths={[400, 800, 1336]}
        sizes="(max-width: 700px) 86vw, 44vw"
        loading="eager"
        fetchpriority="high"
      />
    </h1>
  </div>
</section>

<script>
  // Pointer + scroll parallax. Writes custom properties; CSS does the rest.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && !calm.matches) {
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const tick = () => {
      current.x += (target.x - current.x) * 0.08;
      current.y += (target.y - current.y) * 0.08;
      hero.style.setProperty('--px', current.x.toFixed(4));
      hero.style.setProperty('--py', current.y.toFixed(4));
      const settled = Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(tick);
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        target.x = event.clientX / window.innerWidth - 0.5;
        target.y = event.clientY / window.innerHeight - 0.5;
        if (!frame) frame = requestAnimationFrame(tick);
      },
      { passive: true },
    );

    const onScroll = () => {
      const progress = Math.min(window.scrollY / window.innerHeight, 1);
      hero.style.setProperty('--scroll', progress.toFixed(4));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  hero?.classList.add('is-lit');
</script>

<style>
  .hero {
    --px: 0;
    --py: 0;
    --scroll: 0;
    position: relative;
    overflow: hidden;
    background: var(--night-900);
  }

  .scene {
    position: relative;
    width: 100%;
    max-width: 128rem;
    margin-inline: auto;
    aspect-ratio: 1672 / 900;
    isolation: isolate;
    /* On very wide screens the painted backdrop melts into the page. */
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .layer {
    position: absolute;
    inset: 0;
    transform: translate3d(
      calc(var(--px) * var(--depth) * -2.2%),
      calc(var(--py) * var(--depth) * -1.4% + var(--scroll) * var(--depth) * 7%),
      0
    );
    will-change: transform;
  }

  .backdrop {
    inset: -4%;
  }
  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .scene :global(.cutout) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 0.4vw 0.6vw rgb(5 8 20 / 0.45));
  }

  /* Puppets rise from below the frame, then bob on their sticks. */
  .puppet {
    position: absolute;
    bottom: -10%;
    transform-origin: 50% 100%;
    transform: translateY(70%);
    opacity: 0;
    filter: drop-shadow(0 0.5vw 0.8vw rgb(5 8 20 / 0.5));
  }
  .puppet :global(img) {
    width: 100%;
    height: auto;
  }
  .is-lit .puppet {
    animation:
      rise 1.1s var(--ease-puppet) calc(0.5s + var(--delay)) forwards,
      bob 5.2s ease-in-out calc(1.7s + var(--delay) * 3) infinite;
  }
  @keyframes rise {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
    35% {
      transform: translateY(-1%) rotate(-1.2deg);
      opacity: 1;
    }
    70% {
      transform: translateY(0.3%) rotate(0.8deg);
      opacity: 1;
    }
  }

  /* One slow lantern spot over the ensemble plus a soft vignette. */
  .light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 20% 50% at var(--spot, 40%) 70%, rgb(255 214 150 / 0.18), transparent 70%),
      radial-gradient(ellipse at 50% 35%, transparent 50%, rgb(8 10 24 / 0.5) 100%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out) 0.2s;
  }
  .is-lit .light {
    opacity: 1;
    animation: spot 16s ease-in-out 2.5s infinite;
  }
  @property --spot {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 40%;
  }
  @keyframes spot {
    0%,
    100% {
      --spot: 40%;
    }
    33% {
      --spot: 20%;
    }
    66% {
      --spot: 66%;
    }
  }

  /* The sticks disappear into the night below. */
  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    background: linear-gradient(180deg, transparent, rgb(20 26 51 / 0.9) 60%, var(--night-900));
    pointer-events: none;
  }

  .hero__title {
    position: absolute;
    z-index: 2;
    top: clamp(4.5rem, 9vw, 9rem);
    left: 50%;
    width: min(36vw, 40rem);
    transform: translateX(-50%);
  }
  .hero__title h1 {
    margin: 0;
    filter: drop-shadow(0 0.8rem 1.4rem rgb(5 8 20 / 0.6));
    animation: title-in 1s var(--ease-out) both;
  }
  .hero__title :global(img) {
    width: 100%;
    height: auto;
  }
  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(-0.6rem) scale(0.97);
    }
  }

  @media (max-width: 700px) {
    .scene {
      width: 180%;
      margin-left: -40%;
      aspect-ratio: 1672 / 1180;
      mask-image: none;
    }
    .hero__title {
      top: 6.5rem;
      width: 78vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer {
      transform: none;
    }
    .puppet,
    .is-lit .puppet {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .is-lit .light,
    .hero__title h1 {
      animation: none;
    }
  }
</style>

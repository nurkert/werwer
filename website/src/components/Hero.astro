---
// Night scene: painted backdrop plus flat cutouts on depth layers (2.5D).
// Cardboard puppets rise from below and stand on the meadow, like in a puppet show.
// Depth only reacts to scrolling: far layers drift, near layers rush past.
import { Picture } from 'astro:assets';

import { path, repoUrl, ui, type Lang } from '../i18n/ui';
import prospekt from '../../../design/source/stage/prospekt.png';
import wordmark from '../../../design/source/brand/wordmark.png';
import haeuser from '../../../design/source/props/haeuser.png';
import kirchturm from '../../../design/source/props/kirchturm.png';
import tanne1 from '../../../design/source/props/tanne_1.png';
import tanne2 from '../../../design/source/props/tanne_2.png';
import busch from '../../../design/source/props/busch.png';
import steine from '../../../design/source/props/steine.png';
import zaun from '../../../design/source/props/zaun.png';
import laterne from '../../../design/source/props/laterne.png';
import werwolf from '../../../design/source/figures/werwolf.png';
import seherin from '../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../design/source/figures/dorfbewohner.png';
import magd from '../../../design/source/figures/magd.png';
import phonePuppet from '../../../design/source/brand/phone-puppet.png';
import seerFace from '../../../design/source/figures/seherin.png';
import hexe from '../../../design/source/figures/hexe.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const u = t.unbox;
const votePortraits = [dorfbewohner, magd, hexe, seerFace];

// x/bottom/width in % of the scene; depth: 0 = far (barely moves), 1 = near (moves most).
const scenery = [
  { src: tanne1, x: 3, bottom: 25, w: 8, depth: 0.35 },
  { src: kirchturm, x: 21, bottom: 27, w: 6.5, depth: 0.25 },
  { src: haeuser, x: 29, bottom: 27, w: 24, depth: 0.25 },
  { src: tanne2, x: 86, bottom: 26, w: 7.5, depth: 0.35 },
  { src: steine, x: 8, bottom: 17, w: 11, depth: 0.55 },
  { src: zaun, x: 55.5, bottom: 17, w: 10, depth: 0.55 },
  { src: busch, x: 74, bottom: 17, w: 10, depth: 0.55 },
  { src: laterne, x: 90, bottom: 15, w: 5, depth: 0.6 },
];

const puppets = [
  { src: werwolf, alt: lang === 'de' ? 'Der Werwolf, grinsend' : 'The werewolf, grinning', x: 11, w: 16, delay: 0 },
  { src: seherin, alt: lang === 'de' ? 'Die Seherin mit Laterne' : 'The seer with her lantern', x: 31, w: 12.5, delay: 0.15 },
  { src: dorfbewohner, alt: lang === 'de' ? 'Ein Dorfbewohner mit Mistgabel' : 'A villager with a pitchfork', x: 45, w: 11, delay: 0.3 },
  { src: magd, alt: lang === 'de' ? 'Eine Dorfbewohnerin mit Eimer' : 'A villager with a bucket', x: 79, w: 8.5, delay: 0.6 },
];

const widths = [240, 480, 800, 1200];
const formats = ['avif', 'webp'] as const;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="scene">
    <div class="layer backdrop" style="--depth: 0.08">
      <Picture
        src={prospekt}
        alt=""
        formats={formats}
        widths={[960, 1672]}
        sizes="(max-width: 700px) 180vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    {
      scenery.map((s) => (
        <div class="layer" style={`--depth: ${s.depth}`}>
          <Picture
            class="cutout"
            src={s.src}
            alt=""
            formats={formats}
            widths={widths}
            sizes={`${Math.ceil(s.w * 1.8)}vw`}
            loading="eager"
            style={`left: ${s.x}%; bottom: ${s.bottom}%; width: ${s.w}%`}
          />
        </div>
      ))
    }
    <div class="layer" style="--depth: 0.9">
      {
        puppets.map((p) => (
          <div class="puppet" style={`left: ${p.x}%; width: ${p.w}%; --delay: ${p.delay}s`}>
            <Picture src={p.src} alt={p.alt} formats={formats} widths={widths} sizes={`${Math.ceil(p.w * 1.8)}vw`} loading="eager" />
          </div>
        ))
      }
      <div class="puppet puppet--phone" style="left: 59%; width: 15.5%; --delay: 0.45s">
        <Picture src={phonePuppet} alt="" formats={formats} widths={[300, 600]} sizes="28vw" loading="eager" />
        <div class="pscreen" data-pscreen aria-hidden="true">
          <div class="ps ps--role">
            <p class="ps__kicker">{u.youAre}</p>
            <p class="ps__title">{u.role}</p>
            <Picture class="ps__portrait" src={seerFace} alt="" formats={formats} widths={[160, 320]} sizes="10vw" />
            <span class="ps__btn">{u.next}</span>
          </div>
          <div class="ps ps--night">
            <span class="ps__moon"></span>
            <p class="ps__title">{u.night}</p>
            <p class="ps__hint">{u.nightHint}</p>
          </div>
          <div class="ps ps--vote">
            <p class="ps__title">{u.vote}</p>
            <div class="ps__grid">
              {votePortraits.map((src) => <Picture src={src} alt="" formats={formats} widths={[80, 160]} sizes="4vw" />)}
            </div>
            <span class="ps__btn">{u.voteButton}</span>
          </div>
        </div>
      </div>
    </div>
    <div class="sky" aria-hidden="true">
      {Array.from({ length: 26 }, (_, i) => (
        <span class="star" style={`left:${(i * 37) % 100}%; top:${(i * 53) % 34}%; --d:${(i % 7) * 0.6}s; --s:${0.6 + (i % 3) * 0.35}`}></span>
      ))}
      <span class="cloud cloud--a"></span>
      <span class="cloud cloud--b"></span>
    </div>
    <div class="fireflies" aria-hidden="true">
      {Array.from({ length: 14 }, (_, i) => (
        <span style={`left:${8 + ((i * 41) % 84)}%; top:${52 + ((i * 29) % 36)}%; --d:${(i % 5) * 1.3}s; --t:${7 + (i % 4) * 2}s`}></span>
      ))}
    </div>
    <div class="light" aria-hidden="true"></div>
    <div class="fade" aria-hidden="true"></div>
  </div>

  <div class="hero__title">
    <h1 id="hero-title">
      <Picture
        src={wordmark}
        alt="Whowolf"
        formats={formats}
        widths={[400, 800, 1336]}
        sizes="(max-width: 700px) 78vw, 36vw"
        loading="eager"
        fetchpriority="high"
      />
    </h1>
  </div>

  <div class="hero__copy container">
    <p class="hero__statement">{t.hero.statement}</p>
    <p class="hero__sub">{t.hero.sub}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={repoUrl}>{t.hero.primary}</a>
      <a class="button button--ghost" href={`${path('home', lang)}#spiel`}>{t.hero.secondary}</a>
    </div>
    <p class="hero__status"><span class="stamp stamp--status">{t.status.badge}</span> {t.status.line}</p>
  </div>
</section>

<script>
  // Scroll-linked depth only: write the scroll progress once per frame, CSS moves the layers.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && !calm.matches) {
    let queued = false;
    const update = () => {
      queued = false;
      const progress = Math.min(Math.max(window.scrollY / hero.offsetHeight, 0), 1);
      hero.style.setProperty('--scroll', progress.toFixed(4));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
  hero?.classList.add('is-lit');

  // The puppet phone plays the app: role, night, vote, in a loop.
  const screen = hero?.querySelector<HTMLElement>('[data-pscreen]');
  if (screen) {
    const states = ['role', 'night', 'vote'];
    let index = 0;
    screen.dataset.state = states[0];
    if (!calm.matches) {
      window.setInterval(() => {
        index = (index + 1) % states.length;
        screen.dataset.state = states[index];
      }, 3200);
    }
  }
</script>

<style>
  .hero {
    --scroll: 0;
    position: relative;
    overflow: hidden;
    background: var(--night-900);
  }

  .scene {
    position: relative;
    width: 100%;
    max-width: 128rem;
    margin-inline: auto;
    aspect-ratio: 1672 / 900;
    isolation: isolate;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  /* Near layers travel further than far ones; the backdrop almost stands still. */
  .layer {
    position: absolute;
    inset: 0;
    transform: translate3d(0, calc(var(--scroll) * var(--depth) * -26%), 0);
    will-change: transform;
  }
  .backdrop {
    inset: -4% -4% -12%;
    transform: translate3d(0, calc(var(--scroll) * 10%), 0) scale(calc(1 + var(--scroll) * 0.06));
  }
  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .scene :global(.cutout) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 0.4vw 0.6vw rgb(5 8 20 / 0.45));
  }

  .puppet {
    position: absolute;
    bottom: 4%;
    transform-origin: 50% 100%;
    transform: translateY(70%);
    opacity: 0;
    filter: drop-shadow(0 0.5vw 0.8vw rgb(5 8 20 / 0.5));
  }
  .puppet :global(img) {
    width: 100%;
    height: auto;
  }
  .is-lit .puppet {
    animation:
      rise 1.1s var(--ease-puppet) calc(0.4s + var(--delay)) forwards,
      bob 5.2s ease-in-out calc(1.6s + var(--delay) * 3) infinite;
  }
  @keyframes rise {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
    35% {
      transform: translateY(-1%) rotate(-1.2deg);
      opacity: 1;
    }
    70% {
      transform: translateY(0.3%) rotate(0.8deg);
      opacity: 1;
    }
  }

  .light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 20% 50% at var(--spot, 40%) 70%, rgb(255 214 150 / 0.18), transparent 70%),
      radial-gradient(ellipse at 50% 35%, transparent 50%, rgb(8 10 24 / 0.5) 100%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out) 0.2s;
  }
  .is-lit .light {
    opacity: 1;
    animation: spot 16s ease-in-out 2.5s infinite;
  }
  @property --spot {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 40%;
  }
  @keyframes spot {
    0%,
    100% {
      --spot: 40%;
    }
    33% {
      --spot: 20%;
    }
    66% {
      --spot: 66%;
    }
  }

  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    background: linear-gradient(180deg, transparent, rgb(20 26 51 / 0.9) 60%, var(--night-900));
    pointer-events: none;
  }

  .hero__title {
    position: absolute;
    z-index: 2;
    top: clamp(4.75rem, 8vw, 8.5rem);
    left: 50%;
    width: min(36vw, 40rem);
    transform: translate3d(-50%, calc(var(--scroll) * 40%), 0);
  }
  .hero__title h1 {
    margin: 0;
    filter: drop-shadow(0 0.8rem 1.4rem rgb(5 8 20 / 0.6));
    animation: title-in 0.6s var(--ease-out) both;
  }
  .hero__title :global(img) {
    width: 100%;
    height: auto;
  }
  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(-0.6rem) scale(0.97);
    }
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin-top: -1.5rem;
    padding-bottom: var(--space-5);
    text-align: center;
  }
  .hero__statement {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--step-heading);
    line-height: 1.12;
    color: var(--moon-100);
  }
  .hero__sub {
    max-width: 38ch;
    font-size: var(--step-lead);
    color: var(--moon-200);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .hero__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.75rem;
    max-width: 40rem;
    margin-top: var(--space-2);
    font-size: var(--step-small);
    color: var(--moon-200);
  }


  /* ---------- Living night ---------- */
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .star {
    position: absolute;
    width: calc(0.28vw * var(--s));
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff3d1;
    box-shadow: 0 0 0.6vw rgb(255 243 209 / 0.8);
    animation: twinkle 3.6s ease-in-out var(--d) infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.25;
      transform: scale(0.6);
    }
  }
  .cloud {
    position: absolute;
    height: 4vw;
    border-radius: 999px;
    background: rgb(160 175 220 / 0.14);
    filter: blur(0.4vw);
    animation: drift 70s linear infinite;
  }
  .cloud::before,
  .cloud::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: inherit;
  }
  .cloud::before {
    width: 45%;
    height: 160%;
    left: 15%;
    bottom: 20%;
  }
  .cloud::after {
    width: 35%;
    height: 130%;
    left: 50%;
    bottom: 25%;
  }
  .cloud--a {
    top: 9%;
    width: 18vw;
    left: -20%;
  }
  .cloud--b {
    top: 20%;
    width: 13vw;
    left: -20%;
    animation-duration: 95s;
    animation-delay: -40s;
    opacity: 0.8;
  }
  @keyframes drift {
    to {
      transform: translateX(140vw);
    }
  }
  .fireflies {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fireflies span {
    position: absolute;
    width: 0.35vw;
    min-width: 3px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffd27a;
    box-shadow: 0 0 0.8vw 0.25vw rgb(255 196 90 / 0.55);
    opacity: 0;
    animation: firefly var(--t) ease-in-out var(--d) infinite;
  }
  @keyframes firefly {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    20% {
      opacity: 0.9;
    }
    50% {
      transform: translate(2.2vw, -3vw);
      opacity: 0.5;
    }
    80% {
      opacity: 0.85;
      transform: translate(-1.4vw, -1.2vw);
    }
  }

  /* ---------- The puppet phone ---------- */
  .puppet--phone {
    bottom: 3%;
  }
  .pscreen {
    position: absolute;
    left: 8.6%;
    top: 9.2%;
    width: 81.3%;
    height: 83.2%;
    overflow: hidden;
    border-radius: 0 0 9% 9% / 0 0 6.6% 6.6%;
    container-type: inline-size;
    color: #f6e8c6;
    font-family: 'Ancizar Serif', Georgia, serif;
  }
  .ps {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 5cqw;
    padding: 6% 8%;
    text-align: center;
    opacity: 0;
    transform: translateY(4cqw);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-state='role'] .ps--role,
  [data-state='night'] .ps--night,
  [data-state='vote'] .ps--vote {
    opacity: 1;
    transform: none;
  }
  .ps__kicker {
    margin: 0;
    font-size: 10cqw;
    opacity: 0.8;
  }
  .ps__title {
    margin: 0;
    font-size: 13cqw;
    font-weight: 700;
    line-height: 1.1;
    color: #f5aa42;
  }
  .ps--night .ps__title,
  .ps--vote .ps__title {
    color: #f6e8c6;
  }
  .ps--vote .ps__title {
    font-size: 11cqw;
  }
  .ps :global(picture) {
    display: block;
  }
  .ps :global(.ps__portrait) {
    width: 70%;
    height: auto;
  }
  .ps__hint {
    margin: 0;
    font-size: 8cqw;
    opacity: 0.85;
  }
  .ps__btn {
    padding: 3.5cqw 10cqw;
    border-radius: 999px;
    background: #f5aa42;
    color: #2a1b12;
    font-size: 8.5cqw;
    font-weight: 700;
  }
  .ps__moon {
    width: 40cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 9cqw -5cqw 0 0 #f6e8c6;
    transform: rotate(-20deg);
  }
  .ps__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5cqw;
    width: 84%;
  }
  .ps__grid :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 10%;
    border-radius: 50%;
    background: #232c52;
    box-shadow: 0 0 0 1.4cqw #c9973f;
  }

  @media (max-width: 700px) {
    .scene {
      width: 180%;
      margin-left: -40%;
      aspect-ratio: 1672 / 1180;
      mask-image: none;
    }
    .hero__title {
      top: 5.5rem;
      width: 78vw;
    }
    .hero__copy {
      margin-top: 0;
      padding-top: var(--space-2);
    }
    .hero__actions {
      flex-direction: column;
      align-self: stretch;
      width: 100%;
    }
    .hero__actions .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .backdrop {
      transform: none;
    }
    .hero__title {
      transform: translateX(-50%);
    }
    .puppet,
    .is-lit .puppet {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .is-lit .light,
    .hero__title h1,
    .star,
    .cloud,
    .fireflies span {
      animation: none;
    }
  }
</style>

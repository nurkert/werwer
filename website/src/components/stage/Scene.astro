---
// One section as a stage set by moonlight (task 012, as in the app): the
// painted set, its moon, cardboard scenery at the sides and from the top,
// and the content in front. The first scene loads at once, the others only
// when they come near.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import lightData from '../../data/lights.json';

export interface ScenePiece {
  src: ImageMetadata;
  /** Where it stands. */
  at: 'left' | 'right' | 'top-left' | 'top-right' | 'top' | 'hang-left' | 'hang-right';
  /** Height in hundredths of the screen's height (top pieces: a CSS length). */
  h: string;
  /** How much of it hides beyond the edge (desktop / phone). */
  hide?: string;
  hidePhone?: string;
  /** Pushed further in from the edge (CSS length). */
  inset?: string;
  mirror?: boolean;
  /** Only on wide windows. */
  wide?: boolean;
  /** In front of the other pieces on its side. */
  front?: boolean;
  /** Top pieces: how many lengths side by side, so it spans the width. */
  repeat?: number;
  /** Top pieces: hung over each seam between two lengths (a knot, a tassel). */
  joint?: { src: ImageMetadata; h: string; y?: string };
}

interface Props {
  id?: string;
  set: ImageMetadata;
  pieces?: ScenePiece[];
  moon?: { kind: 'full' | 'crescent' | 'blood' | 'sun'; x: string; y: string; size?: string };
  first?: boolean;
  /** A colour laid over a borrowed set. */
  tint?: string;
  labelledby?: string;
  class?: string;
}

const { id, set, pieces = [], moon, first = false, tint, labelledby, class: extra } = Astro.props;
// The set's and the pieces' names (`village`, `lamppost`), for their lights.
const nameOf = (img: ImageMetadata) => img.src.split('/').pop()!.split('.')[0];
const life = nameOf(set);
type PieceLight = [number, number, number, number];
const lightsOf = (img: ImageMetadata): PieceLight[] =>
  ((lightData as Record<string, { lights: PieceLight[] }>)[`scenery/${nameOf(img)}`]?.lights ?? []);
const formats = ['avif', 'webp'] as const;
const loading = first ? 'eager' : 'lazy';
---

<section
  id={id}
  class:list={['scene', { 'scene--first': first }, extra]}
  aria-labelledby={labelledby}
  data-life={life}
>
  <Picture
    class="scene__set"
    src={set}
    alt=""
    formats={formats}
    widths={[640, 960, 1254]}
    sizes="100vw"
    quality={58}
    loading={loading}
    fetchpriority={first ? 'high' : 'auto'}
    decoding="async"
  />
  {
    moon && (
      <div
        class:list={['scene__moon', `scene__moon--${moon.kind}`]}
        aria-hidden="true"
        style={`--moon-x: ${moon.x}; --moon-y: ${moon.y};${moon.size ? ` --moon-size: ${moon.size};` : ''}`}
      />
    )
  }
  {
    pieces.map((piece) => (
      <div
        class:list={['piece', `piece--${piece.at}`, { 'piece--mirror': piece.mirror, 'piece--wide': piece.wide }]}
        aria-hidden="true"
        style={[
          `--h: ${piece.h}`,
          piece.hide && `--hide: ${piece.hide}`,
          piece.hidePhone && `--hide-phone: ${piece.hidePhone}`,
          piece.inset && (piece.at.includes('left') ? `margin-left: ${piece.inset}` : `margin-right: ${piece.inset}`),
          piece.at === 'top' && `--top-h: ${piece.h}`,
          piece.front && 'z-index: 2',
        ]
          .filter(Boolean)
          .join('; ')}
      >
        {Array.from({ length: piece.at === 'top' ? (piece.repeat ?? 1) : 1 }, (_, n) => [
          n > 0 && piece.joint && (
            <span class="piece__joint" style={`--joint-h: ${piece.joint.h}; --joint-y: ${piece.joint.y ?? '0px'}`}>
              <Picture
                src={piece.joint.src}
                alt=""
                formats={formats}
                widths={[160, 320, 480]}
                sizes="12vw"
                quality={62}
                loading={loading}
                decoding="async"
              />
            </span>
          ),
          <span class="piece__frame">
            <Picture
              src={piece.src}
              alt=""
              formats={formats}
              widths={piece.at === 'top' ? [700, 1400] : piece.at.startsWith('hang') ? [400, 640, 933] : [240, 400, 640]}
              sizes={piece.at === 'top' ? 'min(60vw, 900px)' : piece.at.startsWith('hang') ? '67svh' : 'min(28vw, 360px)'}
              quality={62}
              loading={loading}
              decoding="async"
            />
            {lightsOf(piece.src).map(([x, y, r], i) => (
              <span
                class="piece__light"
                style={`left: ${(piece.mirror ? 1 - x : x) * 100}%; top: ${y * 100}%; --r: ${r}; --i: ${i}`}
              />
            ))}
          </span>,
        ])}
      </div>
    ))
  }
  {tint && <div class="scene__tint" aria-hidden="true" style={`background: ${tint}`} />}
  <div class="scene__content">
    <slot />
  </div>
</section>

<script>
  import '../../scripts/stage-life';
</script>

<style>
  .scene__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
</style>

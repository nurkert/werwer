---
// "The cast": the six roles, each shown by people from the village who turn round into the
// role's costume, then the twenty personas, each of which turns through its costumes on a
// tap. This is the game's core idea made visible: your figure says nothing about your role;
// only when you look does it turn round, dressed as your role.
//
// A figure is two faces on one card (front and back) plus the corrugated board between them.
// The board layers only exist while the card turns (`.is-3d`, see scripts/site.ts); facing
// front or back it is a flat picture. The next picture is put on the hidden face while the
// visible one faces the audience, so every turn reveals someone new.
import { getImage } from 'astro:assets';

import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import { costumeRoles, personaFiles, personaFigure, roleCast, roles, type PersonaFile, type Role } from '../lib/personas';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].cast;
const nameOf = Object.fromEntries(t.ensemble.figures.map((f) => [f.id, f.name])) as Record<PersonaFile, string>;

type Pic = { src: string; srcset: string };
const picture = async (file: PersonaFile, role: Role, widths: number[]): Promise<Pic> => {
  const image = await getImage({ src: personaFigure(file, role), format: 'webp', widths });
  return { src: image.src, srcset: image.srcSet.attribute };
};
const cardWidths = [200, 400, 600];
const smallWidths = [120, 240, 360];

// The board between the faces, front to back (see CardboardFigure for the full version).
const layers = [
  { kind: 'liner', z: 4 },
  ...[3, 1.5, 0, -1.5, -3].map((z, i) => ({ kind: 'flute', z, phase: i / 5 })),
  { kind: 'core', z: 0.5 },
  { kind: 'liner', z: -4 },
];

// Role cards: everyday, costume, next person everyday, costume … The villager has no
// costume, so its card just turns from one villager to the next.
const cards = await Promise.all(
  roles.map(async (role) => {
    const people = roleCast[role];
    const steps = role === 'villager' ? people.map((file) => ({ file, role })) : people.flatMap((file) => [{ file, role: 'villager' as Role }, { file, role }]);
    const seq = await Promise.all(steps.map((step) => picture(step.file, step.role, cardWidths)));
    const names = steps.map((step) => (step.role === 'villager' ? nameOf[step.file] : `${nameOf[step.file]} · ${t.roles[role].name}`));
    return { role, seq, names, side: role === 'werewolf' ? 'wolf' : 'dorf' };
  }),
);

// The ensemble: every persona, everyday first, then each of its costumes.
const ensemble = await Promise.all(
  personaFiles.map(async (file) => {
    const steps: Role[] = ['villager', ...costumeRoles];
    const seq = await Promise.all(steps.map((role) => picture(file, role, smallWidths)));
    const names = steps.map((role) => (role === 'villager' ? '' : t.roles[role].name));
    return { file, name: nameOf[file], seq, names };
  }),
);
---

<section id="rollen" class="night cast" aria-labelledby="cast-title">
  <div class="container">
    <div class="section-head">
      <h2 id="cast-title" class="display" data-reveal>{t.title}</h2>
      <p class="lead" data-reveal style="--i: 1">{t.intro}</p>
      <p class="cast__hint" data-reveal style="--i: 2">
        <span>{t.hint}</span><span class="cast__swipe" aria-hidden="true">{t.swipe} →</span>
      </p>
    </div>
  </div>

  <ul class="roles">
    {
      cards.map((card, i) => (
        <li class="rc" data-reveal style={`--i: ${i % 3}`}>
          <button
            class="rc__stage"
            type="button"
            aria-label={`${t.turn}: ${t.roles[card.role].name}`}
            data-turner
            data-auto
            data-seq={JSON.stringify(card.seq)}
            data-names={JSON.stringify(card.names)}
          >
            <span class="turn" data-turn>
              <img class="face face--front" src={card.seq[0].src} srcset={card.seq[0].srcset} sizes="11rem" alt="" loading="lazy" decoding="async" />
              {layers.map((layer) => (
                <img
                  class={`face cardboard__layer cardboard__${layer.kind}`}
                  style={`--z: ${layer.z}px; --phase: ${'phase' in layer ? layer.phase : 0}`}
                  src={card.seq[0].src}
                  srcset={card.seq[0].srcset}
                  sizes="11rem"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              ))}
              <img class="face face--back" src={card.seq[1].src} srcset={card.seq[1].srcset} sizes="11rem" alt="" loading="lazy" decoding="async" />
            </span>
          </button>
          <div class="rc__card">
            <p class="rc__who" data-who>{card.names[0]}</p>
            <div class="rc__plate">
              <h3>{t.roles[card.role].name}</h3>
              <span class:list={['stamp', card.side === 'wolf' ? 'stamp--wolf' : 'stamp--dorf']}>{card.side === 'wolf' ? t.wolves : t.village}</span>
            </div>
            <p>{t.roles[card.role].text}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="container">
    <aside class="signs" data-reveal aria-labelledby="signs-title">
      <div class="signs__plate" role="img" aria-label={t.doorSigns.example}>
        <span><Icon name="moon" /></span>
        <span><Icon name="key" /></span>
        <span><Icon name="star" /></span>
      </div>
      <div>
        <p class="signs__level">{t.doorSigns.level}</p>
        <h3 id="signs-title" class="heading">{t.doorSigns.title}</h3>
        <p>{t.doorSigns.text}</p>
      </div>
    </aside>

    <div class="ensemble">
      <h3 class="heading" data-reveal>{t.ensemble.title}</h3>
      <p class="lead" data-reveal style="--i: 1">{t.ensemble.text}</p>
      <p class="cast__hint" data-reveal style="--i: 2">{t.ensemble.hint}</p>
      <ul class="ensemble__grid">
        {
          ensemble.map((person) => (
            <li>
              <button
                class="en__stage"
                type="button"
                aria-label={`${person.name}: ${t.turn}`}
                data-turner
                data-seq={JSON.stringify(person.seq)}
                data-names={JSON.stringify(person.names)}
              >
                <span class="turn" data-turn>
                  <img class="face face--front" src={person.seq[0].src} srcset={person.seq[0].srcset} sizes="5.5rem" alt="" loading="lazy" decoding="async" />
                  <img class="face face--back" src={person.seq[1].src} srcset={person.seq[1].srcset} sizes="5.5rem" alt="" loading="lazy" decoding="async" />
                </span>
              </button>
              <span class="en__name">{person.name}</span>
              <span class="en__role" data-who aria-live="polite"></span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Turning figures. Each turn adds 180 degrees; once it lands, the face now hidden gets
  // the next picture. Cards marked data-auto turn by themselves now and then, but only
  // while on screen and never with reduced motion; a tap turns any figure at once.
  type Pic = { src: string; srcset: string };
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const put = (image: HTMLImageElement, pic: Pic) => {
    image.srcset = pic.srcset;
    image.src = pic.src;
  };

  const auto = new Set<HTMLElement>();
  for (const button of document.querySelectorAll<HTMLElement>('[data-turner]')) {
    const seq = JSON.parse(button.dataset.seq ?? '[]') as Pic[];
    const names = JSON.parse(button.dataset.names ?? '[]') as string[];
    const flip = button.querySelector<HTMLElement>('.turn');
    const front = button.querySelector<HTMLImageElement>('.face--front');
    const back = button.querySelector<HTMLImageElement>('.face--back');
    const board = [...button.querySelectorAll<HTMLImageElement>('.cardboard__layer')];
    const who = button.closest('li')?.querySelector<HTMLElement>('[data-who]');
    if (!flip || !front || !back || seq.length < 2) continue;

    let step = 0;
    let busy = false;
    let timer = 0;
    // once it lands, the face that now looks away gets the next picture
    const land = () => {
      busy = false;
      put(step % 2 === 0 ? back : front, seq[(step + 1) % seq.length]);
    };
    const turn = () => {
      if (busy) return;
      busy = true;
      step += 1;
      flip.style.transform = `rotateY(${step * 180}deg)`;
      // the board takes the outline of the face coming round, from the moment it is edge-on
      const coming = seq[step % seq.length];
      window.setTimeout(() => board.forEach((image) => put(image, coming)), calm ? 0 : 430);
      if (who) who.textContent = names[step % seq.length] ?? '';
      if (calm) land();
      else {
        const done = (event: TransitionEvent) => {
          if (event.target !== flip || event.propertyName !== 'transform') return;
          flip.removeEventListener('transitionend', done);
          land();
        };
        flip.addEventListener('transitionend', done);
      }
    };
    const schedule = (first = false) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(
        () => {
          turn();
          schedule();
        },
        (first ? 1200 : 4200) + Math.random() * 3200,
      );
    };
    button.addEventListener('click', () => {
      turn();
      if (auto.has(button)) schedule();
    });
    if (!calm && button.hasAttribute('data-auto')) {
      auto.add(button);
      button.addEventListener('cast:show', () => schedule(true));
      button.addEventListener('cast:hide', () => window.clearTimeout(timer));
    }
  }

  if (auto.size && 'IntersectionObserver' in window) {
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.target.dispatchEvent(new Event(entry.isIntersecting ? 'cast:show' : 'cast:hide'));
      },
      { threshold: 0.6 },
    );
    auto.forEach((button) => watcher.observe(button));
  }
</script>

<style>
  .cast__hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: var(--step-small);
    font-weight: 700;
    color: var(--lantern-300);
  }
  .cast__swipe {
    display: none;
    font-weight: 600;
    color: var(--moon-200);
  }

  /* ---------- Role cards: three across on wide screens ---------- */
  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5) var(--space-3);
    width: min(100% - 2 * var(--gutter), var(--content));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .rc {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  /* The figure stands above its card and steps out of it. */
  .rc__stage {
    position: relative;
    z-index: 1;
    display: block;
    height: 17rem;
    margin: 0 0 -1rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    perspective: 60rem;
    -webkit-tap-highlight-color: transparent;
  }
  .rc__stage::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    width: 15rem;
    max-width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(246 231 193 / 0.18), rgb(246 231 193 / 0.04) 62%, transparent 63%);
    transform: translateX(-50%);
  }
  .rc__stage:focus-visible {
    outline-offset: -0.5rem;
    border-radius: var(--radius-l);
  }
  .turn {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 0.62;
    margin-inline: auto;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .face--front,
  .face--back {
    backface-visibility: hidden;
    filter: drop-shadow(0 12px 14px rgb(0 0 0 / 0.5));
  }
  .face--front {
    transform: translateZ(4.6px);
  }
  .face--back {
    transform: rotateY(180deg) translateZ(4.6px);
  }
  .rc__stage:hover .turn {
    translate: 0 -0.25rem;
  }

  .rc__card {
    padding: 1.6rem var(--space-3) var(--space-3);
    border-radius: var(--radius-l);
    color: var(--ink);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
  }
  .rc__who {
    min-height: 1.4em;
    margin-bottom: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--curtain-600);
  }
  .rc__plate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
  }
  .rc__plate h3 {
    font-size: 1.7rem;
    color: var(--ink);
  }
  .rc__card > p:last-child {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }

  /* ---------- Door signs ---------- */
  .signs {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3) var(--space-4);
    max-width: 58rem;
    margin: var(--space-6) auto 0;
    padding: var(--space-4);
    border-radius: var(--radius-l);
    background: var(--night-800);
    box-shadow: inset 0 0 0 0.2rem rgb(201 151 63 / 0.35);
  }
  .signs__plate {
    display: flex;
    gap: 0.6rem;
  }
  .signs__plate span {
    display: grid;
    place-items: center;
    width: 4rem;
    aspect-ratio: 1;
    border: 2px solid var(--lantern-400);
    border-radius: 0.9rem;
    background: var(--night-700, #1c2446);
    color: var(--moon-100);
  }
  .signs__plate :global(svg) {
    width: 2.2rem;
    height: 2.2rem;
  }
  .signs__level {
    font-size: var(--step-small);
    font-weight: 800;
    color: var(--lantern-300);
  }
  .signs h3 {
    margin: 0.2rem 0 0.5rem;
  }
  .signs p:last-child {
    max-width: 60ch;
    color: var(--moon-200);
  }

  /* ---------- The ensemble: women above, men below on wide screens ---------- */
  .ensemble {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .ensemble .lead {
    max-width: 58ch;
  }
  .ensemble .cast__hint {
    justify-content: flex-start;
  }
  .ensemble__grid {
    display: grid;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-3) var(--space-1);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .ensemble__grid li {
    display: grid;
    justify-items: center;
    align-content: end;
    gap: 0.2rem;
    text-align: center;
  }
  .en__stage {
    display: block;
    width: 100%;
    height: 8.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    perspective: 40rem;
    -webkit-tap-highlight-color: transparent;
  }
  .en__stage:focus-visible {
    border-radius: var(--radius-s);
  }
  .en__stage .face--front,
  .en__stage .face--back {
    filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.45));
  }
  .en__stage:hover .turn {
    translate: 0 -0.2rem;
  }
  .en__name {
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--moon-200);
    hyphens: auto;
  }
  .en__role {
    min-height: 1.2em;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--lantern-300);
  }

  /* ---------- Tablets: two cards across, five figures a row ---------- */
  @media (max-width: 1080px) {
    .roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ensemble__grid {
      grid-template-rows: none;
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* ---------- Phones: a swipeable row of big cards, four figures a row ---------- */
  @media (max-width: 760px) {
    .cast__swipe {
      display: inline;
    }
    .roles {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(78%, 20rem);
      gap: var(--space-2);
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding: 0 var(--gutter) var(--space-2);
      scrollbar-width: none;
    }
    .roles::-webkit-scrollbar {
      display: none;
    }
    .rc {
      scroll-snap-align: start;
    }
    .rc__stage {
      height: 15rem;
    }
    .rc__card {
      padding: 1.5rem 1.1rem 1.2rem;
    }
    .rc__plate h3 {
      font-size: 1.45rem;
    }
    .signs {
      grid-template-columns: 1fr;
      padding: var(--space-3) var(--space-2);
      margin-top: var(--space-5);
    }
    .signs__plate span {
      width: 3.4rem;
    }
    .signs__plate :global(svg) {
      width: 1.9rem;
      height: 1.9rem;
    }
    .ensemble {
      margin-top: var(--space-5);
    }
    .ensemble__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-2) 0.25rem;
    }
    .en__stage {
      height: 7rem;
    }
    .en__name {
      font-size: 0.8rem;
    }
  }
  /* narrow phones: three a row, so long names like "Blumenmädchen" fit on one line */
  @media (max-width: 480px) {
    .ensemble__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-3);
    }
    .en__stage {
      height: 8rem;
    }
    .en__name {
      hyphens: manual;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turn {
      transition: none;
    }
    .rc__stage:hover .turn,
    .en__stage:hover .turn {
      translate: none;
    }
  }
</style>

---
// Download page in the game-box world: the release is a programme booklet, each platform
// a punch-out component card with its file, requirements and install steps.
import { Picture } from 'astro:assets';

import Icon from '../Icon.astro';
import Base from '../../layouts/Base.astro';
import { languages, repoUrl, ui, type Lang } from '../../i18n/ui';
import { platformIcons, type PlatformIcon } from '../../lib/platform-icons';
import { loadReleases, type Platform } from '../../lib/releases';
import seherin from '../../../../app/assets/figures/seherin.webp';
import werwolf from '../../../../app/assets/figures/werwolf.webp';
import deRole from '../../assets/screens/de-role.webp';
import enRole from '../../assets/screens/en-role.webp';
import deFigure from '../../assets/screens/de-figure.webp';
import enFigure from '../../assets/screens/en-figure.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const d = t.download;
const x = t.dl;

const releases = await loadReleases();
const newest = releases[0];
const stable = releases.find((release) => !release.prerelease);
const shown = stable ?? newest;

// iPhone and Mac first: that is where Whowolf is developed and tested.
const platforms: { id: Platform; name: string; icon: PlatformIcon }[] = [
  { id: 'ios', name: 'iPhone & iPad', icon: 'apple' },
  { id: 'macos', name: 'macOS', icon: 'apple' },
  { id: 'android', name: 'Android', icon: 'android' },
  { id: 'windows', name: 'Windows', icon: 'window' },
  { id: 'linux', name: 'Linux', icon: 'linux' },
];
// Download figures as GitHub counts them, summed over every release.
const total = releases.reduce((sum, release) => sum + release.totalDownloads, 0);
const byPlatform = platforms
  .map((p) => ({ ...p, count: releases.flatMap((r) => r.downloads).filter((f) => f.platform === p.id).reduce((sum, f) => sum + f.count, 0) }))
  .filter((p) => p.count > 0);
const number = (value: number) => value.toLocaleString(languages[lang].locale);
const date = (value: Date) => value.toLocaleDateString(languages[lang].locale, { day: 'numeric', month: 'long', year: 'numeric' });
const formats = ['avif', 'webp'] as const;
const altstoreSource = new URL('/altstore.json', Astro.site).toString();
const neutralSource = new URL('/ios-source.json', Astro.site).toString();
---

<Base lang={lang} page="download" title={`${d.title} – Whowolf`} description={d.metaDescription} backdrop="village">
  <main class="dl">
    <header class="dl-head container">
      <div class="dl-head__copy">
        <h1>{d.title}</h1>
        <p class="dl-head__lede">{x.lede}</p>
        {
          shown ? (
            // The release as a ticket: the version big, and below the
            // seam how often it has been fetched so far.
            <div class="release plaque">
              <div class="release__main">
                <span class="stamp stamp--status">{shown.prerelease ? d.prerelease : d.current}</span>
                <p class="release__version">{shown.version.replace(/^v/, '')}</p>
                <p class="release__meta">
                  {date(shown.publishedAt)} · <a href={shown.url}>{d.whatsNew}</a>
                </p>
              </div>
              {total > 0 && (
                <div class="release__stats">
                  <h2 class="visually-hidden">{x.stats.title}</h2>
                  <p class="release__total">
                    <strong>{number(total)}</strong> {x.stats.total}
                    <span> · {number(releases.length)} {x.stats.releases}</span>
                  </p>
                  {byPlatform.length > 0 && (
                    <ul class="release__platforms">
                      {byPlatform.map((p) => (
                        <li>
                          <strong>{number(p.count)}</strong> {p.name}
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="release__note">{x.stats.note}</p>
                </div>
              )}
            </div>
          ) : (
            <p class="dl-head__version">
              <span class="stamp stamp--wolf">{t.status.badge}</span> {d.none}
            </p>
          )
        }
      </div>
      <div class="dl-head__art" aria-hidden="true">
        <div class="dl-phone dl-phone--back"><Picture src={lang === 'de' ? deFigure : enFigure} alt="" formats={formats} widths={[200, 400]} sizes="11rem" /></div>
        <div class="dl-phone dl-phone--front"><Picture src={lang === 'de' ? deRole : enRole} alt="" formats={formats} widths={[240, 480]} sizes="13rem" /></div>
        <span class="puppet dl-head__seer"><Picture src={seherin} alt="" formats={formats} widths={[160, 320]} sizes="9rem" /></span>
        <span class="puppet dl-head__wolf" style="--delay: -3s"><Picture src={werwolf} alt="" formats={formats} widths={[180, 360]} sizes="10rem" /></span>
      </div>
    </header>

    {shown?.prerelease && <p class="dl-note container">{x.prereleaseNote}</p>}

    <section class="container" aria-label={d.title}>
      <ul class="cards" data-cards>
        {
          platforms.map((platform, i) => {
            const files = shown?.downloads.filter((file) => file.platform === platform.id) ?? [];
            const info = x.platforms[platform.id];
            const ready = files.length > 0;
            return (
              <li
                class:list={['card', `card--${platform.id}`, { 'card--ready': ready }]}
                data-reveal
                data-platform={platform.id}
                style={`--i: ${i}`}
              >
                <div class="card__head">
                  <p class="card__badge">{x.recommended}</p>
                  <div class="card__top">
                    <span class="card__token">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={platformIcons[platform.icon]} /></svg>
                    </span>
                    <h2>{platform.name}</h2>
                  </div>
                  <p class="card__req">
                    <span>{x.requirements}:</span> {info.req}
                  </p>
                </div>
                {'ways' in info ? (
                  // The iPhone: one tab per store, each with its own way in.
                  // Without script both stand one below the other.
                  <div class="ways" data-ways>
                    <div class="ways__tabs" role="tablist" aria-label={info.tabsLabel} hidden>
                      {Object.entries(info.ways).map(([id, way], n) => (
                        <button
                          type="button"
                          role="tab"
                          id={`way-tab-${id}`}
                          aria-controls={`way-${id}`}
                          aria-selected={n === 0 ? 'true' : 'false'}
                          tabindex={n === 0 ? 0 : -1}
                        >
                          {way.tab}
                        </button>
                      ))}
                    </div>
                    {Object.entries(info.ways).map(([id, way]) => {
                      const sourceUrl = id === 'altstore' ? altstoreSource : neutralSource;
                      return (
                        <section class="way" id={`way-${id}`} role="tabpanel" aria-labelledby={`way-tab-${id}`}>
                          <h3 class="way__name">{way.tab}</h3>
                          <p class="way__lede">{way.lede}</p>
                          {ready ? (
                            <>
                              <a class="card__download" href={`${id}://source?url=${encodeURIComponent(sourceUrl)}`}>
                                <Icon name="download" />
                                <span>
                                  <strong>{way.add}</strong>
                                  <small>
                                    {files[0].name} · {files[0].sizeMb} MB
                                  </small>
                                </span>
                              </a>
                              <div class="card__code">
                                <p class="card__note">{way.addNote}</p>
                                <div class="card__copy">
                                  <code>{sourceUrl}</code>
                                  <button type="button" data-copy={sourceUrl} data-done={info.copied} hidden>
                                    {info.copy}
                                  </button>
                                </div>
                              </div>
                            </>
                          ) : (
                            <span class="card__soon">{shown ? d.notInRelease : d.soon}</span>
                          )}
                          <details class="card__more" data-more>
                            <summary>{x.install}</summary>
                            <ol class="card__steps">
                              {way.steps.map((step) => (
                                // Our own texts, with links to the stores' guides.
                                <li set:html={step} />
                              ))}
                            </ol>
                          </details>
                        </section>
                      );
                    })}
                    <p class="card__note ways__browser">{info.browser}</p>
                  </div>
                ) : (
                  <>
                    <div class="card__files">
                      {ready ? (
                        files.map((file) => (
                          <a class="card__download" href={file.url}>
                            <Icon name="download" />
                            <span>
                              <strong>{files.length > 1 ? x.formats[file.format] : x.getIt}</strong>
                              <small>
                                {file.name} · {file.sizeMb} MB
                              </small>
                            </span>
                          </a>
                        ))
                      ) : (
                        <span class="card__soon">{shown ? d.notInRelease : d.soon}</span>
                      )}
                    </div>
                    <details class="card__more" data-more>
                      <summary>{x.install}</summary>
                      <ol class="card__steps">
                        {info.steps.map((step) => (
                          <li>{step}</li>
                        ))}
                      </ol>
                      {'apt' in info && (
                        <div class="card__code">
                          <p class="card__note card__note--strong">{info.apt.title}</p>
                          <code>{info.apt.cmd}</code>
                          <p class="card__note">{info.apt.note}</p>
                        </div>
                      )}
                    </details>
                  </>
                )}
              </li>
            );
          })
        }
        <li class="cards__others" aria-hidden="true">{x.others}</li>
      </ul>
    </section>

    <section class="booklet container" aria-labelledby="verify-title" data-reveal>
      <div class="booklet__page">
        <div class="booklet__intro">
          <Icon name="shield" />
          <h2 id="verify-title">{x.verifyTitle}</h2>
          <p>{d.check1}</p>
          <p>{x.verifyText}</p>
          {shown?.checksumsUrl && <a class="button button--ghost" href={shown.checksumsUrl}>SHA256SUMS.txt</a>}
        </div>
        <dl class="booklet__cmds">
          <div>
            <dt>macOS</dt>
            <dd><code>{x.verifyCmd.mac}</code></dd>
          </div>
          <div>
            <dt>Linux</dt>
            <dd><code>{x.verifyCmd.linux}</code></dd>
          </div>
          <div>
            <dt>Windows</dt>
            <dd><code>{x.verifyCmd.win}</code></dd>
          </div>
        </dl>
        <p class="booklet__foot">{d.check2}</p>
      </div>
    </section>

    {
      releases.length > 0 && (
        <section class="history container" aria-labelledby="history-title">
          <h2 id="history-title">{d.older}</h2>
          <ol>
            {releases.map((release) => (
              <li>
                <a href={release.url}>{release.name}</a>
                <span>
                  {date(release.publishedAt)}
                  {release.prerelease ? ` · ${d.prerelease}` : ''}
                </span>
              </li>
            ))}
          </ol>
          <p class="history__more">
            <a class="button button--primary" href={repoUrl}>{t.hero.primary}</a>
            <a class="button button--ghost" href={`${repoUrl}/releases`}>{x.allReleases}</a>
          </p>
        </section>
      )
    }
  </main>
</Base>


<script>
  // Put the visitor's own system first. Only the platform name is read, nothing is stored or sent.
  const cards = document.querySelector<HTMLElement>('[data-cards]');
  if (cards) {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const ua = `${nav.userAgentData?.platform ?? ''} ${navigator.userAgent}`.toLowerCase();
    const touchMac = /mac/.test(ua) && navigator.maxTouchPoints > 1; // iPadOS asks for desktop pages
    const os = /iphone|ipad|ipod/.test(ua) || touchMac
      ? 'ios'
      : /android/.test(ua)
        ? 'android'
        : /win/.test(ua)
          ? 'windows'
          : /mac/.test(ua)
            ? 'macos'
            : /linux|x11/.test(ua) && !/cros/.test(ua)
              ? 'linux'
              : null;
    const card = os ? cards.querySelector<HTMLElement>(`[data-platform="${os}"]`) : null;
    if (card) {
      card.classList.add('is-yours');
      cards.dataset.os = os!;
      // On your own card the steps stand open.
      card.querySelectorAll<HTMLDetailsElement>('[data-more]').forEach((more) => (more.open = true));
    }
  }

  // The iPhone's ways in as tabs (without script both stay visible).
  const ways = document.querySelector<HTMLElement>('[data-ways]');
  const tablist = ways?.querySelector<HTMLElement>('[role="tablist"]');
  if (ways && tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const other of tabs) {
        const on = other === tab;
        other.setAttribute('aria-selected', String(on));
        other.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(other.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      try {
        localStorage.setItem('whowolf-ios-way', tab.id);
      } catch {
        // Private mode: the choice is just not remembered.
      }
    };
    let remembered: string | null = null;
    try {
      remembered = localStorage.getItem('whowolf-ios-way');
    } catch {
      remembered = null;
    }
    tablist.hidden = false;
    ways.classList.add('is-tabbed');
    select(tabs.find((tab) => tab.id === remembered) ?? tabs[0]);
    tablist.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });
    tablist.addEventListener('keydown', (event) => {
      const at = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (at < 0) return;
      const next = {
        ArrowRight: (at + 1) % tabs.length,
        ArrowLeft: (at - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      select(tabs[next], true);
    });
  }

  // Copy buttons next to the source addresses, where the clipboard works.
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      const label = button.textContent ?? '';
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          button.textContent = button.dataset.done ?? label;
          setTimeout(() => (button.textContent = label), 2000);
        } catch {
          // The address stays selectable by hand.
        }
      });
    });
  }
</script>

<style>
  /* ---- The release ticket: version big, the figures below the seam ---- */
  .release {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    align-items: center;
    margin-top: var(--space-4);
    padding: 1.1rem 1.4rem;
    max-width: 40rem;
  }
  .release__main {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
  }
  .release__version {
    margin: 0.2rem 0 0;
    font-family: 'Ancizar Serif', Georgia, serif;
    font-weight: 700;
    font-size: clamp(2.8rem, 2rem + 3vw, 4rem);
    line-height: 1;
    color: var(--lantern-400);
    text-shadow: 0 2px 0 #6e4e2e, 0 0 28px rgb(242 166 74 / 0.3);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .release__meta {
    margin: 0;
    font-size: 0.95rem;
    color: #e6d2ae;
  }
  .release__stats {
    display: grid;
    gap: 0.45rem;
    padding-left: var(--space-4);
    border-left: 1.5px dashed rgb(199 161 114 / 0.55);
  }
  .release__total {
    margin: 0;
    font-family: 'Ancizar Serif', Georgia, serif;
    font-size: 1.15rem;
    color: var(--stage-ivory);
  }
  .release__total strong {
    font-size: 1.9rem;
    color: var(--stage-ivory);
  }
  .release__total span {
    font-family: inherit;
    font-size: 0.95rem;
    color: #d9c9a6;
  }
  .release__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
    color: #e6d2ae;
  }
  .release__platforms strong {
    color: var(--stage-ivory);
  }
  .release__note {
    margin: 0;
    font-size: 0.82rem;
    color: #cdbb97;
  }
  @media (max-width: 640px) {
    .release {
      grid-template-columns: 1fr;
    }
    .release__stats {
      padding: var(--space-3) 0 0;
      border-left: 0;
      border-top: 1.5px dashed rgb(199 161 114 / 0.55);
    }
  }

  .dl-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-3);
  }
  .dl-head h1 {
    font-size: clamp(2.8rem, 2rem + 4vw, 5rem);
    color: var(--stage-ivory);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.8);
  }
  .dl-head__lede {
    margin-top: var(--space-2);
    max-width: 44ch;
    font-size: var(--step-lead);
    color: var(--moon-200);
  }
  .dl-head__version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin-top: var(--space-3);
    color: var(--moon-200);
  }
  .dl-head__version strong {
    color: var(--moon-100);
  }
  .dl-head__art {
    position: relative;
    height: clamp(320px, 46vh, 480px);
  }
  .dl-phone {
    position: absolute;
    border-radius: 1.9rem;
    padding: 0.5rem;
    background: linear-gradient(160deg, #2b2f3d, #12141c);
    border: 2px solid var(--stage-brass);
    box-shadow: 0 0 0 5px rgb(233 214 172 / 0.9), 0 22px 40px rgb(0 0 0 / 0.55);
  }
  .dl-phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.45rem;
  }
  .dl-phone--front {
    width: clamp(150px, 13vw, 210px);
    left: 34%;
    top: 0;
    transform: rotate(4deg);
  }
  .dl-phone--back {
    width: clamp(130px, 11vw, 180px);
    left: 8%;
    top: 10%;
    transform: rotate(-7deg);
    filter: brightness(0.82);
  }
  .dl-head__art :global(picture) {
    display: contents;
  }
  .dl-head__seer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 52%;
  }
  .dl-head__wolf {
    position: absolute;
    right: 2%;
    bottom: 0;
    height: 60%;
  }
  .dl-note {
    margin-bottom: var(--space-3);
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius-s);
    background: rgb(220 56 46 / 0.12);
    color: var(--moon-100);
    font-weight: 600;
  }

  /* Each platform is a punch-out component card. */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    /* Each card as tall as it needs: the iPhone's tabs make it the tallest. */
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The visitor's own system comes first and large; see the script below.
     Without script all cards simply stand side by side. */
  .card__badge,
  .cards__others {
    display: none;
  }
  /* The other systems two by two on wider windows: no card left alone. */
  @media (min-width: 760px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* The visitor's own card: large, with the steps open beside the download. */
  .card.is-yours {
    order: -2;
    grid-column: 1 / -1;
    padding: 1.8rem 2rem;
    outline: 3px solid #f5aa42;
    outline-offset: 4px;
  }
  .card.is-yours .card__badge {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--curtain-600);
  }
  .card.is-yours h2 {
    font-size: 2rem;
  }
  .card.is-yours .card__download {
    padding-block: 1.1rem;
  }
  @media (min-width: 760px) {
    .card.is-yours:not(.card--ios) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      column-gap: var(--space-4);
      align-items: start;
    }
    .card.is-yours:not(.card--ios) > .card__more,
    .card--ios.is-yours .way > .card__more {
      grid-column: 2;
      grid-row: 1 / span 4;
      margin: 0;
      padding: 0 0 0 var(--space-4);
      border-top: 0;
      border-left: 1px dashed rgb(42 27 18 / 0.25);
    }
    .card--ios.is-yours .way {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      column-gap: var(--space-4);
      align-items: start;
    }
    .card--ios.is-yours .way > :not(.card__more) {
      grid-column: 1;
    }
  }
  [data-os] .cards__others {
    display: block;
    order: -1;
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #f6e8c6;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem;
    border-radius: 1rem;
    color: var(--ink);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.4);
  }
  .card__head {
    display: grid;
    gap: 0.7rem;
  }
  .card__top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .card__token {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #2a3b6b, #141d30);
    color: #f5aa42;
    box-shadow: 0 0 0 0.25rem #e9d6ac, 0 0 0 0.32rem rgb(42 27 18 / 0.35);
  }
  .card__token svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }
  .card h2 {
    font-size: 1.55rem;
    color: var(--ink);
  }
  .card__req {
    font-size: var(--step-small);
    color: var(--ink-soft);
  }
  .card__req span {
    font-weight: 700;
    color: var(--ink);
  }
  .card__files {
    display: grid;
    gap: 0.5rem;
  }
  .card__download {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.8rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.2s ease;
  }
  .card__download:hover {
    color: var(--paper);
    background: #3d2a1d;
    transform: translateY(-2px);

---
// Download page in the game-box world: the release is a programme booklet, each platform
// a punch-out component card with its file, requirements and install steps.
import { Picture } from 'astro:assets';

import Icon from '../Icon.astro';
import Base from '../../layouts/Base.astro';
import { languages, repoUrl, ui, type Lang } from '../../i18n/ui';
import { platformIcons, type PlatformIcon } from '../../lib/platform-icons';
import { loadReleases, type Platform } from '../../lib/releases';
import seherin from '../../../../app/assets/figures/seherin.webp';
import werwolf from '../../../../app/assets/figures/werwolf.webp';
import deRole from '../../assets/screens/de-role.webp';
import enRole from '../../assets/screens/en-role.webp';
import deCalled from '../../assets/screens/de-called.webp';
import enCalled from '../../assets/screens/en-called.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const d = t.download;
const x = t.dl;

const releases = await loadReleases();
const newest = releases[0];
const stable = releases.find((release) => !release.prerelease);
const shown = stable ?? newest;

// iPhone and Mac first: that is where Whowolf is developed and tested.
const platforms: { id: Platform; name: string; icon: PlatformIcon }[] = [
  { id: 'ios', name: 'iPhone & iPad', icon: 'apple' },
  { id: 'macos', name: 'macOS', icon: 'apple' },
  { id: 'android', name: 'Android', icon: 'android' },
  { id: 'windows', name: 'Windows', icon: 'window' },
  { id: 'linux', name: 'Linux', icon: 'linux' },
];
const date = (value: Date) => value.toLocaleDateString(languages[lang].locale, { day: 'numeric', month: 'long', year: 'numeric' });
const formats = ['avif', 'webp'] as const;
---

<Base lang={lang} page="download" title={`${d.title} – Whowolf`} description={d.metaDescription} backdrop="village">
  <main class="dl">
    <header class="dl-head container">
      <div class="dl-head__copy">
        <h1>{d.title}</h1>
        <p class="dl-head__lede">{x.lede}</p>
        {
          shown ? (
            <p class="dl-head__version">
              <span class="stamp stamp--status">{shown.prerelease ? d.prerelease : d.current}</span>
              <strong>{shown.version}</strong> · {date(shown.publishedAt)} · <a href={shown.url}>{d.whatsNew}</a>
            </p>
          ) : (
            <p class="dl-head__version">
              <span class="stamp stamp--wolf">{t.status.badge}</span> {d.none}
            </p>
          )
        }
      </div>
      <div class="dl-head__art" aria-hidden="true">
        <div class="dl-phone dl-phone--back"><Picture src={lang === 'de' ? deCalled : enCalled} alt="" formats={formats} widths={[200, 400]} sizes="11rem" /></div>
        <div class="dl-phone dl-phone--front"><Picture src={lang === 'de' ? deRole : enRole} alt="" formats={formats} widths={[240, 480]} sizes="13rem" /></div>
        <span class="puppet dl-head__seer"><Picture src={seherin} alt="" formats={formats} widths={[160, 320]} sizes="9rem" /></span>
        <span class="puppet dl-head__wolf" style="--delay: -3s"><Picture src={werwolf} alt="" formats={formats} widths={[180, 360]} sizes="10rem" /></span>
      </div>
    </header>

    {shown?.prerelease && <p class="dl-note container">{x.prereleaseNote}</p>}

    <section class="container" aria-label={d.title}>
      <ul class="cards" data-cards>
        {
          platforms.map((platform, i) => {
            const files = shown?.downloads.filter((file) => file.platform === platform.id) ?? [];
            const info = x.platforms[platform.id];
            return (
              <li
                class:list={['card', { 'card--ready': files.length > 0 }]}
                data-reveal
                data-platform={platform.id}
                style={`--i: ${i}`}
              >
                <p class="card__badge">{x.recommended}</p>
                <div class="card__top">
                  <span class="card__token">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={platformIcons[platform.icon]} /></svg>
                  </span>
                  <h2>{platform.name}</h2>
                </div>
                <p class="card__req">
                  <span>{x.requirements}:</span> {info.req}
                </p>
                <div class="card__files">
                  {files.length > 0 ? (
                    files.map((file) => (
                      <a class="card__download" href={file.url}>
                        <Icon name="download" />
                        <span>
                          <strong>{x.getIt}</strong>
                          <small>
                            {file.name} · {file.sizeMb} MB
                          </small>
                        </span>
                      </a>
                    ))
                  ) : (
                    <span class="card__soon">{shown ? d.notInRelease : d.soon}</span>
                  )}
                </div>
                <div class="card__steps">
                  <p class="card__steps-title">{x.install}</p>
                  <ol>
                    {info.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                </div>
              </li>
            );
          })
        }
        <li class="cards__others" aria-hidden="true">{x.others}</li>
      </ul>
    </section>

    <section class="booklet container" aria-labelledby="verify-title" data-reveal>
      <div class="booklet__page">
        <div class="booklet__intro">
          <Icon name="shield" />
          <h2 id="verify-title">{x.verifyTitle}</h2>
          <p>{d.check1}</p>
          <p>{x.verifyText}</p>
          {shown?.checksumsUrl && <a class="button button--ghost" href={shown.checksumsUrl}>SHA256SUMS.txt</a>}
        </div>
        <dl class="booklet__cmds">
          <div>
            <dt>macOS</dt>
            <dd><code>{x.verifyCmd.mac}</code></dd>
          </div>
          <div>
            <dt>Linux</dt>
            <dd><code>{x.verifyCmd.linux}</code></dd>
          </div>
          <div>
            <dt>Windows</dt>
            <dd><code>{x.verifyCmd.win}</code></dd>
          </div>
        </dl>
        <p class="booklet__foot">{d.check2}</p>
      </div>
    </section>

    {
      releases.length > 0 && (
        <section class="history container" aria-labelledby="history-title">
          <h2 id="history-title">{d.older}</h2>
          <ol>
            {releases.map((release) => (
              <li>
                <a href={release.url}>{release.name}</a>
                <span>
                  {date(release.publishedAt)}
                  {release.prerelease ? ` · ${d.prerelease}` : ''}
                </span>
              </li>
            ))}
          </ol>
          <p class="history__more">
            <a class="button button--primary" href={repoUrl}>{t.hero.primary}</a>
            <a class="button button--ghost" href={`${repoUrl}/releases`}>{x.allReleases}</a>
          </p>
        </section>
      )
    }
  </main>
</Base>


<script>
  // Put the visitor's own system first. Only the platform name is read, nothing is stored or sent.
  const cards = document.querySelector<HTMLElement>('[data-cards]');
  if (cards) {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const ua = `${nav.userAgentData?.platform ?? ''} ${navigator.userAgent}`.toLowerCase();
    const touchMac = /mac/.test(ua) && navigator.maxTouchPoints > 1; // iPadOS asks for desktop pages
    const os = /iphone|ipad|ipod/.test(ua) || touchMac
      ? 'ios'
      : /android/.test(ua)
        ? 'android'
        : /win/.test(ua)
          ? 'windows'
          : /mac/.test(ua)
            ? 'macos'
            : /linux|x11/.test(ua) && !/cros/.test(ua)
              ? 'linux'
              : null;
    const card = os ? cards.querySelector<HTMLElement>(`[data-platform="${os}"]`) : null;
    if (card) {
      card.classList.add('is-yours');
      cards.dataset.os = os!;
    }
  }
</script>

<style>
  .dl {
    padding-bottom: var(--space-5);
  }
  .dl-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-3);
  }
  .dl-head h1 {
    font-size: clamp(2.8rem, 2rem + 4vw, 5rem);
    color: var(--stage-ivory);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.8);
  }
  .dl-head__lede {
    margin-top: var(--space-2);
    max-width: 44ch;
    font-size: var(--step-lead);
    color: var(--moon-200);
  }
  .dl-head__version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin-top: var(--space-3);
    color: var(--moon-200);
  }
  .dl-head__version strong {
    color: var(--moon-100);
  }
  .dl-head__art {
    position: relative;
    height: clamp(320px, 46vh, 480px);
  }
  .dl-phone {
    position: absolute;
    border-radius: 1.9rem;
    padding: 0.5rem;
    background: linear-gradient(160deg, #2b2f3d, #12141c);
    border: 2px solid var(--stage-brass);
    box-shadow: 0 0 0 5px rgb(233 214 172 / 0.9), 0 22px 40px rgb(0 0 0 / 0.55);
  }
  .dl-phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.45rem;
  }
  .dl-phone--front {
    width: clamp(150px, 13vw, 210px);
    left: 34%;
    top: 0;
    transform: rotate(4deg);
  }
  .dl-phone--back {
    width: clamp(130px, 11vw, 180px);
    left: 8%;
    top: 10%;
    transform: rotate(-7deg);
    filter: brightness(0.82);
  }
  .dl-head__art :global(picture) {
    display: contents;
  }
  .dl-head__seer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 52%;
  }
  .dl-head__wolf {
    position: absolute;
    right: 2%;
    bottom: 0;
    height: 60%;
  }
  .dl-note {
    margin-bottom: var(--space-3);
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius-s);
    background: rgb(220 56 46 / 0.12);
    color: var(--moon-100);
    font-weight: 600;
  }

  /* Each platform is a punch-out component card. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The visitor's own system comes first and large; see the script below.
     Without script all cards simply stand side by side. */
  .card__badge,
  .cards__others {
    display: none;
  }
  .card.is-yours {
    order: -2;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
    padding: 1.8rem 2rem;
    outline: 3px solid #f5aa42;
    outline-offset: 4px;
  }
  .card.is-yours > :not(.card__steps) {
    grid-column: 1;
  }
  .card.is-yours .card__steps {
    grid-column: 2;
    grid-row: 1 / span 4;
    margin-top: 0;
    padding-top: 0;
    padding-left: var(--space-4);
    border-top: 0;
    border-left: 1px dashed rgb(42 27 18 / 0.25);
  }
  .card.is-yours .card__badge {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--curtain-600);
  }
  .card.is-yours h2 {
    font-size: 2rem;
  }
  .card.is-yours .card__download {
    padding-block: 1.1rem;
  }
  [data-os] .cards__others {
    display: block;
    order: -1;
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #f6e8c6;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem;
    border-radius: 1rem;
    color: var(--ink);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.4);
  }
  .card__top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .card__token {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #2a3b6b, #141d30);
    color: #f5aa42;
    box-shadow: 0 0 0 0.25rem #e9d6ac, 0 0 0 0.32rem rgb(42 27 18 / 0.35);
  }
  .card__token svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }
  .card h2 {
    font-size: 1.55rem;
    color: var(--ink);
  }
  .card__req {
    font-size: var(--step-small);
    color: var(--ink-soft);
  }
  .card__req span {
    font-weight: 700;
    color: var(--ink);
  }
  .card__files {
    display: grid;
    gap: 0.5rem;
  }
  .card__download {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.8rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.2s ease;
  }
  .card__download:hover {
    color: var(--paper);
    background: #3d2a1d;
    transform: translateY(-2px);
  }
  .card__download :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    color: #f5aa42;
  }
  .card__download span {
    display: grid;
    min-width: 0;
  }
  .card__download small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8rem;
    opacity: 0.75;
  }
  .card__soon {
    padding: 0.7rem 0.9rem;
    border-radius: 0.8rem;
    border: 2px dashed rgb(42 27 18 / 0.3);
    color: var(--ink-soft);
    font-size: var(--step-small);
    font-weight: 600;
  }
  .card__steps {
    margin-top: 0.2rem;
    padding-top: 0.9rem;
    border-top: 1px dashed rgb(42 27 18 / 0.25);
  }
  .card__steps-title {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--curtain-600);
  }
  .card__steps ol {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .card__steps li {
    position: relative;
    padding-left: 1.7rem;
    counter-increment: step;
  }
  .card__steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.05rem;
    display: grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--ink);
    color: #f5aa42;
    font-size: 0.7rem;
    font-weight: 800;
  }
  .card__steps li + li {
    margin-top: 0.45rem;
  }
  .card__req {
    min-height: 2.9em;
  }

  /* Verification as a page of the rule booklet. */
  .booklet {
    margin-top: var(--space-5);
  }
  .booklet__page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: 0.6rem;
    color: var(--ink);
    background: #f7ecd2;
    box-shadow:
      inset 0 0 0 0.55rem #f7ecd2,
      inset 0 0 0 0.65rem #b98a43,
      inset 0 0 0 0.85rem #f7ecd2,
      inset 0 0 0 0.92rem #b98a43,
      0 1rem 2rem rgb(0 0 0 / 0.35);
  }
  .booklet__intro {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }
  .booklet__intro > :global(svg) {
    width: 2.4rem;
    height: 2.4rem;
    color: var(--curtain-600);
  }
  .booklet__intro h2 {
    font-size: var(--step-heading);
    color: var(--ink);
  }
  .booklet__intro p {
    color: var(--ink-soft);
  }
  .booklet__intro .button {
    justify-self: start;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink-soft);
  }
  .booklet__cmds {
    display: grid;
    align-content: center;
    gap: 1rem;
    margin: 0;
  }
  .booklet__cmds dt {
    font-weight: 700;
  }
  .booklet__cmds code {
    display: block;
    margin-top: 0.3rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    background: #2a1b12;
    color: #f6e8c6;
    font-size: 0.88rem;
    overflow-x: auto;
  }
  .booklet__foot {
    grid-column: 1 / -1;
    color: var(--ink-soft);
    font-size: var(--step-small);
  }

  .history {
    margin-top: var(--space-5);
  }
  .history h2 {
    font-size: var(--step-heading);
  }
  .history ol {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .history li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem var(--space-2);
    padding-block: 0.8rem;
    color: var(--moon-200);
  }
  .history li + li {
    border-top: 1px dotted rgb(246 232 198 / 0.3);
  }
  .history__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (max-width: 700px) {
    .card.is-yours {
      display: flex;
      padding: 1.4rem;
    }
    .card.is-yours .card__steps {
      padding-left: 0;
      padding-top: 0.9rem;
      border-left: 0;
      border-top: 1px dashed rgb(42 27 18 / 0.25);
    }
  }
  @media (max-width: 900px) {
    .dl-head,
    .booklet__page {
      grid-template-columns: 1fr;
    }
    .dl-head__art {
      max-width: 26rem;
    }
    .booklet__page {
      padding: var(--space-4) 1.4rem;
    }
  }
</style>

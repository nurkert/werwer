---
// Download page in the game-box world: the release is a programme booklet, each platform
// a punch-out component card with its file, requirements and install steps.
import { Picture } from 'astro:assets';

import Icon from '../Icon.astro';
import Base from '../../layouts/Base.astro';
import { languages, repoUrl, ui, type Lang } from '../../i18n/ui';
import { loadReleases, type Platform } from '../../lib/releases';
import seherin from '../../../../design/source/figures/seherin.png';
import tableCluster from '../../assets/plates/table-cluster.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const d = t.download;
const x = t.dl;

const releases = await loadReleases();
const newest = releases[0];
const stable = releases.find((release) => !release.prerelease);
const shown = stable ?? newest;

// iPhone and Mac first: that is where Whowolf is developed and tested.
const platforms: { id: Platform; name: string; icon: 'phone' | 'laptop' | 'terminal' }[] = [
  { id: 'ios', name: 'iPhone & iPad', icon: 'phone' },
  { id: 'macos', name: 'macOS', icon: 'laptop' },
  { id: 'android', name: 'Android', icon: 'phone' },
  { id: 'windows', name: 'Windows', icon: 'laptop' },
  { id: 'linux', name: 'Linux', icon: 'terminal' },
];
const date = (value: Date) => value.toLocaleDateString(languages[lang].locale, { day: 'numeric', month: 'long', year: 'numeric' });
const formats = ['avif', 'webp'] as const;
---

<Base lang={lang} page="download" title={`${d.title} – Whowolf`} description={d.metaDescription}>
  <main class="dl">
    <header class="dl-head container">
      <div class="dl-head__copy">
        <h1>{d.title}</h1>
        <p class="dl-head__lede">{x.lede}</p>
        {
          shown ? (
            <p class="dl-head__version">
              <span class="stamp stamp--wolf">{shown.prerelease ? d.prerelease : d.current}</span>
              <strong>{shown.version}</strong> · {date(shown.publishedAt)} · <a href={shown.url}>{d.whatsNew}</a>
            </p>
          ) : (
            <p class="dl-head__version">
              <span class="stamp stamp--wolf">{t.status.badge}</span> {d.none}
            </p>
          )
        }
      </div>
      <div class="dl-head__art" aria-hidden="true">
        <Picture class="dl-head__cluster" src={tableCluster} alt="" formats={formats} widths={[480, 960]} sizes="(max-width: 900px) 80vw, 34vw" />
        <Picture class="dl-head__seer" src={seherin} alt="" formats={formats} widths={[200, 400]} sizes="12rem" />
      </div>
    </header>

    {shown?.prerelease && <p class="dl-note container">{x.prereleaseNote}</p>}

    <section class="container" aria-label={d.title}>
      <ul class="cards">
        {
          platforms.map((platform, i) => {
            const files = shown?.downloads.filter((file) => file.platform === platform.id) ?? [];
            const info = x.platforms[platform.id];
            return (
              <li class:list={['card', { 'card--ready': files.length > 0 }]} data-reveal style={`--i: ${i}`}>
                <div class="card__top">
                  <span class="card__token">
                    <Icon name={platform.icon} />
                  </span>
                  <h2>{platform.name}</h2>
                </div>
                <p class="card__req">
                  <span>{x.requirements}:</span> {info.req}
                </p>
                <div class="card__files">
                  {files.length > 0 ? (
                    files.map((file) => (
                      <a class="card__download" href={file.url}>
                        <Icon name="download" />
                        <span>
                          <strong>{x.getIt}</strong>
                          <small>
                            {file.name} · {file.sizeMb} MB
                          </small>
                        </span>
                      </a>
                    ))
                  ) : (
                    <span class="card__soon">{shown ? d.notInRelease : d.soon}</span>
                  )}
                </div>
                <details class="card__steps">
                  <summary>{x.install}</summary>
                  <ol>
                    {info.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                </details>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="booklet container" aria-labelledby="verify-title" data-reveal>
      <div class="booklet__page">
        <div class="booklet__intro">
          <Icon name="shield" />
          <h2 id="verify-title">{x.verifyTitle}</h2>
          <p>{d.check1}</p>
          <p>{x.verifyText}</p>
          {shown?.checksumsUrl && <a class="button button--ghost" href={shown.checksumsUrl}>SHA256SUMS.txt</a>}
        </div>
        <dl class="booklet__cmds">
          <div>
            <dt>macOS</dt>
            <dd><code>{x.verifyCmd.mac}</code></dd>
          </div>
          <div>
            <dt>Linux</dt>
            <dd><code>{x.verifyCmd.linux}</code></dd>
          </div>
          <div>
            <dt>Windows</dt>
            <dd><code>{x.verifyCmd.win}</code></dd>
          </div>
        </dl>
        <p class="booklet__foot">{d.check2}</p>
      </div>
    </section>

    {
      releases.length > 0 && (
        <section class="history container" aria-labelledby="history-title">
          <h2 id="history-title">{d.older}</h2>
          <ol>
            {releases.map((release) => (
              <li>
                <a href={release.url}>{release.name}</a>
                <span>
                  {date(release.publishedAt)}
                  {release.prerelease ? ` · ${d.prerelease}` : ''}
                </span>
              </li>
            ))}
          </ol>
          <p class="history__more">
            <a class="button button--primary" href={repoUrl}>{t.hero.primary}</a>
            <a class="button button--ghost" href={`${repoUrl}/releases`}>{x.allReleases}</a>
          </p>
        </section>
      )
    }
  </main>
</Base>

<style>
  .dl {
    padding-bottom: var(--space-5);
  }
  .dl-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-3);
  }
  .dl-head h1 {
    font-size: clamp(2.8rem, 2rem + 4vw, 5rem);
    color: var(--moon-100);
  }
  .dl-head__lede {
    margin-top: var(--space-2);
    max-width: 44ch;
    font-size: var(--step-lead);
    color: var(--moon-200);
  }
  .dl-head__version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin-top: var(--space-3);
    color: var(--moon-200);
  }
  .dl-head__version strong {
    color: var(--moon-100);
  }
  .dl-head__art {
    position: relative;
  }
  .dl-head__art :global(picture) {
    display: contents;
  }
  .dl-head__art :global(.dl-head__cluster) {
    width: 100%;
    height: auto;
    transform: rotate(-3deg);
    filter: drop-shadow(0 1.2rem 1.6rem rgb(0 0 0 / 0.5));
  }
  .dl-head__art :global(.dl-head__seer) {
    position: absolute;
    left: -6%;
    bottom: -8%;
    width: 28%;
    height: auto;
    transform: rotate(-5deg);
    filter: drop-shadow(0 0.8rem 1rem rgb(0 0 0 / 0.5));
  }
  .dl-note {
    margin-bottom: var(--space-3);
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius-s);
    background: rgb(220 56 46 / 0.12);
    color: var(--moon-100);
    font-weight: 600;
  }

  /* Each platform is a punch-out component card. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem;
    border-radius: 1rem;
    color: var(--ink);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.4);
  }
  .card__top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .card__token {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #2a3b6b, #141d30);
    color: #f5aa42;
    box-shadow: 0 0 0 0.25rem #e9d6ac, 0 0 0 0.32rem rgb(42 27 18 / 0.35);
  }
  .card__token :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .card h2 {
    font-size: 1.55rem;
    color: var(--ink);
  }
  .card__req {
    font-size: var(--step-small);
    color: var(--ink-soft);
  }
  .card__req span {
    font-weight: 700;
    color: var(--ink);
  }
  .card__files {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
  }
  .card__download {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.8rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.2s ease;
  }
  .card__download:hover {
    color: var(--paper);
    background: #3d2a1d;
    transform: translateY(-2px);
  }
  .card__download :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    color: #f5aa42;
  }
  .card__download span {
    display: grid;
    min-width: 0;
  }
  .card__download small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8rem;
    opacity: 0.75;
  }
  .card__soon {
    padding: 0.7rem 0.9rem;
    border-radius: 0.8rem;
    border: 2px dashed rgb(42 27 18 / 0.3);
    color: var(--ink-soft);
    font-size: var(--step-small);
    font-weight: 600;
  }
  .card__steps summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--curtain-600);
  }
  .card__steps ol {
    margin: 0.6rem 0 0;
    padding-left: 1.2rem;
    font-size: var(--step-small);
    color: var(--ink-soft);
  }
  .card__steps li + li {
    margin-top: 0.3rem;
  }

  /* Verification as a page of the rule booklet. */
  .booklet {
    margin-top: var(--space-5);
  }
  .booklet__page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: 0.6rem;
    color: var(--ink);
    background: #f7ecd2;
    box-shadow:
      inset 0 0 0 0.55rem #f7ecd2,
      inset 0 0 0 0.65rem #b98a43,
      inset 0 0 0 0.85rem #f7ecd2,
      inset 0 0 0 0.92rem #b98a43,
      0 1rem 2rem rgb(0 0 0 / 0.35);
  }
  .booklet__intro {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }
  .booklet__intro > :global(svg) {
    width: 2.4rem;
    height: 2.4rem;
    color: var(--curtain-600);
  }
  .booklet__intro h2 {
    font-size: var(--step-heading);
    color: var(--ink);
  }
  .booklet__intro p {
    color: var(--ink-soft);
  }
  .booklet__intro .button {
    justify-self: start;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink-soft);
  }
  .booklet__cmds {
    display: grid;
    align-content: center;
    gap: 1rem;
    margin: 0;
  }
  .booklet__cmds dt {
    font-weight: 700;
  }
  .booklet__cmds code {
    display: block;
    margin-top: 0.3rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    background: #2a1b12;
    color: #f6e8c6;
    font-size: 0.88rem;
    overflow-x: auto;
  }
  .booklet__foot {
    grid-column: 1 / -1;
    color: var(--ink-soft);
    font-size: var(--step-small);
  }

  .history {
    margin-top: var(--space-5);
  }
  .history h2 {
    font-size: var(--step-heading);
  }
  .history ol {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .history li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem var(--space-2);
    padding-block: 0.8rem;
    color: var(--moon-200);
  }
  .history li + li {
    border-top: 1px dotted rgb(246 232 198 / 0.3);
  }
  .history__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (max-width: 900px) {
    .dl-head,
    .booklet__page {
      grid-template-columns: 1fr;
    }
    .dl-head__art {
      max-width: 26rem;
    }
    .booklet__page {
      padding: var(--space-4) 1.4rem;
    }
  }
</style>

---
// Landing page of the room QR code (https://whowolf.de/join?room=…). Someone who scans the
// code with the plain camera lands here. The page shows the way that fits their device: an
// iPhone plays in the browser (there is no iPhone app to get yet), Android and computers get
// the app and the codes to type in. Nothing is sent anywhere; the values are read and shown in
// the browser.
import { Picture } from 'astro:assets';

import Base from '../../layouts/Base.astro';
import { path, ui, type Lang } from '../../i18n/ui';
import werwolf from '../../../../design/source/figures/werwolf.png';
import seherin from '../../../../design/source/figures/seherin.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const j = t.join;
const formats = ['avif', 'webp'] as const;
const devices = ['ios', 'android', 'desktop'] as const;
---

<Base lang={lang} page="join" noindex title={`${j.metaTitle} – Whowolf`} description={j.metaDescription} backdrop="village">
  <main class="join" data-join>
    <div class="join__figures" aria-hidden="true">
      <Picture src={seherin} alt="" formats={formats} widths={[200, 400]} sizes="8rem" />
      <Picture src={werwolf} alt="" formats={formats} widths={[240, 480]} sizes="10rem" />
    </div>

    <section class="paper join__card">
      <header class="join__head">
        <h1>{j.title}</h1>
        <p class="join__lead">{j.lead}</p>
        <p class="join__ticket" data-join-ticket hidden>
          <span>{j.roomLabel}</span>
          <strong data-join-room></strong>
        </p>
        <p class="join__invalid" data-join-invalid hidden>{j.invalid}</p>
      </header>

      <div class="join__devices" role="tablist" aria-label={j.deviceLabel} data-join-tabs hidden>
        {
          devices.map((d) => (
            <button type="button" role="tab" id={`tab-${d}`} aria-controls={`way-${d}`} aria-selected="false" data-device={d}>
              {j.views[d].tab}
            </button>
          ))
        }
      </div>

      {
        devices.map((d) => {
          const v = j.views[d];
          return (
            <article class="join__way" id={`way-${d}`} role="tabpanel" aria-labelledby={`tab-${d}`} data-way={d}>
              <h2>{v.title}</h2>
              <p class="join__text">{v.text}</p>
              <ol class="join__steps">
                {v.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
              {'cta' in v && (
                <a class="button button--primary join__cta" href={path('download', lang)}>
                  {v.cta}
                </a>
              )}
              {d !== 'ios' && (
                <div class="join__codes" data-join-codes hidden>
                  <h3>{j.manual}</h3>
                  <dl>
                    <div data-field="room">
                      <dt>{j.room}</dt>
                      <dd />
                    </div>
                    <div data-field="lan" hidden>
                      <dt>{j.address}</dt>
                      <dd />
                    </div>
                    <div data-field="relay" hidden>
                      <dt>{j.online}</dt>
                      <dd />
                    </div>
                  </dl>
                </div>
              )}
              <p class="join__note">{v.note}</p>
            </article>
          );
        })
      }

      <p class="join__privacy">{j.privacy}</p>
    </section>
  </main>
</Base>

<script>
  // Picks the way for this device and shows the codes from the link, validated as strictly as
  // the app does. Only text is set (textContent), never HTML; nothing is stored or sent.
  const root = document.querySelector<HTMLElement>('[data-join]');
  if (root) {
    const q = new URLSearchParams(location.search);
    const room = q.get('room') ?? '';
    const lan = q.get('lan');
    const relay = q.get('relay');
    const privateIp = (value: string) => {
      const [ip, port = '47470'] = value.split(':');
      const o = ip.split('.').map(Number);
      const okIp =
        o.length === 4 &&
        o.every((n) => Number.isInteger(n) && n >= 0 && n < 256) &&
        (o[0] === 10 || (o[0] === 172 && o[1] >= 16 && o[1] <= 31) || (o[0] === 192 && o[1] === 168));
      const p = Number(port);
      return okIp && Number.isInteger(p) && p > 0 && p < 65536;
    };
    const valid =
      /^[0-9]{4}$/.test(room) &&
      (lan === null || privateIp(lan)) &&
      (relay === null || /^[a-hjkmnp-z2-9]{8}$/.test(relay)) &&
      (lan !== null || relay !== null);

    if (valid) {
      root.querySelector<HTMLElement>('[data-join-ticket]')!.hidden = false;
      root.querySelector('[data-join-room]')!.textContent = room;
      const values: Record<string, string | null> = { room, lan, relay };
      root.querySelectorAll<HTMLElement>('[data-join-codes]').forEach((codes) => {
        codes.hidden = false;
        codes.querySelectorAll<HTMLElement>('[data-field]').forEach((row) => {
          const value = values[row.dataset.field!];
          if (value === null) return;
          row.hidden = false;
          row.querySelector('dd')!.textContent = value;
        });
      });
    } else if (location.search) {
      root.querySelector<HTMLElement>('[data-join-invalid]')!.hidden = false;
    }

    // The device from the browser (an iPad asks for desktop pages but has a touch screen).
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const ua = `${nav.userAgentData?.platform ?? ''} ${navigator.userAgent}`.toLowerCase();
    const touchMac = /mac/.test(ua) && navigator.maxTouchPoints > 1;
    const mine = /iphone|ipad|ipod/.test(ua) || touchMac ? 'ios' : /android/.test(ua) ? 'android' : 'desktop';

    const tabs = root.querySelector<HTMLElement>('[data-join-tabs]')!;
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-device]')];
    const show = (device: string, focus = false) => {
      root.dataset.device = device;
      for (const b of buttons) {
        const on = b.dataset.device === device;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      }
    };
    tabs.hidden = false;
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => show(b.dataset.device!));
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        show(buttons[(i + step + buttons.length) % buttons.length].dataset.device!, true);
      });
    });
    show(mine);
  }
</script>

<style>
  .join {
    display: grid;
    justify-items: center;
    padding: 5.5rem var(--gutter) var(--space-6);
  }

  /* The two figures stand on the card's top edge. */
  .join__figures {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    margin-bottom: -1.6rem;
    pointer-events: none;
  }
  .join__figures :global(img) {
    display: block;
    width: auto;
    height: clamp(6.5rem, 22vw, 8.5rem);
    filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.4));
  }
  .join__figures :global(picture:last-child img) {
    height: clamp(7.5rem, 25vw, 10rem);
  }

  .join__card {
    width: min(100%, 36rem);
    margin: 0;
    padding: calc(var(--space-4) + 0.6rem) clamp(1.1rem, 5vw, 2.5rem) var(--space-4);
    border-radius: var(--radius-l);
  }

  .join__head {
    text-align: center;
  }
  .join h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 8vw, 3rem);
    line-height: 1.05;
    color: var(--ink);
    text-wrap: balance;
  }
  .join__lead {
    margin-top: 0.6rem;
    font-size: 1.1rem;
    text-wrap: balance;
  }

  /* The room number as a ticket stub. */
  .join__ticket {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: var(--space-3);
    padding: 0.45rem 1.1rem 0.5rem;
    border: 2px dashed rgb(42 27 18 / 0.35);
    border-radius: 0.7rem;
    background: rgb(255 255 255 / 0.28);
  }
  .join__ticket span {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--curtain-600) !important;
  }
  .join__ticket strong {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .join__invalid {
    margin-top: var(--space-3);
    font-weight: 700;
    color: var(--curtain-600) !important;
  }

  /* Device switch: a segmented control, the visitor's own device chosen. */
  .join__devices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
    margin: var(--space-4) auto 0;
    padding: 0.25rem;
    max-width: 22rem;
    border-radius: 999px;
    background: rgb(42 27 18 / 0.1);
  }
  .join__devices[hidden] {
    display: none;
  }
  .join__devices button {
    min-height: 44px;
    padding: 0 0.6rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-weight: 700;
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .join__devices button:hover {
    color: var(--ink);
  }
  .join__devices button[aria-selected='true'] {
    background: var(--ink);
    color: #f5c06a;
  }
  .join__devices button:focus-visible {
    outline: 3px solid var(--curtain-600);
    outline-offset: 2px;
  }

  /* One way per device; without script all three stand one below the other. */
  .join__way {
    margin-top: var(--space-4);
  }
  .join[data-device] .join__way {
    display: none;
  }
  .join[data-device='ios'] [data-way='ios'],
  .join[data-device='android'] [data-way='android'],
  .join[data-device='desktop'] [data-way='desktop'] {
    display: block;
    animation: way-in 260ms ease-out;
  }
  @keyframes way-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .join__way h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5.5vw, 1.9rem);
    line-height: 1.1;
    text-align: center;
  }
  .join__text {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  .join__steps {
    display: grid;
    gap: 0.85rem;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .join__steps li {
    position: relative;
    padding-left: 2.6rem;
    min-height: 1.8rem;
    font-size: 1.02rem;
    line-height: 1.5;
    counter-increment: step;
  }
  .join__steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--ink);
    color: #f5aa42;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .join__cta {
    display: flex;
    justify-content: center;
    width: fit-content;
    min-height: 48px;
    margin: var(--space-4) auto 0;
  }

  .join__codes {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-2);
    border-radius: 0.9rem;
    background: rgb(42 27 18 / 0.07);
    text-align: center;
  }
  .join__codes[hidden] {
    display: none;
  }
  .join__codes h3 {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .join__codes dl {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
  }
  .join__codes dl > div[hidden] {
    display: none;
  }
  .join__codes dt {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--curtain-600);
  }
  .join__codes dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 5vw, 1.7rem);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .join__note {
    margin-top: var(--space-3);
    text-align: center;
    font-size: 0.95rem;
    font-style: italic;
  }
  .join__privacy {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed rgb(42 27 18 / 0.25);
    text-align: center;
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .join__way {
      animation: none !important;
    }
    .join__devices button {
      transition: none;
    }
  }
</style>

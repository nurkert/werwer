---
// The home page as a play in scenes (task 012, as in the app): every
// section is a painted stage set by moonlight with cardboard scenery, the
// content on plaques in front. The pictures are the app's own.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

import CountingSheep from '../CountingSheep.astro';
import Icon from '../Icon.astro';
import TrailDiagram from '../TrailDiagram.astro';
import Scene from '../stage/Scene.astro';
import Base from '../../layouts/Base.astro';
import { path, repoUrl, ui, type Lang } from '../../i18n/ui';
import { devHref, docSummary, docTitle } from '../../lib/docs';
import { loadReleases } from '../../lib/releases';

import village from '../../../../app/assets/stage/village.webp';
import theatre from '../../../../app/assets/stage/theatre.webp';
import morning from '../../../../app/assets/stage/morning.webp';
import nightlake from '../../../../app/assets/stage/nightlake.webp';
import dusk from '../../../../app/assets/stage/dusk.webp';
import hunt from '../../../../app/assets/stage/hunt.webp';
import backstage from '../../../../app/assets/stage/backstage.webp';
import finale from '../../../../app/assets/stage/finale.webp';

import oak from '../../../../app/assets/stage/scenery/oak.webp';
import house from '../../../../app/assets/stage/scenery/house.webp';
import lamppost from '../../../../app/assets/stage/scenery/lamppost.webp';
import fence from '../../../../app/assets/stage/scenery/fence.webp';
import stall from '../../../../app/assets/stage/scenery/stall.webp';
import curtain from '../../../../app/assets/stage/scenery/curtain.webp';
import swag from '../../../../app/assets/stage/scenery/swag.webp';
import tassel from '../../../../app/assets/stage/scenery/tassel.webp';
import apple from '../../../../app/assets/stage/scenery/apple.webp';
import hay from '../../../../app/assets/stage/scenery/hay.webp';
import branch from '../../../../app/assets/stage/scenery/branch.webp';
import pines from '../../../../app/assets/stage/scenery/pines.webp';
import owl from '../../../../app/assets/stage/scenery/owl.webp';
import birch from '../../../../app/assets/stage/scenery/birch.webp';
import reeds from '../../../../app/assets/stage/scenery/reeds.webp';
import pinebranch from '../../../../app/assets/stage/scenery/pinebranch.webp';
import garland from '../../../../app/assets/stage/scenery/garland.webp';
import garlandHook from '../../../../design/source/scenery/garland_hook.png';

import wordmark from '../../../../design/source/brand/wordmark.png';
import werwolf from '../../../../app/assets/figures/werwolf.webp';
import seherin from '../../../../app/assets/figures/seherin.webp';
import hexe from '../../../../app/assets/figures/hexe.webp';
import jaeger from '../../../../app/assets/figures/jaeger.webp';
import amor from '../../../../app/assets/figures/amor.webp';
import dorfbewohner from '../../../../app/assets/figures/dorfbewohner.webp';
import magd from '../../../../app/assets/figures/magd.webp';
import baeckerin from '../../../../app/assets/figures/poses/baeckerin_3.webp';
import schmied from '../../../../app/assets/figures/poses/schmied_1.webp';

import deRole from '../../assets/screens/de-role.webp';
import deFigure from '../../assets/screens/de-figure.webp';
import enRole from '../../assets/screens/en-role.webp';
import enFigure from '../../assets/screens/en-figure.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const formats = ['avif', 'webp'] as const;

const releases = await loadReleases();
// Only a real release (not a 0.0.x pre-release) may announce that the game is out.
const latest = releases.find((release) => !release.prerelease);

const docs = await getCollection('docs');
const featuredDocs = ['vision', 'game_design', 'night_sounds', 'security_design']
  .map((id) => docs.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);

const screens = lang === 'de' ? { role: deRole, figure: deFigure } : { role: enRole, figure: enFigure };
const roles = [
  { id: 'villager', img: dorfbewohner, side: t.cast.village },
  { id: 'werewolf', img: werwolf, side: t.cast.wolves },
  { id: 'seer', img: seherin, side: t.cast.village },
  { id: 'witch', img: hexe, side: t.cast.village },
  { id: 'hunter', img: jaeger, side: t.cast.village },
  { id: 'cupid', img: amor, side: t.cast.village },
] as const;
const ensemble = import.meta.glob<{ default: ImageMetadata }>('../../../../app/assets/figures/poses/*_2.webp', {
  eager: true,
});
const people = t.cast.ensemble.figures.map((f) => ({
  ...f,
  img: ensemble[`../../../../app/assets/figures/poses/${f.id}_2.webp`]?.default,
}));
const download = latest ? path('download', lang) : repoUrl;
---

<Base lang={lang} page="home" overlay title={t.meta.title} description={t.meta.description}>
  <main id="inhalt">
    <!-- The village at dusk: what this is. -->
    <Scene
      first
      set={village}
      labelledby="hero-title"
      moon={{ kind: 'full', x: '47%', y: '3.5%', size: 'clamp(56px, 8vmin, 100px)' }}
      pieces={[
        { src: stall, at: 'right', h: '46', inset: '8vw', hide: '10%', wide: true },
        { src: oak, at: 'left', h: '82', hide: '62%', hidePhone: '66%' },
        { src: lamppost, at: 'left', h: '36', inset: 'max(3vw, calc(17vw - 190px))', hide: '18%', wide: true, front: true },
        { src: house, at: 'right', h: '84', hide: '52%', hidePhone: '70%' },
      ]}
    >
      <div class="hero">
        <div class="hero__copy">
          <h1 id="hero-title" class="hero__title">
            <Picture src={wordmark} alt="Whowolf" formats={formats} widths={[360, 720, 1080]} sizes="(min-width: 900px) 34rem, 80vw" loading="eager" fetchpriority="high" />
          </h1>
          <p class="hero__statement">{t.hero.statement}</p>
          <p class="stage-lead hero__sub">{t.hero.sub}</p>
          <div class="hero__actions">
            <a class="btn btn--lantern" href={download}>
              {latest ? t.ticket.ctaReleased : t.hero.primary}
              <Icon name="arrow" />
            </a>
            <a class="btn btn--plaque" href="#abend">{t.evening.title.replace(/\.$/, '')}</a>
          </div>
        </div>
        <div class="hero__stage" aria-hidden="true">
          <div class="phone phone--back">
            <Picture src={screens.figure} alt="" formats={formats} widths={[300, 600]} sizes="12rem" loading="eager" />
          </div>
          <div class="phone phone--front">
            <Picture src={screens.role} alt="" formats={formats} widths={[300, 600]} sizes="14rem" loading="eager" />
          </div>
          <span class="puppet hero__wolf" style="--delay: -2s">
            <Picture src={werwolf} alt="" formats={formats} widths={[220, 440]} sizes="12rem" loading="eager" />
          </span>
          <span class="puppet hero__maid" style="--delay: -4s">
            <Picture src={magd} alt="" formats={formats} widths={[180, 360]} sizes="9rem" loading="eager" />
          </span>
        </div>
      </div>
    </Scene>

    <!-- The theatre: an evening without a game master. -->
    <Scene
      id="spiel"
      set={theatre}
      labelledby="spiel-title"
      moon={{ kind: 'full', x: '50%', y: '3%', size: 'clamp(70px, 12vmin, 130px)' }}
      pieces={[
        { src: curtain, at: 'hang-left', h: '100', hide: '56%', hidePhone: '62%' },
        { src: curtain, at: 'hang-right', h: '100', hide: '56%', hidePhone: '62%', mirror: true },
        { src: swag, at: 'top', h: 'max(130px, 11vw)', hide: '0%', repeat: 4, joint: { src: tassel, h: 'max(160px, 13.5vw)', y: '-3%' } },
      ]}
    >
      <header class="stage-head">
        <p class="eyebrow">{t.eyebrows.play}</p>
        <h2 id="spiel-title" class="stage-title" data-reveal>{t.playbill.title}</h2>
        <p class="stage-lead" data-reveal style="--i: 1">{t.playbill.intro}</p>
      </header>
      <ul class="plaques plaques--three">
        {
          t.playbill.pillars.map((p, i) => (
            <li class="plaque" data-reveal style={`--i: ${i}`}>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </Scene>

    <!-- The morning: the evening in five acts. -->
    <Scene
      id="abend"
      set={morning}
      labelledby="abend-title"
      pieces={[
        { src: branch, at: 'top-right', h: '40', hide: '12%', mirror: true, wide: true },
        { src: apple, at: 'left', h: '72', hide: '50%', hidePhone: '68%' },
        { src: hay, at: 'right', h: '30', hide: '30%', hidePhone: '55%' },
      ]}
    >
      <header class="stage-head">
        <p class="eyebrow">{t.eyebrows.evening}</p>
        <h2 id="abend-title" class="stage-title" data-reveal>{t.evening.title}</h2>
      </header>
      <ol class="acts">
        {
          t.evening.acts.map((a, i) => (
            <li class="plaque" data-reveal style={`--i: ${i}`}>
              <span class="acts__icon">
                <Icon name={a.icon as 'qr'} />
              </span>
              <p class="acts__act">{a.act}</p>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ol>
    </Scene>

    <!-- The lake at night: counting sheep. -->
    <Scene
      id="schaefchen"
      set={nightlake}
      labelledby="sheep-title"
      moon={{ kind: 'full', x: '74%', y: '3%', size: 'clamp(64px, 11vmin, 130px)' }}
      pieces={[
        { src: pinebranch, at: 'top-left', h: '42', hide: '18%' },
        { src: reeds, at: 'right', h: '30', inset: '6vw', hide: '10%', wide: true },
        { src: pines, at: 'left', h: '84', hide: '52%', hidePhone: '72%' },
        { src: owl, at: 'right', h: '82', hide: '52%', hidePhone: '72%' },
      ]}
    >
      <header class="stage-head">
        <p class="eyebrow">{t.eyebrows.night}</p>
        <h2 id="sheep-title" class="stage-title" data-reveal>{t.sheep.title}</h2>
        <p class="stage-lead" data-reveal style="--i: 1">{t.sheep.intro}</p>
      </header>
      <div class="plaque meadow" data-reveal style="--i: 2">
        <p class="meadow__rule">{t.sheep.rule}</p>
        <CountingSheep lang={lang} />
      </div>
    </Scene>

    <!-- The square at dusk: the roles and the ensemble. -->
    <Scene
      id="rollen"
      set={dusk}
      labelledby="cast-title"
      moon={{ kind: 'crescent', x: '76%', y: '4%', size: 'clamp(64px, 11vmin, 130px)' }}
      pieces={[
        {
          src: garland,
          at: 'top',
          h: 'clamp(84px, 15vh, 180px)',
          hide: '-28%',
          repeat: 5,
          // The ropes of two lengths meet in an iron ring on a chain from above.
          joint: { src: garlandHook, h: 'calc(1.4 * clamp(84px, 15vh, 180px))', y: 'calc(-0.7 * clamp(84px, 15vh, 180px))', seamless: true },
        },
        { src: fence, at: 'left', h: '22', inset: '6vw', hide: '10%', wide: true, mirror: true },
        { src: house, at: 'left', h: '80', hide: '55%', hidePhone: '74%', mirror: true },
        { src: stall, at: 'right', h: '58', hide: '45%', hidePhone: '66%' },
      ]}
    >
      <header class="stage-head">
        <p class="eyebrow">{t.eyebrows.cast}</p>
        <h2 id="cast-title" class="stage-title" data-reveal>{t.cast.title}</h2>
        <p class="stage-lead" data-reveal style="--i: 1">{t.cast.ensemble.text}</p>
      </header>
      <ul class="roles">
        {
          roles.map((r, i) => (
            <li class="plaque role" data-reveal style={`--i: ${i}`}>
              <span class="puppet role__figure" style={`--delay: -${i}s; --sway: 7s`}>
                <Picture src={r.img} alt="" formats={formats} widths={[160, 320]} sizes="8rem" loading="lazy" />
              </span>
              <div>
                <h3>{t.cast.roles[r.id].name}</h3>
                <p class="role__side">{r.side}</p>
                <p>{t.cast.roles[r.id].text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <ul class="ensemble" aria-label={t.cast.ensemble.title}>
        {
          people.map((p, i) =>
            p.img ? (
              <li>
                <span class="puppet" style={`--delay: -${i * 0.7}s; --sway: 8s`}>
                  <Picture src={p.img} alt="" formats={formats} widths={[120, 240]} sizes="6rem" loading="lazy" />
                </span>
                <span class="ensemble__name">{p.name}</span>
              </li>
            ) : null,
          )
        }
      </ul>
    </Scene>

    <!-- The forest edge: the wolf trail. -->
    <Scene
      id="wolfsspur"
      set={hunt}
      labelledby="trail-title"
      moon={{ kind: 'full', x: '70%', y: '3%', size: 'clamp(64px, 11vmin, 130px)' }}
      pieces={[
        { src: pinebranch, at: 'top-right', h: '40', hide: '18%', mirror: true },
        { src: birch, at: 'right', h: '56', inset: '8vw', hide: '10%', wide: true, mirror: true },
        { src: owl, at: 'left', h: '82', hide: '52%', hidePhone: '72%', mirror: true },
        { src: pines, at: 'right', h: '84', hide: '52%', hidePhone: '72%', mirror: true },
      ]}
    >
      <div class="split">
        <div>
          <p class="eyebrow">{t.eyebrows.trail}</p>
          <h2 id="trail-title" class="stage-title" data-reveal>{t.trail.title}</h2>
          <p class="stage-lead split__lead" data-reveal style="--i: 1">{t.trail.intro}</p>
          <ul class="plaques">
            {
              t.trail.today.map((p, i) => (
                <li class="plaque" data-reveal style={`--i: ${i}`}>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </li>
              ))
            }
            <li class="plaque plaque--lit" data-reveal style="--i: 2">
              <p class="badge">{t.trail.later}</p>
              <h3>{t.trail.laterTitle}</h3>
              <p>{t.trail.laterText}</p>
              <a class="text-link" href={`${path('docsPlay', lang)}#${t.guide.trailAnchor}`}>{t.trail.more}</a>
            </li>
          </ul>
        </div>
        <figure class="plaque split__figure" data-reveal style="--i: 1">
          <TrailDiagram lang={lang} />
          <figcaption>{t.trail.rule}</figcaption>
        </figure>
      </div>
    </Scene>

    <!-- Backstage: house rules, status, built in the open. -->
    <Scene id="hausordnung" set={backstage} labelledby="rules-title">
      <header class="stage-head">
        <p class="eyebrow">{t.eyebrows.rules}</p>
        <h2 id="rules-title" class="stage-title" data-reveal>{t.rules.title}</h2>
      </header>
      <ul class="plaques plaques--three">
        {
          t.rules.items.map((r, i) => (
            <li class="plaque" data-reveal style={`--i: ${i}`}>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
      <div id="stand" class="progress">
        <header class="stage-head">
          <h2 class="stage-title stage-title--small" data-reveal>{t.progress.title}</h2>
          <p class="stage-lead" data-reveal style="--i: 1">{t.progress.intro}</p>
        </header>
        <ol class="steps">
          {
            t.progress.steps.map((s, i) => (
              <li class:list={['plaque', { 'plaque--lit': s.state === 'now' }]} data-reveal style={`--i: ${i}`}>
                <p class="badge">{s.state === 'done' ? t.progress.done : s.state === 'now' ? t.progress.now : t.progress.next}</p>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="actions">
          <a class="btn btn--plaque" href="/docs/dev/roadmap/">{t.progress.roadmap}</a>
          <a class="btn btn--plaque" href={repoUrl}>{t.open.github}</a>
        </div>
      </div>
      <div class="open">
        <header class="stage-head">
          <h2 id="open-title" class="stage-title stage-title--small" data-reveal>{t.open.title}</h2>
          <p class="stage-lead" data-reveal style="--i: 1">{t.open.intro}</p>
        </header>
        <ol class="plaques plaques--two">
          {
            featuredDocs.map((entry, i) => (
              <li class="plaque doc" data-reveal style={`--i: ${i}`}>
                <a href={devHref(entry.id)}>
                  <h3>{docTitle(entry)}</h3>
                  <p>{docSummary(entry)}</p>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="open__contribute">
          {t.open.contribute}{' '}
          <a href={`${repoUrl}/blob/main/CONTRIBUTING.md`}>{t.open.github}</a> ·{' '}
          <a href={`${repoUrl}/issues/new/choose`}>{t.open.bug}</a>
          {lang === 'en' && <span> {t.open.note}</span>}
        </p>
      </div>
    </Scene>

    <!-- The finale: the curtain call and the ticket. -->
    <Scene
      id="ticket"
      set={finale}
      tint="rgb(120 104 150)"
      labelledby="ticket-title"
      moon={{ kind: 'sun', x: '46%', y: '3%', size: 'clamp(64px, 11vmin, 130px)' }}
      pieces={[
        {
          src: garland,
          at: 'top',
          h: 'clamp(84px, 15vh, 180px)',
          hide: '-28%',
          repeat: 5,
          // The ropes of two lengths meet in an iron ring on a chain from above.
          joint: { src: garlandHook, h: 'calc(1.4 * clamp(84px, 15vh, 180px))', y: 'calc(-0.7 * clamp(84px, 15vh, 180px))', seamless: true },
        },
        { src: lamppost, at: 'left', h: '52', hide: '30%', hidePhone: '60%' },
        { src: stall, at: 'right', h: '56', hide: '45%', hidePhone: '66%' },
      ]}
    >
      <div class="finale">
        <p class="eyebrow">{t.eyebrows.finale}</p>
        <h2 id="ticket-title" class="stage-title" data-reveal>{latest ? t.ticket.released : t.ticket.title}</h2>
        <p class="stage-lead" data-reveal style="--i: 1">{latest ? t.ticket.releasedText : t.ticket.text}</p>
        <div class="actions" data-reveal style="--i: 2">
          <a class="btn btn--lantern" href={download}>
            {latest ? t.ticket.ctaReleased : t.hero.primary}
            <Icon name="arrow" />
          </a>
          <a class="btn btn--plaque" href={path('download', lang)}>{t.ticket.cta}</a>
        </div>
        <div class="bow" aria-hidden="true">
          {
            [seherin, schmied, werwolf, baeckerin, jaeger].map((img, i) => (
              <span class="puppet" style={`--delay: -${i * 1.3}s`}>
                <Picture src={img} alt="" formats={formats} widths={[160, 320]} sizes="9rem" loading="lazy" />
              </span>
            ))
          }
        </div>
      </div>
    </Scene>
  </main>
</Base>


<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
  }
  .hero__copy {
    position: relative;
  }
  /* A soft dark glow behind the words, so they read calm over the village. */
  .hero__copy::before {
    content: '';
    position: absolute;
    inset: -12% -10% -14% -14%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(6 11 20 / 0.62), rgb(6 11 20 / 0));
    pointer-events: none;
  }
  .hero__title {
    margin: 0;
    max-width: 34rem;
  }
  .hero__title :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.55));
  }
  .hero__statement {
    margin: 0.4rem 0 0;
    font-family: 'Ancizar Serif', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    line-height: 1.12;
    color: var(--stage-ivory);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.8);
  }
  .hero__sub {
    margin-left: 0;
  }
  .hero__actions,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  .actions {
    justify-content: center;
  }
  .hero__stage {
    position: relative;
    height: clamp(360px, 62vh, 620px);
  }
  .phone {
    position: absolute;
    border-radius: 2.1rem;
    padding: 0.55rem;
    background: linear-gradient(160deg, #2b2f3d, #12141c);
    border: 2px solid var(--stage-brass);
    box-shadow: 0 0 0 5px rgb(233 214 172 / 0.9), 0 22px 40px rgb(0 0 0 / 0.55);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.6rem;
  }
  .phone--front {
    width: clamp(160px, 15vw, 230px);
    left: 30%;
    top: 2%;
    transform: rotate(4deg);
  }
  .phone--back {
    width: clamp(140px, 13vw, 200px);
    left: 2%;
    top: 12%;
    transform: rotate(-7deg);
    filter: brightness(0.82);
  }
  /* On wide windows the cast stands on the stage boards, below the words. */
  @media (min-width: 900px) {
    .hero__stage {
      transform: translateY(13vh);
    }
  }
  .hero__wolf {
    position: absolute;
    height: 58%;
    right: 2%;
    bottom: 0;
  }
  .hero__maid {
    position: absolute;
    height: 42%;
    left: 18%;
    bottom: -2%;
  }

  /* ---------- Plaques ---------- */
  .plaques {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plaques--three {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .plaques--two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .badge {
    display: inline-block;
    margin: 0 0 0.4rem !important;
    padding: 0.05rem 0.6rem;
    border: 1.5px solid var(--stage-lantern-top);
    border-radius: 6px;
    font-family: 'Ancizar Serif', Georgia, serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--stage-lantern-top);
    transform: rotate(-2deg);
  }
  .stage-title--small {
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.6rem);
  }
  .text-link {
    display: inline-block;
    margin-top: 0.6rem;

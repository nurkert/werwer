---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

import CastSection from '../CastSection.astro';
import CountingSheep from '../CountingSheep.astro';
import StoryHero from '../StoryHero.astro';
import Icon from '../Icon.astro';
import TrailDiagram from '../TrailDiagram.astro';
import Base from '../../layouts/Base.astro';
import { path, repoUrl, ui, type Lang } from '../../i18n/ui';
import { devHref, docSummary, docTitle } from '../../lib/docs';
import { loadReleases } from '../../lib/releases';

import werwolf from '../../../../design/source/figures/werwolf.png';
import seherin from '../../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../../design/source/figures/dorfbewohner.png';
import emblem from '../../../../design/source/brand/emblem.png';


interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const formats = ['avif', 'webp'] as const;


const releases = await loadReleases();
// Only a real release (not a 0.0.x pre-release) may announce that the game is out.
const latest = releases.find((release) => !release.prerelease);

const docs = await getCollection('docs');
const featuredDocs = ['vision', 'game_design', 'night_sounds', 'security_design']
  .map((id) => docs.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);
---

<Base lang={lang} page="home" overlay title={t.meta.title} description={t.meta.description}>
  <StoryHero lang={lang} />

  <main>
    <!-- The playbill: what this is, on paper. -->
    <section id="spiel" class="paper" aria-labelledby="spiel-title">
      <div class="container playbill">
        <div class="playbill__intro">
          <div>
            <div class="section-head section-head--tight">
              <h2 id="spiel-title" class="display" data-reveal>{t.playbill.title}</h2>
              <p class="lead" data-reveal style="--i: 1">{t.playbill.intro}</p>
            </div>
        <div class="rulebook">
          {
            t.playbill.pillars.map((p, i) => (
              <p data-reveal style={`--i: ${i}`}>
                <strong>{p.title}.</strong> {p.text}
              </p>
            ))
          }
        </div>
          </div>
          <figure class="playbill__cast" aria-hidden="true">
            <Picture class="pc pc--wolf" src={werwolf} alt="" formats={formats} widths={[300, 600]} sizes="18vw" />
            <Picture class="pc pc--seer" src={seherin} alt="" formats={formats} widths={[260, 520]} sizes="15vw" />
            <Picture class="pc pc--villager" src={dorfbewohner} alt="" formats={formats} widths={[240, 480]} sizes="13vw" />
          </figure>
        </div>

        <div class="programme">
          <div class="section-head section-head--tight">
            <h2 class="display" data-reveal>{t.evening.title}</h2>
            <p class="lead" data-reveal style="--i: 1">{t.evening.intro}</p>
          </div>
          <ol class="acts">
            {
              t.evening.acts.map((a, i) => (
                <li data-reveal style={`--i: ${i}`}>
                  <span class="acts__icon">
                    <Icon name={a.icon as 'qr'} />
                  </span>
                  <h3><span class="acts__act">{a.act}:</span> {a.title}</h3>
                  <p>{a.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- The live thing: what villagers do at night. -->
    <section id="schaefchen" class="night night--deep" aria-labelledby="sheep-title">
      <div class="container">
        <div class="section-head">
          <h2 id="sheep-title" class="display" data-reveal>{t.sheep.title}</h2>
          <p class="lead" data-reveal style="--i: 1">{t.sheep.intro}</p>
          <p class="sheep-rule" data-reveal style="--i: 2">{t.sheep.rule}</p>
        </div>
        <div data-reveal style="--i: 2">
          <CountingSheep lang={lang} />
        </div>
      </div>
    </section>

    <!-- The cast: roles, door signs and the ensemble. -->
    <CastSection lang={lang} />

    <!-- The wolf trail. -->
    <section id="wolfsspur" class="night night--deep" aria-labelledby="trail-title">
      <div class="container trail">
        <div class="trail__copy">
          <h2 id="trail-title" class="display" data-reveal>{t.trail.title}</h2>
          <p class="lead" data-reveal style="--i: 1">{t.trail.intro}</p>
          <dl class="trail__points">
            {
              t.trail.today.map((p, i) => (
                <div data-reveal style={`--i: ${i}`}>
                  <dt>{p.title}</dt>
                  <dd>{p.text}</dd>
                </div>
              ))
            }
          </dl>
          <div class="trail__later" data-reveal>
            <span class="stamp stamp--status">{t.trail.later}</span>
            <h3>{t.trail.laterTitle}</h3>
            <p>{t.trail.laterText}</p>
            <blockquote class="trail__rule">{t.trail.rule}</blockquote>
          </div>
          <a class="text-link" href={`${path('docsPlay', lang)}#${t.guide.trailAnchor}`}>{t.trail.more}</a>
        </div>
        <figure class="trail__diagram" data-reveal style="--i: 1">
          <figcaption><span class="stamp stamp--status">{t.trail.later}</span></figcaption>
          <TrailDiagram lang={lang} />
        </figure>
      </div>
    </section>

    <!-- House rules and honest status, on paper. -->
    <section class="paper" aria-labelledby="rules-title">
      <div class="container">
        <div class="section-head">
          <h2 id="rules-title" class="display" data-reveal>{t.rules.title}</h2>
        </div>
        <div class="booklet-page" data-reveal>
          <dl class="rules">
            {
              t.rules.items.map((r) => (
                <div>
                  <dt>{r.title}</dt>
                  <dd>{r.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div id="stand" class="progress">
          <div class="section-head section-head--tight">
            <h2 class="display" data-reveal>{t.progress.title}</h2>
            <p class="lead" data-reveal style="--i: 1">{t.progress.intro}</p>
          </div>
          <ol class="punch-sheet" data-reveal>
            {
              t.progress.steps.map((s) => (
                <li class:list={['punch', `punch--${s.state}`]}>
                  <span class="punch__token" aria-hidden="true"></span>
                  <h3>{s.title}</h3>
                  <p class="punch__state">{s.state === 'done' ? t.progress.done : s.state === 'now' ? t.progress.now : t.progress.next}</p>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
          <a class="button button--ghost" href="/docs/dev/roadmap/">{t.progress.roadmap}</a>
        </div>
      </div>
    </section>

    <!-- Built in the open. -->
    <section class="night" aria-labelledby="open-title">
      <div class="container open">
        <div>
          <h2 id="open-title" class="display" data-reveal>{t.open.title}</h2>
          <p class="lead" data-reveal style="--i: 1">{t.open.intro}</p>
          <div class="open__actions" data-reveal style="--i: 2">
            <a class="button button--primary" href={repoUrl}>{t.hero.primary}</a>
            <a class="button button--ghost" href="/docs/dev/">{t.open.docs}</a>
          </div>
          <p class="open__contribute" data-reveal style="--i: 3">
            {t.open.contribute}{' '}
            <a href={`${repoUrl}/blob/main/CONTRIBUTING.md`}>{t.open.github}</a> ·{' '}
            <a href={`${repoUrl}/issues/new/choose`}>{t.open.bug}</a>
          </p>
          {lang === 'en' && <p class="open__note">{t.open.note}</p>}
        </div>
        <ol class="toc">
          {
            featuredDocs.map((entry, i) => (
              <li data-reveal style={`--i: ${i}`}>
                <a href={devHref(entry.id)}>
                  <span class="toc__title">{docTitle(entry)}</span>
                  <span class="toc__summary">{docSummary(entry)}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- The ticket. -->
    <section class="night night--deep finale" aria-labelledby="ticket-title">
      <div class="container">
        <div class="ticket" data-reveal>
          <div class="ticket__main">
            <h2 id="ticket-title" class="display">{latest ? t.ticket.released : t.ticket.title}</h2>
            <p class="lead">{latest ? t.ticket.releasedText : t.ticket.text}</p>
            <div class="ticket__actions">
              <a class="button button--primary" href={latest ? path('download', lang) : repoUrl}>
                {latest ? t.ticket.ctaReleased : t.hero.primary}
              </a>
              <a class="button button--ghost" href={path('download', lang)}>{t.ticket.cta}</a>
            </div>
          </div>
          <div class="ticket__stub" aria-hidden="true">
            <Picture src={emblem} alt="" formats={formats} widths={[160, 320]} sizes="8rem" />
            <p>{t.ticket.admit}</p>
            <p>{t.ticket.seat}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ---------- Playbill ---------- */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillars :global(svg) {
    width: 3.2rem;
    height: 3.2rem;
    color: var(--curtain-600);
  }
  .pillars h3 {
    margin-top: var(--space-2);
  }
  .pillars p {
    margin-top: var(--space-1);
    max-width: 34ch;
  }

  .programme {
    margin-top: var(--space-5);
  }
  .section-head--tight {
    margin-bottom: var(--space-4);
  }
  .acts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .acts li {
    position: relative;
  }
  .acts__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }
  .acts__icon :global(svg) {
    width: 1.8rem;
    height: 1.8rem;
  }
  .acts__act {
    color: var(--curtain-600);
  }
  .acts h3 {
    margin-top: var(--space-2);
    font-size: 1.55rem;
  }
  .acts p:last-child {
    margin-top: 0.4rem;
  }

  /* ---------- Sheep ---------- */
  .sheep-rule {
    font-weight: 800;
    color: var(--lantern-300);
  }


  /* ---------- Wolf trail ---------- */
  .trail {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
  }
  .trail__copy {
    display: grid;
    gap: var(--space-2);
  }
  .trail__rule {
    margin: var(--space-3) 0 var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-m);
    color: var(--ink);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
    font-family: var(--font-display);
    font-size: var(--step-lead);
    line-height: 1.35;
    transform: rotate(-0.8deg);
  }
  .trail__points {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0;
  }
  .trail__points dt {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--lantern-300);
  }
  .trail__points dd {
    margin: 0.2rem 0 0;
    max-width: 50ch;
    color: var(--moon-200);
  }
  .trail__diagram {
    position: relative;
    margin: 0;
  }
  .trail__diagram figcaption {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-1);
  }
  /* what is planned sits apart from what is in the game today */
  .trail__later {
    display: grid;
    gap: var(--space-1);
    justify-items: start;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 2px dashed rgb(201 151 63 / 0.4);
  }
  .trail__later h3 {
    font-size: 1.45rem;
    color: var(--moon-100);
  }
  .trail__later p {
    max-width: 50ch;
    color: var(--moon-200);
  }
  .trail__later .trail__rule {
    margin-top: var(--space-2);
  }
  .trail__diagram :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .text-link {
    justify-self: start;
    padding-block: 0.6rem;
    font-weight: 800;
  }

  /* ---------- House rules ---------- */
  .rules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
    margin: 0;
  }
  .rules dt {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--ink);
  }
  .rules dd {
    margin: 0.3rem 0 0;
    max-width: 36ch;
  }

  .progress {
    margin-top: var(--space-6);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: var(--space-3);
    border-radius: var(--radius-m);
    background: rgb(42 27 18 / 0.07);
  }
  .step--now {
    background: rgb(158 31 36 / 0.12);
  }
  .step .stamp {
    justify-self: start;
  }
  .step h3 {
    margin-top: 0.4rem;
    font-size: 1.5rem;
  }
  :global(.stamp--plan) {
    color: var(--ink-soft);
  }

  /* ---------- Open ---------- */
  .open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }
  .open .lead {
    margin-top: var(--space-2);
    color: var(--moon-200);
  }
  .open__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .open__note {
    margin-top: var(--space-2);
    font-size: var(--step-small);
    color: var(--moon-200);
  }
  .doc-links {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-links a {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-3);
    border-radius: var(--radius-m);
    background: var(--night-800);
    color: var(--moon-100);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.35s var(--ease-puppet);
  }
  .doc-links a:hover {
    background: var(--night-700);
    transform: translateX(6px);
  }
  .doc-links strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
  }
  .doc-links span {
    color: var(--moon-200);
    font-size: var(--step-small);
  }

  /* ---------- Ticket ---------- */
  .ticket {
    --notch: 1.1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    color: var(--ink);
    background-color: var(--paper);
    background-image: var(--fibre), var(--grain);
    background-size: 600px, 220px;
    background-blend-mode: multiply, soft-light;
    border-radius: var(--radius-l);
    /* Two half-moon notches where the stub tears off. */
    mask:
      radial-gradient(circle at calc(100% - 15rem) 0, transparent var(--notch), #000 calc(var(--notch) + 0.5px)) top / 100% 51% no-repeat,
      radial-gradient(circle at calc(100% - 15rem) 100%, transparent var(--notch), #000 calc(var(--notch) + 0.5px)) bottom / 100% 51% no-repeat;
  }
  .ticket__main {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .ticket__main h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 4rem);
    color: var(--ink);
  }
  .ticket__main .lead {
    max-width: 40ch;
    color: var(--ink-soft);
  }
  .ticket__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .ticket .button--ghost {
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink-soft);
  }
  .ticket__stub {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    padding: var(--space-4) var(--space-3);
    border-left: 3px dashed rgb(42 27 18 / 0.35);
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
  }
  .ticket__stub :global(img) {
    width: 7rem;
    height: auto;
    margin-bottom: 0.4rem;
  }

  /* ---------- Phones and tablets ---------- */
  @media (max-width: 1080px) {
    .acts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .trail,
    .open {
      grid-template-columns: 1fr;
    }
    .trail__diagram {
      max-width: 34rem;
    }
  }

  @media (max-width: 760px) {
    /* the diagram shrinks to half size on phones: keep its words readable */
    .trail__diagram :global(svg text:last-of-type) {
      font-size: 22px;
    }
    .trail__diagram :global(svg text[y='44']) {
      font-size: 28px;
    }
    .pillars,
    .rules {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .acts {
      grid-template-columns: 1fr;
    }
    .acts li {
      display: grid;
      grid-template-columns: 4rem 1fr;
      column-gap: var(--space-3);
    }
    .acts__icon {
      grid-row: span 3;
    }

    .steps {
      grid-template-columns: 1fr;
    }
    .ticket {
      grid-template-columns: 1fr;
      mask: none;
    }
    .ticket__main {
      padding: var(--space-4) var(--space-3);
    }
    .ticket__stub {
      grid-auto-flow: column;
      align-items: center;
      gap: var(--space-2);
      border-left: 0;
      border-top: 3px dashed rgb(42 27 18 / 0.35);
      padding: var(--space-3);
      font-size: 1rem;
    }
    .ticket__stub :global(img) {
      width: 3.5rem;
      margin: 0;
    }
    .ticket__actions .button,
    .open__actions .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .playbill__cast :global(.pc) {
      animation: none;
    }
    .doc-links a:hover {
      transform: none;
    }
  }

  /* ---------- Box world below the fold ---------- */
  .rulebook {
    columns: 2 20rem;
    column-gap: var(--space-5);
    column-rule: 1px solid rgb(42 27 18 / 0.18);
    max-width: 62rem;
  }
  .rulebook p {
    break-inside: avoid;
    margin: 0 0 var(--space-3);
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .rulebook p:first-child::first-letter {
    float: left;
    margin: 0.05em 0.1em 0 0;
    font-family: var(--font-display);
    font-size: 3.6em;
    line-height: 0.8;
    color: var(--curtain-600);
  }
  .rulebook strong {
    font-family: var(--font-display);
    color: var(--ink);
  }

  .booklet-page {
    position: relative;
    padding: var(--space-5) var(--space-5) var(--space-4);
    border-radius: 0.6rem;
    background: #f7ecd2;
    box-shadow:
      inset 0 0 0 0.55rem #f7ecd2,
      inset 0 0 0 0.65rem #b98a43,
      inset 0 0 0 0.85rem #f7ecd2,
      inset 0 0 0 0.92rem #b98a43,
      0 1rem 2rem rgb(42 27 18 / 0.25);
    transform: rotate(-0.4deg);
  }
  .booklet-page .rules {
    margin: 0;
  }

  .punch-sheet {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: var(--space-4);
    list-style: none;
    border-radius: 0.8rem;
    background: #d9bd8c;
    box-shadow: inset 0 0 0 1px rgb(42 27 18 / 0.25), 0 1rem 2rem rgb(42 27 18 / 0.25);
  }
  .punch {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.35rem;
    text-align: center;
  }
  .punch__token {
    width: 5.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #2a3b6b, #141d30);
    box-shadow: 0 0 0 0.35rem #e9d6ac, 0 0 0 0.45rem rgb(42 27 18 / 0.35), 0 0.4rem 0.6rem rgb(0 0 0 / 0.3);
  }
  .punch--done .punch__token {
    /* punched out: only the hole remains, the felt shows through */
    background: #0d140f;
    box-shadow: inset 0 0.4rem 0.6rem rgb(0 0 0 / 0.6), 0 0 0 0.35rem #c9a46c;
  }
  .punch--now .punch__token {
    background: radial-gradient(circle at 50% 40%, #c13b2f, #7f171c);
    transform: translateY(-0.3rem) rotate(-6deg);
  }
  .punch h3 {
    margin-top: var(--space-1);
    font-size: 1.35rem;
    color: var(--ink);
  }
  .punch__state {
    font-weight: 800;
    color: var(--curtain-600) !important;
  }

  .toc {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc a {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-2) 0;
    color: var(--moon-100);
    text-decoration: none;
  }
  .toc li + li a {
    border-top: 1px dotted rgb(246 232 198 / 0.3);
  }
  .toc__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
  }
  .toc a:hover .toc__title {
    color: var(--lantern-300);
  }
  .toc__summary {
    color: var(--moon-200);
    font-size: var(--step-small);

---
// The "Mondbühne" hero: flat cutouts on stacked depth layers (2.5D).
// Each layer moves by its --depth on pointer and scroll; puppets bob on their sticks.
import { Picture } from 'astro:assets';

import prospekt from '../../../design/source/stage/prospekt.png';
import rahmen from '../../../design/source/stage/rahmen.png';
import haeuser from '../../../design/source/props/haeuser.png';
import kirchturm from '../../../design/source/props/kirchturm.png';
import tanne1 from '../../../design/source/props/tanne_1.png';
import tanne2 from '../../../design/source/props/tanne_2.png';
import busch from '../../../design/source/props/busch.png';
import steine from '../../../design/source/props/steine.png';
import zaun from '../../../design/source/props/zaun.png';
import fass from '../../../design/source/props/fass.png';
import kiste from '../../../design/source/props/kiste.png';
import laterne from '../../../design/source/props/laterne.png';
import werwolf from '../../../design/source/figures/werwolf.png';
import seherin from '../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../design/source/figures/dorfbewohner.png';
import magd from '../../../design/source/figures/magd.png';

// x/bottom/width in % of the stage; depth drives parallax (0 = far, 1 = near).
const scenery = [
  { src: kirchturm, x: 30, bottom: 30, w: 7.5, depth: 0.25 },
  { src: haeuser, x: 40, bottom: 30, w: 27, depth: 0.25 },
  { src: tanne1, x: 14.5, bottom: 26, w: 8.5, depth: 0.4 },
  { src: tanne2, x: 77, bottom: 27, w: 7.5, depth: 0.4 },
  { src: steine, x: 25, bottom: 13, w: 12, depth: 0.6 },
  { src: zaun, x: 61, bottom: 12.5, w: 11, depth: 0.6 },
  { src: busch, x: 74.5, bottom: 13, w: 10.5, depth: 0.6 },
];

const puppets = [
  { src: werwolf, alt: 'Der Werwolf, grinsend', x: 13.5, w: 17.5, delay: 0 },
  { src: seherin, alt: 'Die Seherin mit Laterne', x: 34, w: 13.5, delay: 0.15 },
  { src: dorfbewohner, alt: 'Ein Dorfbewohner mit Mistgabel', x: 52, w: 12.5, delay: 0.3 },
  { src: magd, alt: 'Eine Dorfbewohnerin mit Eimer', x: 67, w: 10.5, delay: 0.45 },
];

const foreground = [
  { src: fass, x: 6.5, bottom: 8, w: 7, depth: 1.2 },
  { src: kiste, x: 80, bottom: 7, w: 7, depth: 1.2 },
  { src: laterne, x: 87, bottom: 8, w: 5.5, depth: 1.2 },
];

const widths = [240, 480, 800, 1200];
const formats = ['avif', 'webp'] as const;
---

<div class="stage" data-stage>
  <div class="layer backdrop" style="--depth: 0.08">
    <Picture
      src={prospekt}
      alt=""
      formats={formats}
      widths={[960, 1672]}
      sizes="(max-width: 700px) 170vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  {
    scenery.map((s) => (
      <div class="layer" style={`--depth: ${s.depth}`}>
        <Picture
          class="cutout"
          src={s.src}
          alt=""
          formats={formats}
          widths={widths}
          sizes={`${Math.ceil(s.w * 1.7)}vw`}
          style={`left: ${s.x}%; bottom: ${s.bottom}%; width: ${s.w}%`}
        />
      </div>
    ))
  }

  <div class="layer" style="--depth: 0.85">
    {
      puppets.map((p) => (
        <div class="puppet" style={`left: ${p.x}%; width: ${p.w}%; --delay: ${p.delay}s`}>
          <Picture
            src={p.src}
            alt={p.alt}
            formats={formats}
            widths={widths}
            sizes={`${Math.ceil(p.w * 1.7)}vw`}
            loading="eager"
          />
        </div>
      ))
    }
  </div>

  <div class="layer" style="--depth: 1.2">
    {
      foreground.map((f) => (
        <Picture
          class="cutout"
          src={f.src}
          alt=""
          formats={formats}
          widths={widths}
          sizes={`${Math.ceil(f.w * 1.7)}vw`}
          style={`left: ${f.x}%; bottom: ${f.bottom}%; width: ${f.w}%`}
        />
      ))
    }
  </div>

  <div class="light" aria-hidden="true"></div>

  <div class="layer frame" style="--depth: 0">
    <Picture src={rahmen} alt="" formats={formats} widths={[960, 1672]} sizes="(max-width: 700px) 170vw, 100vw" loading="eager" />
  </div>

  <slot />
</div>

<script>
  // Pointer + scroll parallax. Writes custom properties; CSS does the rest.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (stage && !calm.matches) {
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const tick = () => {
      current.x += (target.x - current.x) * 0.08;
      current.y += (target.y - current.y) * 0.08;
      stage.style.setProperty('--px', current.x.toFixed(4));
      stage.style.setProperty('--py', current.y.toFixed(4));
      const settled = Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(tick);
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        target.x = event.clientX / window.innerWidth - 0.5;
        target.y = event.clientY / window.innerHeight - 0.5;
        if (!frame) frame = requestAnimationFrame(tick);
      },
      { passive: true },
    );

    const onScroll = () => {
      const progress = Math.min(window.scrollY / window.innerHeight, 1);
      stage.style.setProperty('--scroll', progress.toFixed(4));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  stage?.classList.add('is-lit');
</script>

<style>
  .stage {
    --px: 0;
    --py: 0;
    --scroll: 0;
    position: relative;
    width: 100%;
    aspect-ratio: 1672 / 941;
    overflow: hidden;
    isolation: isolate;
    background: var(--night-900);
  }

  .layer {
    position: absolute;
    inset: 0;
    transform: translate3d(
      calc(var(--px) * var(--depth) * -2.2%),
      calc(var(--py) * var(--depth) * -1.4% + var(--scroll) * var(--depth) * 6%),
      0
    );
    will-change: transform;
  }

  .backdrop {
    inset: -3%;
  }
  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The painted frame ends a hair above the stage edge; close the seam. */
  .frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1.2%;
    background: #3b2414;
  }

  .stage :global(.cutout) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 0.4vw 0.6vw rgb(5 8 20 / 0.45));
  }

  /* Puppets rise from behind the stage edge, then bob on their sticks. */
  .puppet {
    position: absolute;
    bottom: -9%;
    transform-origin: 50% 100%;
    transform: translateY(70%);
    opacity: 0;
    filter: drop-shadow(0 0.5vw 0.8vw rgb(5 8 20 / 0.5));
  }
  .puppet :global(img) {
    width: 100%;
    height: auto;
  }
  .is-lit .puppet {
    animation:
      rise 1.1s var(--ease-puppet) calc(0.5s + var(--delay)) forwards,
      bob 5.2s ease-in-out calc(1.7s + var(--delay) * 3) infinite;
  }

  @keyframes rise {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
    35% {
      transform: translateY(-1%) rotate(-1.2deg);
      opacity: 1;
    }
    70% {
      transform: translateY(0.3%) rotate(0.8deg);
      opacity: 1;
    }
  }

  /* Stage lighting: one slow wandering spot plus a soft vignette. */
  .light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 22% 55% at var(--spot, 40%) 64%, rgb(255 214 150 / 0.2), transparent 70%),
      radial-gradient(ellipse at 50% 40%, transparent 45%, rgb(8 10 24 / 0.55) 100%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out) 0.2s;
  }
  .is-lit .light {
    opacity: 1;
    animation: spot 16s ease-in-out 2.5s infinite;
  }

  @property --spot {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 40%;
  }
  @keyframes spot {
    0%,
    100% {
      --spot: 40%;
    }
    25% {
      --spot: 22%;
    }
    50% {
      --spot: 58%;
    }
    75% {
      --spot: 72%;
    }
  }

  /* Phones: show the centre of the stage larger instead of a tiny letterbox. */
  @media (max-width: 700px) {
    .stage {
      width: 170%;
      margin-left: -35%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer {
      transform: none;
    }
    .puppet,
    .is-lit .puppet {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .is-lit .light {
      animation: none;
    }
  }
</style>

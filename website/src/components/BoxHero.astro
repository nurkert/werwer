---
// First viewport "Die Spielschachtel": the game box on a games-table felt.
// The box is a real CSS 3D object (six textured faces); scrolling lifts and turns it.
// Desktop keeps the measured comp frame (1536 × 1024); narrow screens restack it.
import { getImage, Picture } from 'astro:assets';

import { alternates, languages, path, repoUrl, ui, type Lang } from '../i18n/ui';
import lid from '../assets/box/lid.jpg';
import band from '../assets/box/band.jpg';
import bandFront from '../assets/box/band-front.jpg';
import bandSide from '../assets/box/band-side.jpg';
import tray from '../assets/box/tray.jpg';
import felt from '../assets/plates/felt.png';
import wordmark from '../assets/plates/nav-wordmark.png';
import lantern from '../assets/plates/lantern.png';
import decorTopRight from '../assets/plates/decor-top-right.png';
import decorLeft from '../assets/plates/decor-left.png';
import tableCluster from '../assets/plates/table-cluster.png';
import seer from '../../../design/source/figures/seherin.png';
import villager from '../../../design/source/figures/dorfbewohner.png';
import maid from '../../../design/source/figures/magd.png';
import witch from '../../../design/source/figures/hexe.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const home = path('home', lang);
const others = alternates('home').filter((v) => v.lang !== lang);

const feltTile = (await getImage({ src: felt, width: 1024, format: 'webp' })).src;
const lidTexture = (await getImage({ src: lid, width: 1600, format: 'webp' })).src;
const bandTexture = (await getImage({ src: band, width: 1600, format: 'webp' })).src;
const bandFrontTexture = (await getImage({ src: bandFront, width: 1600, format: 'webp' })).src;
const bandSideTexture = (await getImage({ src: bandSide, height: 1600, format: 'webp' })).src;
const trayTexture = (await getImage({ src: tray, width: 1600, format: 'webp' })).src;
const u = t.unbox;
const formats = ['avif', 'webp'] as const;
const votePortraits = [villager, maid, witch, seer];

const nav = [
  { href: `${home}#spiel`, label: t.nav.play },
  { href: `${home}#rollen`, label: t.nav.cast },
  { href: `${home}#wolfsspur`, label: t.nav.trail },
  { href: '/docs/', label: t.nav.docs },
  { href: path('download', lang), label: t.nav.download },
];

// Table props at their measured boxes (% of the comp frame).
const props = [
  { src: lantern, cls: 'p-lantern', w: 240 },
  { src: decorTopRight, cls: 'p-decor-tr', w: 240 },
  { src: decorLeft, cls: 'p-decor-left', w: 240 },
  { src: tableCluster, cls: 'p-cluster', w: 640 },
];
---

<section
  class="box-hero"
  aria-labelledby="box-title"
  data-box-hero
  style={`--felt: url(${feltTile}); --lid: url(${lidTexture}); --band: url(${bandTexture}); --band-front: url(${bandFrontTexture}); --band-side: url(${bandSideTexture}); --tray: url(${trayTexture});`}
>
  <div class="stage">
  <div class="frame">
    {
      props.map((p) => (
        <Picture class:list={['prop', p.cls]} src={p.src} alt="" formats={formats} widths={[p.w, p.w * 2]} sizes={`${p.w}px`} loading="eager" />
      ))
    }

    <!-- The game box: a real 3D object. Scrolling lifts the lid off and a phone rises out of the tray. -->
    <div class="box-scene" aria-hidden="true">
      <div class="box-shadow"></div>
      <div class="box">
        <div class="face tray-floor"><span class="slot-cover"></span></div>
        <div class="face side south"><span>{t.box.flap}</span></div>
        <div class="face side north"></div>
        <div class="face side east"></div>
        <div class="face side west"></div>
        <div class="face bottom"></div>
        <div class="lid-group">
          <div class="face lid"></div>
          <div class="face rim rim-s"></div>
          <div class="face rim rim-n"></div>
          <div class="face rim rim-e"></div>
          <div class="face rim rim-w"></div>
        </div>
        <div class="phone">
          <div class="phone__body">
            <div class="phone__screen">
              <div class="screen screen--role">
                <p class="screen__kicker">{u.youAre}</p>
                <p class="screen__title">{u.role}</p>
                <Picture class="screen__portrait" src={seer} alt="" formats={formats} widths={[200, 400]} sizes="12vw" />
                <p class="screen__hint">{u.roleHint}</p>
                <span class="screen__btn">{u.next}</span>
              </div>
              <div class="screen screen--night">
                <span class="screen__moon"></span>
                <p class="screen__title">{u.night}</p>
                <p class="screen__hint">{u.nightHint}</p>
              </div>
              <div class="screen screen--vote">
                <p class="screen__title">{u.vote}</p>
                <div class="screen__grid">
                  {votePortraits.map((src) => <Picture src={src} alt="" formats={formats} widths={[96, 192]} sizes="5vw" />)}
                </div>
                <span class="screen__btn">{u.voteButton}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="visually-hidden">{t.box.boxAlt}</p>

    <nav class="hero-nav" aria-label={t.nav.menu}>
      <a class="hero-brand" href={home} aria-label="Whowolf">
        <Picture src={wordmark} alt="" formats={formats} widths={[220, 440]} sizes="220px" loading="eager" />
      </a>
      <ul class="hero-links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <p class="hero-lang">
        <span aria-current="true">{lang.toUpperCase()}</span>
        {
          others.map((v) => (
            <>
              <span aria-hidden="true">/</span>
              <a href={v.href} hreflang={v.lang} lang={v.lang} aria-label={languages[v.lang].label}>
                {v.lang.toUpperCase()}
              </a>
            </>
          ))
        }
      </p>
    </nav>

    <div class="hero-copy">
      <h1 id="box-title" class="hero-headline">
        <span class="visually-hidden">Whowolf – </span>{t.box.headline.split('. ').map((part, i, all) => <span class="line">{i < all.length - 1 ? `${part}.` : part}</span>)}
      </h1>
      <p class="hero-lede">{t.box.lede.map((line) => <span>{line}</span>)}</p>
      <ol class="captions" aria-live="polite">
        {
          u.captions.map((c, i) => (
            <li class="caption" data-caption={i + 1}>
              <strong>{c.title}</strong> {c.text}
            </li>
          ))
        }
      </ol>
      <div class="hero-actions">
        <a class="hero-cta" href={repoUrl}>
          {t.box.cta}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
        </a>
        <span class="hero-stamp">{t.box.stamp}</span>
      </div>
    </div>

    <p class="scroll-hint" aria-hidden="true"><span></span>{u.scroll}</p>
    <p class="hero-foot">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5Zm0 0v13" /></svg>
      {t.box.footer}
    </p>
  </div>
  </div>
</section>

<script>
  // Pinned unboxing: the stage sticks while the section scrolls by. Progress drives
  // the lid (lifts and flies off), the phone (rises and faces you) and the story beats.
  const hero = document.querySelector<HTMLElement>('[data-box-hero]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
  const ease = (v: number) => v * v * (3 - 2 * v);

  const apply = (p: number) => {
    if (!hero) return;
    const lid = ease(clamp((p - 0.05) / 0.32));
    const phone = ease(clamp((p - 0.4) / 0.3));
    const stage = p < 0.05 ? 0 : p < 0.4 ? 1 : p < 0.72 ? 2 : p < 0.86 ? 3 : 4;
    hero.style.setProperty('--lid-p', lid.toFixed(4));
    hero.style.setProperty('--phone-p', phone.toFixed(4));
    hero.dataset.stage = String(stage);
    hero.dataset.screen = stage <= 2 ? 'role' : stage === 3 ? 'night' : 'vote';
  };

  if (hero && calm.matches) {
    hero.classList.add('is-static');
    apply(0.7);
  } else if (hero) {
    let queued = false;
    const update = () => {
      queued = false;
      const rect = hero.getBoundingClientRect();
      const range = Math.max(rect.height - window.innerHeight, 1);
      apply(clamp(-rect.top / range));
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  .box-hero {
    --lid-p: 0;
    --phone-p: 0;
    height: 400vh;
    --felt-color: #0d140f;
    --cream: #f6e8c6;
    --amber: #f5aa42;
    --stamp: #dc382e;
    position: relative;
    overflow: clip;
    background: var(--felt-color) var(--felt) repeat;
    background-size: 640px;
    color: var(--cream);
    font-family: 'Ancizar Serif', Georgia, serif;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .is-static {
    height: auto;
  }
  .is-static .stage {
    position: relative;
    height: auto;
  }

  /* The measured comp frame; every box below is a share of it (cqw = 1/100 of its width). */
  .frame {
    position: relative;
    width: min(100%, 120rem, 150vh);
    margin-inline: auto;
    aspect-ratio: 1536 / 1024;
    container-type: inline-size;
  }

  .frame :global(picture) {
    display: contents;
  }
  .frame :global(.prop) {
    position: absolute;
    display: block;
    object-fit: cover;
  }
  .frame :global(.p-lantern) {
    left: 0;
    top: 0;
    width: 10%;
    height: 20%;
    mask-image: linear-gradient(180deg, #000 70%, transparent);
  }
  .frame :global(.p-decor-tr) {
    mask-image: radial-gradient(ellipse at 70% 30%, #000 45%, transparent 75%);
    object-fit: contain;
    padding: 0.4cqw 0 0 1cqw;
    left: 90%;
    top: 0;
    width: 10%;
    height: 20%;
  }
  .frame :global(.p-decor-left) {
    left: 0;
    top: 20%;
    width: 10%;
    height: 80%;
  }
  .frame :global(.p-cluster) {
    left: 65.5%;
    top: 46%;
    width: 34.5%;
    height: 54%;
    object-fit: cover;
    object-position: 0 0;
    mask-image: linear-gradient(180deg, #000 82%, transparent);
  }

  /* ---------- 3D box ---------- */
  .box-scene {
    --w: 55.5cqw;
    --d: calc(var(--w) / 1.04);
    --h: calc(var(--w) * 0.1);
    position: absolute;
    left: 6.4cqw;
    top: 7.4cqw;
    width: var(--w);
    height: var(--d);
    perspective: 75cqw;
    perspective-origin: 46% 210%;
  }
  .box-shadow {
    position: absolute;
    inset: 6% 6% -2% 4%;
    border-radius: 3%;
    background: rgb(0 0 0 / 0.55);
    filter: blur(2.4cqw);

  }
  .box {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(7deg) rotateY(-3deg) rotateZ(-3.8deg);
    will-change: transform;
  }
  .face {
    position: absolute;
    left: 50%;
    top: 50%;
    backface-visibility: hidden;
  }
  .lid {
    width: var(--w);
    height: var(--d);
    margin: calc(var(--d) / -2) 0 0 calc(var(--w) / -2);
    background: var(--lid) center / 100% 100%;
    border-radius: 0.3cqw;
    transform: translateZ(1px);
    box-shadow: inset 0 0 0 0.15cqw rgb(255 235 190 / 0.18);
  }
  .side {
    background: #c9a46c var(--band) center / 100% 100%;
  }
  .south,
  .north {
    width: var(--w);
    height: var(--h);
    margin: calc(var(--h) / -2) 0 0 calc(var(--w) / -2);
  }
  .south {
    background-image: var(--band-front);
    filter: brightness(0.62);
    transform: rotateX(-90deg) translateZ(calc(var(--d) / 2));
    display: flex;
    align-items: center;
    padding-left: 12%;
  }
  .south span {
    position: relative;
    z-index: 1;
    color: #2a1b12;
    font-size: 1.8cqw;
    font-weight: 700;
    letter-spacing: 0.02em;
    transform: rotate(-0.3deg);
    text-shadow: 0 0.05cqw 0 rgb(255 240 210 / 0.35);
  }
  .north {
    transform: rotateX(90deg) translateZ(calc(var(--d) / 2));
  }
  .east,
  .west {
    width: var(--h);
    height: var(--d);
    margin: calc(var(--d) / -2) 0 0 calc(var(--h) / -2);
    background: #c9a46c var(--band-side) center / 100% 100%;
  }
  .east {
    transform: rotateY(90deg) translateZ(calc(var(--w) / 2));
    filter: brightness(0.5) saturate(0.9);
  }
  .west {
    transform: rotateY(-90deg) translateZ(calc(var(--w) / 2));
    filter: brightness(0.6);
  }
  .bottom {
    width: var(--w);
    height: var(--d);
    margin: calc(var(--d) / -2) 0 0 calc(var(--w) / -2);
    background: #6b4a2a;
    transform: rotateY(180deg) translateZ(calc(var(--h) / 2));
  }


  /* ---------- Unboxing ---------- */
  .tray-floor {
    width: var(--w);
    height: var(--d);
    margin: calc(var(--d) / -2) 0 0 calc(var(--w) / -2);
    background: #6b4a2a var(--tray) center / 100% 100%;
    transform: translateZ(calc(var(--h) / -2 + 2px));
    box-shadow: inset 0 0 2.4cqw rgb(0 0 0 / 0.55);
  }
  .slot-cover {
    position: absolute;
    left: 32.9%;
    top: 46.8%;
    width: 18.6%;
    height: 47.6%;
    border-radius: 1cqw;
    background: #2a1b12;
    box-shadow: inset 0 0.6cqw 1.2cqw rgb(0 0 0 / 0.7);
    opacity: calc(var(--phone-p) * 1.4);
  }
  .lid-group {
    --rh: calc(var(--h) * 0.6);
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform:
      translateZ(calc(var(--h) / 2))
      translate3d(calc(var(--lid-p) * -46cqw), calc(var(--lid-p) * -34cqw), calc(var(--lid-p) * 26cqw))
      rotateX(calc(var(--lid-p) * -48deg)) rotateY(calc(var(--lid-p) * 30deg)) rotateZ(calc(var(--lid-p) * -28deg));
    opacity: calc(1 - max(0, var(--lid-p) - 0.75) * 4);
    will-change: transform, opacity;
  }
  .rim {
    background: #c9a46c var(--band) center / 100% 100%;
    filter: brightness(0.85);
  }
  .rim-s,
  .rim-n {
    width: calc(var(--w) + 2px);
    height: var(--rh);
    margin: calc(var(--rh) / -2) 0 0 calc(var(--w) / -2 - 1px);
  }
  .rim-s {
    background-image: var(--band-front);
    transform: translateZ(calc(var(--rh) / -2)) rotateX(-90deg) translateZ(calc(var(--d) / 2 + 1px));
  }
  .rim-n {
    transform: translateZ(calc(var(--rh) / -2)) rotateX(90deg) translateZ(calc(var(--d) / 2 + 1px));
  }
  .rim-e,
  .rim-w {
    width: var(--rh);
    height: calc(var(--d) + 2px);
    margin: calc(var(--d) / -2 - 1px) 0 0 calc(var(--rh) / -2);
    background-image: var(--band-side);
  }
  .rim-e {
    transform: translateZ(calc(var(--rh) / -2)) rotateY(90deg) translateZ(calc(var(--w) / 2 + 1px));
    filter: brightness(0.6);
  }
  .rim-w {
    transform: translateZ(calc(var(--rh) / -2)) rotateY(-90deg) translateZ(calc(var(--w) / 2 + 1px));
    filter: brightness(0.5);
  }

  /* The phone lies in its slot, rises, straightens to face you and grows. */
  .phone {
    position: absolute;
    left: 42.2%;
    top: 70.6%;
    width: 34%;
    aspect-ratio: 9 / 19;
    transform-style: preserve-3d;
    transform:
      translate(-50%, -50%)
      translate3d(calc(var(--phone-p) * 9cqw), calc(var(--phone-p) * -5cqw), calc(var(--h) / -2 + 3px + var(--phone-p) * 6cqw))
      rotateZ(calc(var(--phone-p) * 3.8deg)) rotateY(calc(var(--phone-p) * 3deg)) rotateX(calc(var(--phone-p) * -7deg))
      scale(calc(0.5 + var(--phone-p) * 0.5));
    opacity: calc(min(1, var(--phone-p) * 8));
  }
  .phone__body {
    position: absolute;
    inset: 0;
    padding: 4.5%;
    border-radius: 13% / 6.2%;
    background: linear-gradient(145deg, #2c2f38, #0b0c10 60%);
    box-shadow:
      inset 0 0 0 0.12cqw #4a4e5a,
      0 2cqw 4cqw rgb(0 0 0 / 0.55);
  }
  .phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 10% / 4.8%;
    background: #141d30;
    container-type: inline-size;
    color: #f6e8c6;
    font-family: 'Ancizar Serif', Georgia, serif;
  }
  .screen {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6cqw;
    padding: 12% 9% 10%;
    text-align: center;
    opacity: 0;
    transform: translateY(5cqw);
    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-screen='role'] .screen--role,
  [data-screen='night'] .screen--night,
  [data-screen='vote'] .screen--vote {
    opacity: 1;
    transform: none;
  }
  .screen__kicker {
    margin: 0;
    font-size: 11cqw;
    opacity: 0.8;
  }
  .screen__title {
    margin: 0;
    font-size: 15cqw;
    font-weight: 700;
    line-height: 1.1;
    color: #f5aa42;
  }
  .screen--night .screen__title,
  .screen--vote .screen__title {
    color: #f6e8c6;
  }
  .screen--vote .screen__title {
    font-size: 11cqw;
  }
  .screen__grid :global(picture) {
    display: block;
  }
  .screen :global(.screen__portrait) {
    width: 72%;
    height: auto;
  }
  .screen__hint {
    margin: 0;
    font-size: 8.5cqw;
    line-height: 1.3;
    opacity: 0.85;
  }
  .screen__btn {
    margin-top: 3cqw;
    padding: 4cqw 11cqw;
    border-radius: 999px;
    background: #f5aa42;
    color: #2a1b12;
    font-size: 9cqw;
    font-weight: 700;
  }
  .screen__moon {
    width: 46cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 10cqw -6cqw 0 0 #f6e8c6;
    transform: rotate(-20deg);
    margin-bottom: 5cqw;
  }
  .screen__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5cqw;
    width: 86%;
    margin: 5cqw 0;
  }
  .screen__grid :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 12%;
    border-radius: 50%;
    background: #232c52;
    box-shadow: 0 0 0 1.4cqw #c9973f;
  }

  /* Story beats: the opening copy hands over to one caption per beat. */
  .hero-headline,
  .hero-lede {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .box-hero:not([data-stage='0']) .hero-headline,
  .box-hero:not([data-stage='0']) .hero-lede {
    opacity: 0;
    transform: translateY(-0.8cqw);
  }
  .is-static .hero-headline,
  .is-static .hero-lede {
    opacity: 1 !important;
    transform: none !important;
  }
  .captions {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .caption {
    position: absolute;
    inset: 0 0 auto;
    font-size: 1.55cqw;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(1cqw);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .caption strong {
    display: block;
    margin-bottom: 0.6cqw;
    font-size: 3.6cqw;
    line-height: 1.04;
    color: #f6e8c6;
  }
  [data-stage='1'] [data-caption='1'],
  [data-stage='2'] [data-caption='2'],
  [data-stage='3'] [data-caption='3'],
  [data-stage='4'] [data-caption='4'] {
    opacity: 1;
    transform: none;
  }
  .is-static .caption {
    display: none;
  }
  .scroll-hint {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 10%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5cqw;
    margin: 0;
    transform: translateX(-50%);
    font-size: 1cqw;
    letter-spacing: 0.04em;
    color: rgb(246 232 198 / 0.8);
    transition: opacity 0.4s ease;
  }
  .scroll-hint span {
    width: 1.3cqw;
    height: 2.1cqw;
    border: 0.15cqw solid currentColor;
    border-radius: 999px;
    position: relative;
  }
  .scroll-hint span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 22%;
    width: 0.2cqw;
    height: 0.45cqw;
    border-radius: 999px;
    background: currentColor;
    transform: translateX(-50%);
    animation: wheel 1.6s ease-in-out infinite;
  }
  @keyframes wheel {
    50% {
      transform: translate(-50%, 0.6cqw);
      opacity: 0.2;
    }
  }
  .box-hero:not([data-stage='0']) .scroll-hint,
  .is-static .scroll-hint {
    opacity: 0;
  }

  /* ---------- Navigation ---------- */
  .hero-nav {

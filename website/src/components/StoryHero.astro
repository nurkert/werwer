---
// The opening as a small puppet show on the games table. The stage stays pinned while the
// section scrolls by; each story beat brings cardboard puppets in on their sticks, from the
// sides and from below, while a caption tells what is happening.
import { getImage, Picture } from 'astro:assets';

import { path, repoUrl, ui, type Lang } from '../i18n/ui';
import prospekt from '../../../design/source/stage/prospekt.png';
import wordmark from '../assets/plates/nav-wordmark.png';
import felt from '../assets/plates/felt.png';
import lantern from '../assets/plates/lantern.png';
import decorLeft from '../assets/plates/decor-left.png';
import decorTopRight from '../assets/plates/decor-top-right.png';
import busch from '../../../design/source/props/busch.png';
import tanne1 from '../../../design/source/props/tanne_1.png';
import tanne2 from '../../../design/source/props/tanne_2.png';
import steine from '../../../design/source/props/steine.png';
import zaun from '../../../design/source/props/zaun.png';
import haeuser from '../../../design/source/props/haeuser.png';
import kirchturm from '../../../design/source/props/kirchturm.png';
import werwolf from '../../../design/source/figures/werwolf.png';
import seherin from '../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../design/source/figures/dorfbewohner.png';
import magd from '../../../design/source/figures/magd.png';
import hexe from '../../../design/source/figures/hexe.png';
import phoneIsland from '../../../design/source/brand/phone-island.png';
import phoneEdge from '../../../design/source/brand/phone-edge.png';
import schaf from '../../../design/source/sheep/schaf_2.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const u = t.unbox;
const beats = t.story.beats;
const formats = ['avif', 'webp'] as const;
const feltTile = (await getImage({ src: felt, width: 1024, format: 'webp' })).src;
const votePortraits = [dorfbewohner, magd, hexe, seherin];
---

<section class="story" aria-labelledby="story-title" data-story data-beat="0" style={`--felt: url(${feltTile})`}>
  <div class="story__stage">
    <div class="scene">
      <!-- painted backdrop, hung behind the table -->
      <div class="backdrop">
        <Picture src={prospekt} alt="" formats={formats} widths={[960, 1672]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="set set--far">
        <Picture class="c c-church" src={kirchturm} alt="" formats={formats} widths={[200, 400]} sizes="8vw" loading="eager" />
        <Picture class="c c-houses" src={haeuser} alt="" formats={formats} widths={[480, 960]} sizes="28vw" loading="eager" />
        <Picture class="c c-pine1" src={tanne1} alt="" formats={formats} widths={[200, 400]} sizes="9vw" loading="eager" />
        <Picture class="c c-pine2" src={tanne2} alt="" formats={formats} widths={[200, 400]} sizes="8vw" loading="eager" />
      </div>

      <!-- the puppets, each held in from off-stage -->
      <div class="cast" aria-hidden="true">
        <div class="pp pp--villager"><Picture src={dorfbewohner} alt="" formats={formats} widths={[260, 520]} sizes="14vw" loading="eager" /></div>
        <div class="pp pp--maid"><Picture src={magd} alt="" formats={formats} widths={[220, 440]} sizes="12vw" loading="eager" /></div>
        <div class="pp pp--wolf"><Picture src={werwolf} alt="" formats={formats} widths={[320, 640]} sizes="18vw" loading="eager" /></div>
        <div class="pp pp--seer"><Picture src={seherin} alt="" formats={formats} widths={[260, 520]} sizes="14vw" loading="eager" /></div>
        <div class="pp pp--phone pp--phone-a">
          <Picture src={phoneIsland} alt="" formats={formats} widths={[300, 600]} sizes="16vw" loading="eager" />
          <div class="pscreen pscreen--island">
            <p class="sb"><span>23:47</span><span class="sb__icons"><i></i><i></i><i></i></span></p>
            <div class="ps ps--role">
              <p class="ps__label">{u.youAre}</p>
              <div class="ps__medal"><Picture src={seherin} alt="" formats={formats} widths={[160, 320]} sizes="8vw" /></div>
              <p class="ps__title">{u.role}</p>
              <span class="ps__chip">{t.cast.village}</span>
              <p class="ps__hint">{u.roleHint}</p>
              <span class="ps__btn">{u.next}</span>
            </div>
            <div class="ps ps--night">
              <span class="ps__moon"></span>
              <p class="ps__title">{u.night}</p>
              <p class="ps__hint">{u.nightHint}</p>
            </div>
            <div class="ps ps--vote">
              <p class="ps__title ps__title--small">{u.vote}</p>
              <div class="ps__grid">
                {votePortraits.map((src, i) => (
                  <span class:list={['ps__face', { 'is-picked': i === 1 }]}>
                    <Picture src={src} alt="" formats={formats} widths={[80, 160]} sizes="3vw" />
                  </span>
                ))}
              </div>
              <span class="ps__btn">{u.voteButton}</span>
            </div>
          </div>
        </div>
        <div class="pp pp--phone pp--phone-b">
          <Picture src={phoneEdge} alt="" formats={formats} widths={[300, 600]} sizes="16vw" loading="eager" />
          <div class="pscreen">
            <p class="sb"><span>23:47</span><span class="sb__icons"><i></i><i></i><i></i></span></p>
            <div class="ps ps--sheep">
              <p class="ps__title ps__title--small">{t.sheep.title}</p>
              <div class="ps__meadow"><Picture src={schaf} alt="" formats={formats} widths={[120, 240]} sizes="5vw" /></div>
              <p class="ps__count"><strong>7</strong> {t.sheep.score}</p>
            </div>
            <div class="ps ps--vote">
              <p class="ps__title ps__title--small">{u.vote}</p>
              <div class="ps__grid">
                {votePortraits.map((src, i) => (
                  <span class:list={['ps__face', { 'is-picked': i === 1 }]}>
                    <Picture src={src} alt="" formats={formats} widths={[80, 160]} sizes="3vw" />
                  </span>
                ))}
              </div>
              <span class="ps__btn">{u.voteButton}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- set pieces in front of the puppets: they hide the sticks -->
      <div class="set set--near">
        <Picture class="c c-stones" src={steine} alt="" formats={formats} widths={[300, 600]} sizes="14vw" loading="eager" />
        <Picture class="c c-bush1" src={busch} alt="" formats={formats} widths={[300, 600]} sizes="16vw" loading="eager" />
        <Picture class="c c-fence" src={zaun} alt="" formats={formats} widths={[300, 600]} sizes="14vw" loading="eager" />
        <Picture class="c c-bush2" src={busch} alt="" formats={formats} widths={[300, 600]} sizes="16vw" loading="eager" />
      </div>

      <!-- the games table in front of the stage -->
      <div class="table" aria-hidden="true">
        <Picture class="c c-lantern" src={lantern} alt="" formats={formats} widths={[240, 480]} sizes="10vw" loading="eager" />
        <Picture class="c c-pines" src={decorLeft} alt="" formats={formats} widths={[240, 480]} sizes="10vw" loading="eager" />
        <Picture class="c c-book" src={decorTopRight} alt="" formats={formats} widths={[240, 480]} sizes="10vw" loading="eager" />
      </div>
      <div class="sky" aria-hidden="true">
        {Array.from({ length: 22 }, (_, i) => (
          <span class="star" style={`left:${(i * 37) % 100}%; top:${(i * 53) % 30}%; --d:${(i % 7) * 0.6}s`}></span>
        ))}
        {Array.from({ length: 10 }, (_, i) => (
          <span class="fly" style={`left:${10 + ((i * 41) % 80)}%; top:${48 + ((i * 29) % 26)}%; --d:${(i % 5) * 1.3}s; --t:${7 + (i % 4) * 2}s`}></span>
        ))}
      </div>
    </div>

    <!-- words -->
    <div class="copy">
      <a class="copy__brand" href={path('home', lang)} aria-label="Whowolf">
        <Picture src={wordmark} alt="" formats={formats} widths={[300, 600]} sizes="260px" loading="eager" />
      </a>
      <div class="copy__intro">
        <h1 id="story-title"><span class="visually-hidden">Whowolf – </span>{t.box.headline}</h1>
        <p>{t.box.lede.join(' ')}</p>
      </div>
      <ol class="copy__beats" aria-live="polite">
        {
          beats.map((beat, i) => (
            <li data-n={i + 1}>
              <strong>{beat.title}</strong> {beat.text}
            </li>
          ))
        }
      </ol>
      <div class="copy__actions">
        <a class="button button--primary" href={repoUrl}>{t.box.cta}</a>
        <span class="stamp stamp--status">{t.box.stamp}</span>
      </div>
    </div>
    <p class="story__hint" aria-hidden="true"><span></span>{u.scroll}</p>
  </div>
</section>

<script>
  // Scroll position → story beat. CSS moves the puppets per beat; nothing else is animated here.
  const story = document.querySelector<HTMLElement>('[data-story]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (story && calm.matches) {
    story.classList.add('is-static');
    story.dataset.beat = '5';
  } else if (story) {
    let queued = false;
    const update = () => {
      queued = false;
      const rect = story.getBoundingClientRect();
      const range = Math.max(rect.height - window.innerHeight, 1);
      const p = Math.min(Math.max(-rect.top / range, 0), 1);
      story.dataset.beat = String(Math.min(5, Math.floor(p * 6.2)));
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  .story {
    position: relative;
    height: 520vh;
    overflow: clip;
    background: #0d140f var(--felt) repeat;
    background-size: 640px;
    color: #f6e8c6;
  }
  .story__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* ---------- Scene ---------- */
  .scene {
    position: absolute;
    inset: 0;
    container-type: size;
  }
  .scene :global(picture) {
    display: contents;
  }
  .scene :global(.c) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 0.6cqh 0.9cqh rgb(0 0 0 / 0.45));
  }
  /* the painted backdrop hangs like a stage flat above the table */
  .backdrop {
    position: absolute;
    left: 50%;
    top: 2cqh;
    width: min(100cqw, 160cqh);
    height: 82cqh;
    transform: translateX(-50%);
    border-radius: 0.6cqh;
    overflow: hidden;
    box-shadow: 0 2cqh 5cqh rgb(0 0 0 / 0.55);
  }
  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .set,
  .cast,
  .table,
  .sky {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(100cqw, 160cqh);
    height: 100cqh;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .c-church {
    left: 18%;
    bottom: 33%;
    width: 6%;
  }
  .c-houses {
    left: 25%;
    bottom: 33%;
    width: 24%;
  }
  .c-pine1 {
    left: 6%;
    bottom: 30%;
    width: 8%;
  }
  .c-pine2 {
    left: 84%;
    bottom: 31%;
    width: 7%;
  }
  .c-stones {
    left: 4%;
    bottom: 15%;
    width: 13%;
  }
  .c-bush1 {
    left: 22%;
    bottom: 14%;
    width: 15%;
  }
  .c-fence {
    left: 52%;
    bottom: 15%;
    width: 12%;
  }
  .c-bush2 {
    left: 70%;
    bottom: 14%;
    width: 15%;
  }
  .table {
    background: none;
  }
  .table::before {
    /* the front edge of the stage: felt over the sticks, like a puppet booth */
    content: '';
    position: absolute;
    left: -50vw;
    right: -50vw;
    bottom: 0;
    height: 17cqh;
    background: #0d140f var(--felt) repeat;
    background-size: 640px;
    box-shadow: 0 -1.2cqh 2.4cqh rgb(0 0 0 / 0.5);
    border-top: 0.5cqh solid #3b2414;
  }
  .c-lantern {
    left: -1%;
    bottom: 1%;
    width: 8%;
    z-index: 1;
  }
  .c-pines {
    left: -2%;
    bottom: 18%;
    width: 7%;
    opacity: 0.9;
  }
  .c-book {
    right: -1%;
    bottom: 0;
    width: 9%;
    z-index: 1;
  }

  /* ---------- Puppets held in on sticks ---------- */
  .pp {
    position: absolute;
    bottom: 2%;
    transform-origin: 50% 100%;
    transition:
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease;
    animation: hold 5s ease-in-out infinite;
  }
  .pp :global(img) {
    width: 100%;
    height: auto;
  }
  @keyframes hold {
    0%,
    100% {
      rotate: -1.2deg;
    }
    50% {
      rotate: 1.2deg;
    }
  }
  .pp--villager {
    left: 29%;
    width: 14%;
    transform: translateX(-60cqw) rotate(-8deg);
  }
  .pp--maid {
    left: 85%;
    width: 12%;
    transform: translateX(60cqw) rotate(8deg);
    animation-delay: -1.5s;
  }
  .pp--wolf {
    left: 6%;
    width: 20%;
    transform: translateY(70cqh);
    animation-delay: -3s;
  }
  .pp--seer {
    left: 43%;
    width: 15%;
    transform: translateY(70cqh);
    animation-delay: -2s;
  }
  .pp--phone {
    bottom: 0%;
    animation-delay: -4s;
  }
  .pp--phone-a {
    left: 57%;
    width: 14%;
    transform: translateX(70cqw) rotate(12deg);
  }
  .pp--phone-b {
    left: 71%;
    width: 13%;
    bottom: -3%;
    transform: translateY(80cqh) rotate(-6deg);
    animation-delay: -1s;
  }
  /* beat 1: villagers come in from both sides */
  [data-beat='1'] .pp--villager,
  [data-beat='2'] .pp--villager,
  [data-beat='3'] .pp--villager,
  [data-beat='4'] .pp--villager,
  [data-beat='5'] .pp--villager,
  [data-beat='1'] .pp--maid,
  [data-beat='2'] .pp--maid,
  [data-beat='3'] .pp--maid,
  [data-beat='4'] .pp--maid,
  [data-beat='5'] .pp--maid {
    transform: none;
  }
  /* beat 2: the werewolf rises behind the bush */
  [data-beat='2'] .pp--wolf,
  [data-beat='3'] .pp--wolf,
  [data-beat='4'] .pp--wolf,
  [data-beat='5'] .pp--wolf {
    transform: none;
  }
  /* beat 3: the phone is held in */
  [data-beat='3'] .pp--phone-a,
  [data-beat='4'] .pp--phone-a,
  [data-beat='5'] .pp--phone-a {
    transform: none;
  }
  [data-beat='4'] .pp--phone-b,
  [data-beat='5'] .pp--phone-b {
    transform: rotate(3deg);
  }
  /* beat 4: the seer joins */
  [data-beat='4'] .pp--seer,
  [data-beat='5'] .pp--seer {
    transform: none;
  }
  /* night: the backdrop darkens a little while everyone taps */
  .backdrop {
    transition: filter 0.8s ease;
  }
  [data-beat='4'] .backdrop {
    filter: brightness(0.7) saturate(0.9);
  }
  [data-beat='5'] .backdrop {
    filter: brightness(1.12) saturate(1.05);
  }

  /* ---------- Phone screens: a small, real-looking app ---------- */
  .pscreen {
    position: absolute;
    left: 10.8%;
    top: 3.8%;
    width: 78%;
    height: 61.8%;
    overflow: hidden;
    border-radius: 14% / 6.6%;
    container-type: inline-size;
    background:
      radial-gradient(ellipse 120% 60% at 50% 0%, #2b3a6e, transparent 70%),
      linear-gradient(180deg, #18213f, #0f1530);
    color: #f6e8c6;
    font-family: 'Manrope Variable', system-ui, sans-serif;
  }
  .sb {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    padding: 5cqw 9cqw 0 10cqw;
    font-size: 6.5cqw;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .pscreen--island .sb {
    padding-top: 4.2cqw;
  }
  .sb__icons {
    display: flex;
    gap: 1.6cqw;
    align-items: flex-end;
  }
  .sb__icons i {
    display: block;
    width: 2.2cqw;
    border-radius: 1cqw;
    background: currentColor;
  }
  .sb__icons i:nth-child(1) {
    height: 3cqw;
  }
  .sb__icons i:nth-child(2) {
    height: 4.4cqw;
  }
  .sb__icons i:nth-child(3) {
    width: 7cqw;
    height: 4cqw;
    border-radius: 1.2cqw;
    background: none;
    box-shadow: inset 0 0 0 0.9cqw currentColor;
  }
  .ps {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 4.5cqw;
    padding: 18cqw 9cqw 10cqw;
    text-align: center;
    opacity: 0;
    transform: translateY(4cqw) scale(0.98);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pp--phone-a .ps--role,
  [data-beat='4'] .pp--phone-a .ps--role,
  [data-beat='5'] .pp--phone-a .ps--role {
    opacity: 0;
  }
  [data-beat='0'] .pp--phone-a .ps--role,
  [data-beat='1'] .pp--phone-a .ps--role,
  [data-beat='2'] .pp--phone-a .ps--role,
  [data-beat='3'] .pp--phone-a .ps--role,
  [data-beat='4'] .pp--phone-a .ps--night,
  [data-beat='5'] .pp--phone-a .ps--vote,
  .pp--phone-b .ps--sheep,
  [data-beat='5'] .pp--phone-b .ps--vote {
    opacity: 1;
    transform: none;
  }
  [data-beat='5'] .pp--phone-b .ps--sheep {
    opacity: 0;
  }
  .ps__label {
    margin: 0;
    font-size: 6.5cqw;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .ps__medal {
    width: 56cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 35%, #3a4677, #141d30);
    box-shadow:
      0 0 0 1.8cqw #c9973f,
      0 0 8cqw rgb(245 170 66 / 0.35);
  }
  .ps__medal :global(picture) {
    display: block;
  }
  .ps__medal :global(img) {
    width: 100%;
    height: 140%;
    object-fit: cover;
    object-position: 50% 6%;
  }
  .ps__title {
    margin: 0;
    font-family: 'Ancizar Serif', Georgia, serif;
    font-size: 13cqw;
    font-weight: 700;
    line-height: 1.05;
    color: #f5aa42;
  }
  .ps__title--small {
    font-size: 10.5cqw;
    color: #f6e8c6;
  }
  .ps--night .ps__title {
    color: #f6e8c6;
  }
  .ps__chip {
    padding: 1.2cqw 4cqw;
    border-radius: 999px;
    background: rgb(233 214 172 / 0.16);
    font-size: 6cqw;
    font-weight: 700;
  }
  .ps__hint {
    margin: 0;
    font-size: 6.5cqw;
    line-height: 1.35;
    opacity: 0.8;
  }
  .ps__btn {
    width: 100%;
    padding: 4cqw 0;
    border-radius: 999px;
    background: #f5aa42;
    color: #2a1b12;
    font-size: 7.5cqw;
    font-weight: 800;
  }
  .ps__moon {
    width: 42cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      inset 10cqw -6cqw 0 0 #f6e8c6,
      0 0 12cqw rgb(246 232 198 / 0.15);
    transform: rotate(-20deg);
  }
  .ps__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6cqw;
    width: 82%;
  }
  .ps__face {
    position: relative;
    display: block;
    border-radius: 50%;
    overflow: hidden;
    aspect-ratio: 1;
    background: #232c52;
    box-shadow: 0 0 0 1.2cqw rgb(201 151 63 / 0.6);
  }
  .ps__face :global(picture) {
    display: block;
  }
  .ps__face :global(img) {
    width: 100%;
    height: 150%;
    object-fit: cover;
    object-position: 50% 4%;
  }
  .ps__face.is-picked {
    box-shadow:
      0 0 0 1.8cqw #f5aa42,
      0 0 6cqw rgb(245 170 66 / 0.6);
  }
  .ps__meadow {
    width: 86%;
    aspect-ratio: 1.2;
    display: grid;
    place-items: center;
    border-radius: 8cqw;
    background:
      radial-gradient(ellipse 120% 50% at 50% 100%, #2f6b45 55%, transparent 56%),
      radial-gradient(circle at 78% 22%, #f6e8c6 8%, transparent 9%),
      #1a2546;
  }
  .ps__meadow :global(picture) {
    display: block;
    width: 62%;
    animation: hop 1.4s ease-in-out infinite;
  }
  .ps__meadow :global(img) {
    width: 100%;
    height: auto;
  }
  @keyframes hop {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-18%) rotate(4deg);
    }
  }
  .ps__count {
    margin: 0;
    font-size: 7cqw;
    opacity: 0.85;
  }
  .ps__count strong {
    font-family: 'Ancizar Serif', Georgia, serif;
    font-size: 12cqw;
    color: #f5aa42;
  }

  /* ---------- Sky life ---------- */
  .star {
    position: absolute;
    width: 0.3cqh;
    min-width: 2px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff3d1;
    box-shadow: 0 0 0.8cqh rgb(255 243 209 / 0.8);
    animation: twinkle 3.6s ease-in-out var(--d) infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.2;
      transform: scale(0.6);
    }
  }
  .fly {
    position: absolute;
    width: 0.45cqh;
    min-width: 3px;
    aspect-ratio: 1;
    border-radius: 50%;

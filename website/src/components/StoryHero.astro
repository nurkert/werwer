---
// The opening as a small puppet show on a painted stage. The stage stays pinned while the
// section scrolls by; each story beat brings cardboard puppets in from the sides and from
// below, while a caption tells what is happening.
import { Picture } from 'astro:assets';

import { path, repoUrl, ui, type Lang } from '../i18n/ui';
import { storyPhones } from '../lib/phone-screens';
import PuppetPhone from './phone/PuppetPhone.astro';
import himmel from '../../../design/source/stage/ebene_himmel.png';
import mond from '../../../design/source/stage/ebene_mond.png';
import wolke1 from '../../../design/source/stage/ebene_wolke_1.png';
import wolke2 from '../../../design/source/stage/ebene_wolke_2.png';
import wolke3 from '../../../design/source/stage/ebene_wolke_3.png';
import berge from '../../../design/source/stage/ebene_berge.png';
import huegel from '../../../design/source/stage/ebene_huegel.png';
import wiese from '../../../design/source/stage/ebene_wiese.png';
import wordmark from '../assets/plates/nav-wordmark.png';
import busch from '../../../design/source/props/busch.png';
import tanne1 from '../../../design/source/props/tanne_1.png';
import tanne2 from '../../../design/source/props/tanne_2.png';
import steine from '../../../design/source/props/steine.png';
import zaun from '../../../design/source/props/zaun.png';
import haeuser from '../../../design/source/props/haeuser.png';
import kirchturm from '../../../design/source/props/kirchturm.png';
import werwolf from '../../../design/source/figures/werwolf.png';
import seherin from '../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../design/source/figures/dorfbewohner.png';
import magd from '../../../design/source/figures/magd.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const beats = t.story.beats;
const [phoneA, phoneB] = storyPhones(t);
const formats = ['avif', 'webp'] as const;
---

<section class="story" aria-labelledby="story-title" data-story data-beat="0">
  <div class="story__stage">
    <div class="scene">
      <!-- the backdrop: painted sky, then cardboard planes from far to near, each drifting at its own pace -->
      <div class="backdrop">
        <div class="plane plane--sky">
          <Picture src={himmel} alt="" formats={formats} widths={[960, 1774]} sizes="100vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="plane plane--moon">
          <Picture class="c c-moon" src={mond} alt="" formats={formats} widths={[200, 400]} sizes="(max-width: 760px) 30vw, 20vw" loading="eager" />
        </div>
        <div class="plane plane--clouds">
          <Picture class="c c-cloud1" src={wolke1} alt="" formats={formats} widths={[260, 513]} sizes="18vw" loading="eager" />
          <Picture class="c c-cloud2" src={wolke2} alt="" formats={formats} widths={[170, 340]} sizes="(max-width: 760px) 28vw, 12vw" loading="eager" />
          <Picture class="c c-cloud3" src={wolke3} alt="" formats={formats} widths={[140, 273]} sizes="(max-width: 760px) 20vw, 9vw" loading="eager" />
        </div>
        <div class="plane plane--mountains">
          <Picture class="strip" src={berge} alt="" formats={formats} widths={[960, 1758]} sizes="(max-width: 760px) 240vw, 110vw" loading="eager" />
        </div>
        <div class="plane plane--hills">
          <Picture class="strip" src={huegel} alt="" formats={formats} widths={[960, 1755]} sizes="(max-width: 760px) 290vw, 110vw" loading="eager" />
        </div>
        <div class="plane plane--meadow">
          <Picture class="strip" src={wiese} alt="" formats={formats} widths={[960, 1755]} sizes="(max-width: 760px) 215vw, 110vw" loading="eager" />
        </div>
      </div>
      <div class="set set--far">
        <Picture class="c c-church" src={kirchturm} alt="" formats={formats} widths={[200, 400]} sizes="8vw" loading="eager" />
        <Picture class="c c-houses" src={haeuser} alt="" formats={formats} widths={[480, 960]} sizes="28vw" loading="eager" />
        <Picture class="c c-pine1" src={tanne1} alt="" formats={formats} widths={[200, 400]} sizes="9vw" loading="eager" />
        <Picture class="c c-pine2" src={tanne2} alt="" formats={formats} widths={[200, 400]} sizes="8vw" loading="eager" />
      </div>

      <!-- middle ground: the puppets are held up in front of it -->
      <div class="set set--near">
        <Picture class="c c-stones" src={steine} alt="" formats={formats} widths={[300, 600]} sizes="14vw" loading="eager" />
        <Picture class="c c-bush1" src={busch} alt="" formats={formats} widths={[300, 600]} sizes="16vw" loading="eager" />
        <Picture class="c c-fence" src={zaun} alt="" formats={formats} widths={[300, 600]} sizes="14vw" loading="eager" />
        <Picture class="c c-bush2" src={busch} alt="" formats={formats} widths={[300, 600]} sizes="16vw" loading="eager" />
      </div>
      <!-- the puppets, each held in from off-stage -->
      <div class="cast" aria-hidden="true">
        <div class="pp pp--villager"><div class="flip"><Picture class="face" src={dorfbewohner} alt="" formats={formats} widths={[260, 520]} sizes="14vw" loading="eager" /></div></div>
        <div class="pp pp--maid"><div class="flip"><Picture class="face" src={magd} alt="" formats={formats} widths={[220, 440]} sizes="12vw" loading="eager" /></div></div>
        <div class="pp pp--wolf"><div class="flip"><Picture class="face" src={werwolf} alt="" formats={formats} widths={[320, 640]} sizes="18vw" loading="eager" /></div></div>
        <div class="pp pp--seer"><div class="flip"><Picture class="face" src={seherin} alt="" formats={formats} widths={[260, 520]} sizes="14vw" loading="eager" /></div></div>
        <div class="pp pp--phone pp--phone-a"><PuppetPhone phone={phoneA} /></div>
        <div class="pp pp--phone pp--phone-b"><PuppetPhone phone={phoneB} /></div>
      </div>

      <div class="sky" aria-hidden="true">
        {Array.from({ length: 22 }, (_, i) => (
          <span class="star" style={`left:${(i * 37) % 100}%; top:${(i * 53) % 30}%; --d:${(i % 7) * 0.6}s`}></span>
        ))}
        {Array.from({ length: 10 }, (_, i) => (
          <span class="fly" style={`left:${10 + ((i * 41) % 80)}%; top:${48 + ((i * 29) % 26)}%; --d:${(i % 5) * 1.3}s; --t:${7 + (i % 4) * 2}s`}></span>
        ))}
      </div>
    </div>

    <!-- words -->
    <div class="copy">
      <a class="copy__brand" href={path('home', lang)} aria-label="Whowolf" data-hero-brand>
        <Picture src={wordmark} alt="" formats={formats} widths={[360, 720, 1080]} sizes="(max-width: 760px) 15rem, 36vw" loading="eager" />
      </a>
      <div class="copy__intro">
        <h1 id="story-title"><span class="visually-hidden">Whowolf – </span>{t.box.headline}</h1>
        <p>{t.box.lede.join(' ')}</p>
      </div>
      <ol class="copy__beats" aria-live="polite">
        {
          beats.map((beat, i) => (
            <li data-n={i + 1}>
              <strong>{beat.title}</strong> {beat.text}
            </li>
          ))
        }
      </ol>
      <div class="copy__actions">
        <a class="button button--primary" href={repoUrl}>{t.box.cta}</a>
        <span class="stamp stamp--status">{t.box.stamp}</span>
      </div>
      <p class="copy__app"><span class="copy__app-icon" aria-hidden="true"></span>{t.box.app}</p>
    </div>
  </div>
</section>

<script>
  // The title wordmark flies into the header while scrolling and docks as its logo. It is
  // measured once (and on resize), then moved with transforms only, so nothing reflows. Once
  // it has landed on the header logo's exact box, the header shows its own copy instead.
  const brand = document.querySelector<HTMLElement>('[data-hero-brand]');
  const header = document.querySelector<HTMLElement>('.site-header--overlay');
  const dock = header?.querySelector<HTMLElement>('[data-brand] img');
  if (brand && header && dock) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    // the lines under the wordmark fade out just before they would slide under the header
    const lines = [...document.querySelectorAll<HTMLElement>('.copy > :not([data-hero-brand])')];
    let from = { left: 0, top: 0, width: 1 };
    let to = { left: 0, top: 0, width: 1, bottom: 0 };
    let distance = 1;
    let queued = false;

    const measure = () => {
      brand.style.transform = '';
      const a = brand.getBoundingClientRect();
      const b = dock.getBoundingClientRect();
      from = { left: a.left, top: a.top + window.scrollY, width: a.width };
      to = { left: b.left, top: b.top, width: b.width, bottom: header.getBoundingClientRect().bottom };
      // lands where the header turns solid (see scripts/site.ts)
      distance = Math.max(1, window.innerHeight * 0.35);
    };
    const place = () => {
      queued = false;
      const y = window.scrollY;
      const p = Math.min(1, Math.max(0, y / distance));
      const docked = p >= 1;
      header.classList.toggle('is-docked', docked);
      brand.style.visibility = docked ? 'hidden' : '';
      if (still.matches) {
        brand.style.transform = '';
        for (const line of lines) line.style.filter = '';
        return;
      }
      const fades = lines.map((line) => (line.getBoundingClientRect().top - to.bottom) / 90);
      lines.forEach((line, i) => {
        const o = Math.min(1, Math.max(0, fades[i]));
        line.style.filter = o < 1 ? `opacity(${o.toFixed(3)})` : '';
      });
      // ease-out: it shrinks fastest at first, so the lines scrolling up never reach it
      const e = 1 - (1 - p) ** 3;
      const scale = 1 + (to.width / from.width - 1) * e;
      const dx = (to.left - from.left) * e;
      const dy = from.top + (to.top - from.top) * e - (from.top - y);
      brand.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(place);
      }
    };
    measure();
    place();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      place();
    });
    still.addEventListener('change', () => {
      measure();
      place();
    });
  }

  // The story plays once on load, on its own; scrolling just moves on, with the layers of the
  // stage drifting at different speeds.
  const story = document.querySelector<HTMLElement>('[data-story]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phones = story ? [...story.querySelectorAll<HTMLElement>('[data-phone]')] : [];
  const last = story ? story.querySelectorAll('.copy__beats li').length : 0;

  const show = (beat: number) => {
    if (!story) return;
    story.dataset.beat = String(beat);
    for (const phone of phones) {
      const screens = [...phone.querySelectorAll<HTMLElement>('[data-from]')];
      const current = screens.filter((screen) => Number(screen.dataset.from) <= beat).at(-1);
      for (const screen of screens) screen.classList.toggle('is-on', screen === current);
    }
  };

  if (story && calm) {
    story.classList.add('is-static');
    show(last);
  } else if (story) {
    let beat = 0;
    const next = () => {
      beat += 1;
      show(beat);
      if (beat < last) window.setTimeout(next, 950);
    };
    window.setTimeout(next, 350);

    let queued = false;
    const drift = () => {
      queued = false;
      const y = Math.min(window.scrollY, story.offsetHeight);
      story.style.setProperty('--drift', `${y}px`);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(drift);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .story {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    background: var(--night-900);
    color: #f6e8c6;
  }
  .story__stage {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  /* ---------- Scene ---------- */
  .scene {
    position: absolute;
    inset: 0;
    container-type: size;
  }
  .backdrop :global(picture),
  .set :global(picture),
  .flip :global(picture),
  .pp--phone > :global(picture) {
    display: contents;
  }
  /* parallax: when scrolling on, far layers lag behind near ones. Each backdrop plane has its
     own pace (--k); the meadow moves with the far set so the houses stay on their ground. */
  .plane {
    translate: 0 calc(var(--drift, 0px) * var(--k));
  }
  .sky {
    translate: 0 calc(var(--drift, 0px) * 0.55);
  }
  .set--far {
    translate: 0 calc(var(--drift, 0px) * 0.3);
  }
  .set--near {
    translate: 0 calc(var(--drift, 0px) * 0.18);
  }
  .cast {
    translate: 0 calc(var(--drift, 0px) * 0.07);
  }
  .scene :global(.c) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 0.6cqh 0.9cqh rgb(0 0 0 / 0.45));
  }
  /* ---------- Backdrop planes ---------- */
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* where each strip's top edge sits, in % of the stage height */
    --mountains-top: 13cqh;
    --hills-top: 36cqh;
    --meadow-top: 60cqh;
  }
  .plane {
    position: absolute;
    inset: 0;
  }
  .plane--sky {
    --k: 0.55;
  }
  .plane--moon {
    --k: 0.5;
  }
  .plane--clouds {
    --k: 0.46;
  }
  .plane--mountains {
    --k: 0.42;
  }
  .plane--hills {
    --k: 0.36;
  }
  .plane--meadow {
    --k: 0.3;
  }
  .plane--sky :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }
  /* moon and clouds are placed on the same centred frame as the puppets */
  .plane--moon,
  .plane--clouds {
    left: 50%;
    width: min(100cqw, 160cqh);
    transform: translateX(-50%);
  }
  .c-moon {
    left: 56%;
    top: 4cqh;
    width: 20%;
  }
  .c-cloud1 {
    left: 9%;
    top: 15cqh;
    width: 17%;
  }
  .c-cloud2 {
    left: 73%;
    top: 26cqh;
    width: 12%;
  }
  .c-cloud3 {
    left: 40%;
    top: 7cqh;
    width: 9%;
  }
  /* wide strips: always wider than the stage so their cut ends stay off-stage; on narrow
     screens their height wins and the sides are cropped */
  .scene :global(.strip) {
    position: absolute;
    left: 50%;
    height: auto;
    max-width: none;
    translate: -50% 0;
    filter: drop-shadow(0 -0.4cqh 1.2cqh rgb(0 0 0 / 0.5));
  }
  .plane--mountains :global(.strip) {
    top: var(--mountains-top);
    width: max(110cqw, var(--mountains-min, 30cqh) * 3.64);
  }
  .plane--hills :global(.strip) {
    top: var(--hills-top);
    width: max(110cqw, var(--hills-min, 34cqh) * 3.93);
  }
  /* the meadow runs into flat ground below its strip */
  .plane--meadow {
    top: var(--meadow-top);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .plane--meadow :global(.strip) {
    position: relative;
    flex: none;
    width: max(110cqw, var(--meadow-min, 12cqh) * 8.28);
  }
  .plane--meadow::after {
    content: '';
    flex: 1;
    align-self: stretch;
    margin-top: -2px;
    background: #101f23;
  }
  .set,
  .cast,
  .sky {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(100cqw, 160cqh);
    height: 100cqh;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .c-church {
    left: 18%;
    bottom: 33%;
    width: 6%;
  }
  .c-houses {
    left: 25%;
    bottom: 33%;
    width: 24%;
  }
  .c-pine1 {
    left: 6%;
    bottom: 30%;
    width: 8%;
  }
  .c-pine2 {
    left: 84%;
    bottom: 31%;
    width: 7%;
  }
  .c-stones {
    left: 4%;
    bottom: 15%;
    width: 13%;
  }
  .c-bush1 {
    left: 22%;
    bottom: 14%;
    width: 15%;
  }
  .c-fence {
    left: 52%;
    bottom: 15%;
    width: 12%;
  }
  .c-bush2 {
    left: 70%;
    bottom: 14%;
    width: 15%;
  }

  /* ---------- Puppets standing on the meadow ---------- */
  .pp {
    position: absolute;
    bottom: 3%;
    transform-origin: 50% 100%;
    transition:
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease;
    animation: hold 5s ease-in-out infinite;
  }
  .pp :global(.face),
  .pp :global(.frame) {
    display: block;
    width: 100%;
    height: auto;
  }
  @keyframes hold {
    0%,
    100% {
      rotate: -1.2deg;
    }
    50% {
      rotate: 1.2deg;
    }
  }
  .pp--villager {
    left: 29%;
    width: 14%;
    transform: translateX(-60cqw) rotate(-8deg);
  }
  .pp--maid {
    left: 88.5%;
    width: 11%;
    transform: translateX(60cqw) rotate(8deg);
    animation-delay: -1.5s;
  }
  .pp--wolf {
    left: 6%;
    width: 20%;
    transform: translateY(70cqh);
    animation-delay: -3s;
  }
  .pp--seer {
    left: 40.5%;
    width: 15%;
    transform: translateY(70cqh);
    animation-delay: -2s;
  }
  .pp--phone {
    bottom: 2.5%;
    animation-delay: -4s;
  }
  .pp--phone-a {
    left: 55.5%;
    width: 17%;
    transform: translateX(70cqw) rotate(12deg);
  }
  .pp--phone-b {
    left: 72%;
    width: 15%;
    bottom: 1%;
    transform: translateY(80cqh) rotate(-6deg);
    animation-delay: -1s;
  }
  /* beat 1: villagers come in from both sides */
  [data-beat='1'] .pp--villager,
  [data-beat='2'] .pp--villager,
  [data-beat='3'] .pp--villager,
  [data-beat='4'] .pp--villager,
  [data-beat='5'] .pp--villager,
  [data-beat='1'] .pp--maid,
  [data-beat='2'] .pp--maid,
  [data-beat='3'] .pp--maid,
  [data-beat='4'] .pp--maid,
  [data-beat='5'] .pp--maid {
    transform: none;
  }
  /* beat 2: the werewolf rises behind the bush */
  [data-beat='2'] .pp--wolf,
  [data-beat='3'] .pp--wolf,
  [data-beat='4'] .pp--wolf,
  [data-beat='5'] .pp--wolf {
    transform: none;
  }
  /* beat 3: the phone is held in */
  [data-beat='3'] .pp--phone-a,
  [data-beat='4'] .pp--phone-a,
  [data-beat='5'] .pp--phone-a {
    transform: none;
  }
  [data-beat='4'] .pp--phone-b,
  [data-beat='5'] .pp--phone-b {
    transform: rotate(3deg);
  }
  /* beat 4: the seer joins */
  [data-beat='4'] .pp--seer,
  [data-beat='5'] .pp--seer {
    transform: none;
  }
  /* night: the backdrop darkens a little while everyone taps */
  .backdrop {
    transition: filter 0.8s ease;
  }
  [data-beat='4'] .backdrop {
    filter: brightness(0.7) saturate(0.9);
  }
  [data-beat='5'] .backdrop {
    filter: brightness(1.12) saturate(1.05);
  }


  /* ---------- Cardboard turn: the puppet spins around and shows its mirrored back ---------- */
  .pp {
    perspective: 80cqh;
  }
  .flip {
    position: relative;
    transition: transform 0.75s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .flip :global(.face) {
    display: block;
    width: 100%;
    height: auto;
    /* one cutout: turned around, it simply shows mirrored */
    backface-visibility: visible;
  }
  [data-beat='2'] .pp--villager .flip,
  [data-beat='3'] .pp--villager .flip,
  [data-beat='4'] .pp--villager .flip,
  [data-beat='5'] .pp--villager .flip,
  [data-beat='4'] .pp--wolf .flip,
  [data-beat='5'] .pp--wolf .flip,
  [data-beat='5'] .pp--maid .flip {
    transform: rotateY(180deg);
  }

  /* ---------- Sky life ---------- */
  .star {
    position: absolute;
    width: 0.3cqh;
    min-width: 2px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff3d1;
    box-shadow: 0 0 0.8cqh rgb(255 243 209 / 0.8);
    animation: twinkle 3.6s ease-in-out var(--d) infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.2;
      transform: scale(0.6);
    }
  }
  .fly {
    position: absolute;
    width: 0.45cqh;
    min-width: 3px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffd27a;
    box-shadow: 0 0 1cqh 0.3cqh rgb(255 196 90 / 0.55);
    opacity: 0;
    animation: fly var(--t) ease-in-out var(--d) infinite;
  }
  @keyframes fly {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    20% {
      opacity: 0.9;
    }
    50% {
      transform: translate(2cqh, -3cqh);
      opacity: 0.5;
    }
    80% {
      opacity: 0.85;
      transform: translate(-1.4cqh, -1.2cqh);
    }
  }

  /* ---------- Copy ---------- */
  .copy {
    position: absolute;
    z-index: 5;
    left: max(1.5rem, calc(50% - min(50vw, 80svh) + 2rem));
    top: calc(4.75rem + 2svh);
    width: min(34rem, 42%);
    display: grid;
    gap: 1.1rem;
  }
  .copy__intro,
  .copy__beats {
    text-shadow:
      0 0.1rem 0.6rem rgb(8 10 28 / 0.9),
      0 0 1.6rem rgb(8 10 28 / 0.7);
  }
  .copy__brand {
    position: relative;
    z-index: 1;
    width: clamp(20rem, 36vw, 36rem);
    margin-left: -0.6rem;
    transform-origin: 0 0;
    will-change: transform;
    filter: drop-shadow(0 0.5rem 1.2rem rgb(8 10 28 / 0.6));
  }
  .copy__brand :global(img) {
    width: 100%;
    height: auto;
  }
  .copy h1 {
    font-family: 'Ancizar Serif', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 1rem + 2.2vw, 2.8rem);
    line-height: 1.05;
    color: #f6e8c6;
  }

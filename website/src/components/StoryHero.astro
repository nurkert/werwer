---
// The opening as a small puppet show on a painted stage. On load the puppets are held in
// one by one; the words stay put. The stage is built from a single unit (--u, the width of
// the stage frame / 100) and one ground line (--g): every backdrop strip is placed relative
// to the strip in front of it, so no gap can open between them at any screen size. Wide
// screens put the words beside the scene; narrow ones stack the words above it.
import { Picture } from 'astro:assets';

import { path, ui, type Lang } from '../i18n/ui';
import { storyPhones } from '../lib/phone-screens';
import PuppetPhone from './phone/PuppetPhone.astro';
import CardboardFigure from './CardboardFigure.astro';
import himmel from '../../../design/source/stage/ebene_himmel.png';
import mond from '../../../design/source/stage/ebene_mond.png';
import wolke2 from '../../../design/source/stage/ebene_wolke_2.png';
import berge from '../../../design/source/stage/ebene_berge.png';
import huegel from '../../../design/source/stage/ebene_huegel.png';
import wiese from '../../../design/source/stage/ebene_wiese.png';
import wordmark from '../assets/plates/nav-wordmark.png';
import busch from '../../../design/source/props/busch.png';
import tanne1 from '../../../design/source/props/tanne_1.png';
import tanne2 from '../../../design/source/props/tanne_2.png';
import steine from '../../../design/source/props/steine.png';
import zaun from '../../../design/source/props/zaun.png';
import haeuser from '../../../design/source/props/haeuser.png';
import kirchturm from '../../../design/source/props/kirchturm.png';
import werwolf from '../../../design/source/figures/werwolf.png';
import seherin from '../../../design/source/figures/seherin.png';
import dorfbewohner from '../../../design/source/figures/dorfbewohner.png';
import magd from '../../../design/source/figures/magd.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const beats = t.story.beats;
const [phoneA, phoneB] = storyPhones(t);
const formats = ['avif', 'webp'] as const;
---

<section class="story" aria-labelledby="story-title" data-story>
  <div class="scene" aria-hidden="true">
    <!-- the backdrop: painted sky, then cardboard planes from far to near; --k is each plane's parallax pace -->
    <div class="backdrop">
      <div class="plane plane--sky" data-k="0.55">
        <Picture src={himmel} alt="" formats={formats} widths={[960, 1774]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="plane stage-frame stars" data-k="0.55">
        {Array.from({ length: 22 }, (_, i) => (
          <span class="star" style={`left:${(i * 37) % 100}%; --y:${(i * 53) % 100}; --d:${(i % 7) * 0.6}s`}></span>
        ))}
      </div>
      <div class="plane stage-frame plane--moon" data-k="0.5">
        <Picture class="c c-moon" src={mond} alt="" formats={formats} widths={[200, 400]} sizes="(max-width: 760px) 30vw, 14vw" loading="eager" />
        <Picture class="c c-cloud2" src={wolke2} alt="" formats={formats} widths={[170, 340]} sizes="(max-width: 760px) 24vw, 10vw" loading="eager" />
      </div>
      <div class="plane plane--mountains" data-k="0.42">
        <Picture class="strip" src={berge} alt="" formats={formats} widths={[960, 1758]} sizes="(max-width: 760px) 240vw, 115vw" loading="eager" />
      </div>
      <div class="plane plane--hills" data-k="0.36">
        <Picture class="strip" src={huegel} alt="" formats={formats} widths={[960, 1755]} sizes="(max-width: 760px) 270vw, 115vw" loading="eager" />
      </div>
      <div class="plane plane--meadow" data-k="0.3">
        <Picture class="strip" src={wiese} alt="" formats={formats} widths={[960, 1755]} sizes="(max-width: 760px) 200vw, 115vw" loading="eager" />
      </div>
    </div>

    <!-- the village at the foot of the castle hill, standing on the meadow -->
    <div class="stage-frame set set--far" data-k="0.3">
      <Picture class="c c-pine1" src={tanne1} alt="" formats={formats} widths={[200, 400]} sizes="(max-width: 760px) 10vw, 6vw" loading="eager" />
      <Picture class="c c-church" src={kirchturm} alt="" formats={formats} widths={[200, 400]} sizes="(max-width: 760px) 12vw, 7vw" loading="eager" />
      <Picture class="c c-houses" src={haeuser} alt="" formats={formats} widths={[480, 960]} sizes="(max-width: 760px) 50vw, 24vw" loading="eager" />
      <Picture class="c c-pine2" src={tanne2} alt="" formats={formats} widths={[200, 400]} sizes="(max-width: 760px) 9vw, 5vw" loading="eager" />
      <Picture class="c c-fence" src={zaun} alt="" formats={formats} widths={[300, 600]} sizes="(max-width: 760px) 12vw, 6vw" loading="eager" />
      {Array.from({ length: 8 }, (_, i) => (
        <span class="fly" style={`left:${8 + ((i * 41) % 84)}%; --y:${((i * 29) % 100) / 100}; --d:${(i % 5) * 1.3}s; --t:${7 + (i % 4) * 2}s`}></span>
      ))}
    </div>
    <!-- a second row of meadow, from the village's ground down to the playboard -->
    <div class="plane plane--field" data-k="0.2">
      <Picture class="strip" src={wiese} alt="" formats={formats} widths={[960, 1755]} sizes="(max-width: 760px) 230vw, 128vw" loading="eager" />
    </div>
    <!-- the wings: a bush and stones at each side, behind the puppets -->
    <div class="stage-frame set set--near" data-k="0.18">
      <Picture class="c c-stones" src={steine} alt="" formats={formats} widths={[300, 600]} sizes="10vw" loading="eager" />
      <Picture class="c c-bush1" src={busch} alt="" formats={formats} widths={[300, 600]} sizes="(max-width: 760px) 24vw, 14vw" loading="eager" />
      <Picture class="c c-bush2" src={busch} alt="" formats={formats} widths={[300, 600]} sizes="(max-width: 760px) 22vw, 13vw" loading="eager" />
    </div>
    <!-- the puppets, each held in from off-stage; all eyes end up on the wolf -->
    <div class="stage-frame cast" data-k="0.07">
      <div class="pp pp--villager"><div class="flip" data-turn><CardboardFigure class="face" src={dorfbewohner} widths={[260, 520]} sizes="(max-width: 760px) 24vw, 13vw" loading="eager" back="print" /></div></div>
      <div class="pp pp--maid"><div class="flip" data-turn><CardboardFigure class="face" src={magd} widths={[220, 440]} sizes="11vw" loading="eager" back="print" /></div></div>
      <div class="pp pp--seer"><div class="flip" data-turn><CardboardFigure class="face" src={seherin} widths={[260, 520]} sizes="(max-width: 760px) 28vw, 15vw" loading="eager" back="print" /></div></div>
      <div class="pp pp--phone pp--phone-a"><PuppetPhone phone={phoneA} /></div>
      <div class="pp pp--phone pp--phone-b"><PuppetPhone phone={phoneB} /></div>
      <div class="pp pp--wolf"><div class="flip" data-turn><CardboardFigure class="face" src={werwolf} widths={[320, 640]} sizes="(max-width: 760px) 36vw, 18vw" loading="eager" back="print" /></div></div>
    </div>
    <!-- the playboard: a strip of near meadow the puppets stand in -->
    <div class="plane plane--front" data-k="0.07">
      <Picture class="strip" src={wiese} alt="" formats={formats} widths={[960, 1755]} sizes="(max-width: 760px) 240vw, 125vw" loading="eager" />
    </div>
  </div>

  <!-- words -->
  <div class="copy">
    <a class="copy__brand" href={path('home', lang)} aria-label="Whowolf" data-hero-brand>
      <Picture src={wordmark} alt="" formats={formats} widths={[360, 720, 1080]} sizes="(max-width: 760px) 13rem, 30vw" loading="eager" />
    </a>
    <div class="copy__intro">
      <h1 id="story-title"><span class="visually-hidden">Whowolf – </span>{t.box.headline}</h1>
      <p>{t.box.lede.join(' ')}</p>
    </div>
    <div class="copy__actions">
      <a class="button button--primary" href={path('download', lang)}>{t.box.cta}</a>
      <p class="copy__app"><span class="copy__app-icon" aria-hidden="true"></span>{t.box.app}</p>
    </div>
    <!-- what the puppet show plays, for anyone who cannot see it -->
    <ol class="visually-hidden">
      {beats.map((beat) => <li>{beat.title} {beat.text}</li>)}
    </ol>
  </div>
  <div class="story__room" aria-hidden="true"></div>
</section>

<script>
  // The title wordmark flies into the header while scrolling and docks as its logo. Every
  // position is measured once (and on resize / font load), then the scroll handler only
  // writes transforms, so scrolling never forces a layout.
  const brand = document.querySelector<HTMLElement>('[data-hero-brand]');
  const header = document.querySelector<HTMLElement>('.site-header--overlay');
  const dock = header?.querySelector<HTMLElement>('[data-brand] img');
  const story = document.querySelector<HTMLElement>('[data-story]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (brand && header && dock) {
    // the lines under the wordmark fade out just before they would slide under the header
    const lines = [...document.querySelectorAll<HTMLElement>('.copy > :not([data-hero-brand]):not(.visually-hidden)')];
    let from = { left: 0, top: 0, width: 1 };
    let to = { left: 0, top: 0, width: 1, bottom: 0 };
    let tops: number[] = [];
    let distance = 1;
    let queued = false;
    let settled = '';

    const measure = () => {
      brand.style.transform = '';
      for (const line of lines) line.style.opacity = '';
      const a = brand.getBoundingClientRect();
      const b = dock.getBoundingClientRect();
      from = { left: a.left, top: a.top + window.scrollY, width: a.width };
      to = { left: b.left, top: b.top, width: b.width, bottom: header.getBoundingClientRect().bottom };
      tops = lines.map((line) => line.getBoundingClientRect().top + window.scrollY);
      // lands where the header turns solid (see scripts/site.ts)
      distance = Math.max(1, window.innerHeight * 0.35);
      settled = '';
    };
    const place = () => {
      queued = false;
      const y = window.scrollY;
      const p = Math.min(1, Math.max(0, y / distance));
      const docked = p >= 1;
      // far below the hero nothing changes any more: skip the writes
      const state = docked && y > distance + window.innerHeight ? 'gone' : '';
      if (state && state === settled) return;
      settled = state;
      header.classList.toggle('is-docked', docked);
      brand.style.visibility = docked ? 'hidden' : '';
      if (still.matches) {
        brand.style.transform = '';
        return;
      }
      lines.forEach((line, i) => {
        // a line that already starts close to the header fades over the room it has
        const room = tops[i] - to.bottom;
        const o = Math.min(1, Math.max(0, (room - y) / Math.max(1, Math.min(90, room))));
        line.style.opacity = o < 1 ? o.toFixed(3) : '';
      });
      // ease-out: it shrinks fastest at first, so the lines scrolling up never reach it
      const e = 1 - (1 - p) ** 3;
      const scale = 1 + (to.width / from.width - 1) * e;
      const dx = (to.left - from.left) * e;
      const dy = from.top + (to.top - from.top) * e - (from.top - y);
      brand.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(place);
      }
    };
    const remeasure = () => {
      measure();
      place();
    };
    remeasure();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    void document.fonts?.ready.then(remeasure);
    still.addEventListener('change', remeasure);
  }

  // The story plays once on load, on its own: each beat adds a class (b1 … b5) that brings
  // in or turns a puppet. Scrolling on lets the stage layers drift at their own pace.
  if (story) {
    const phones = [...story.querySelectorAll<HTMLElement>('[data-phone]')];
    const last = 5;
    const show = (beat: number) => {
      for (let i = 1; i <= beat; i += 1) story.classList.add(`b${i}`);
      for (const phone of phones) {
        const screens = [...phone.querySelectorAll<HTMLElement>('[data-from]')];
        const current = screens.filter((screen) => Number(screen.dataset.from) <= beat).at(-1);
        for (const screen of screens) screen.classList.toggle('is-on', screen === current);
      }
    };

    if (still.matches) {
      story.classList.add('is-static');
      show(last);
    } else {
      let beat = 0;
      const next = () => {
        beat += 1;
        show(beat);
        if (beat < last) window.setTimeout(next, 950);
      };
      window.setTimeout(next, 350);

      // parallax: a handful of planes, each moved by its own transform (no style recalc
      // of the whole stage), and only while the stage is on screen
      const planes = [...story.querySelectorAll<HTMLElement>('[data-k]')].map((el) => ({ el, k: Number(el.dataset.k) }));
      let queued = false;
      let height = story.offsetHeight;
      let lastY = -1;
      const drift = () => {
        queued = false;
        const y = Math.min(window.scrollY, height);
        if (y === lastY) return;
        lastY = y;
        for (const { el, k } of planes) el.style.transform = `translate3d(0, ${(y * k).toFixed(1)}px, 0)`;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!queued && (window.scrollY <= height || lastY < height)) {
            queued = true;
            requestAnimationFrame(drift);
          }
        },
        { passive: true },
      );
      window.addEventListener('resize', () => {
        height = story.offsetHeight;
      });
    }
  }
</script>

<style>
  /* ---------- Units and the ground line ----------
     --u: one hundredth of the stage frame. --g: height of the meadow edge (the village's
     ground) above the bottom of the stage. Strip widths (--mw, --hw, --gw, --fw) are at least
     110% of the screen so their cut ends stay off-stage; their heights follow from the
     artwork's aspect ratio. */
  .story {
    --u: min(1vw, 1.6svh);
    --g: calc(25 * var(--u));
    --mw: max(110%, 112 * var(--u));
    --hw: max(110%, 112 * var(--u));
    --gw: max(110%, 112 * var(--u));
    --fiw: max(110%, 128 * var(--u));
    --fw: max(110%, 124 * var(--u));
    --castle-x: 18;
    --lip: calc(3.2 * var(--u));
    --fly-from: 9;
    --fly-span: 14;
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    background: var(--night-900);
    color: #f6e8c6;
  }

  /* ---------- Scene ---------- */
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .scene :global(picture) {
    display: contents;
  }
  .scene :global(.c) {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 0.5rem 0.7rem rgb(0 0 0 / 0.45));
  }
  [data-k] {
    will-change: transform;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    transition: filter 0.8s ease;
  }
  .plane {
    position: absolute;
    inset: 0;
  }
  /* The frame: 100u wide, centred, standing on the bottom of the stage. */
  .stage-frame {
    position: absolute;
    left: 50%;
    right: auto;
    top: 0;
    bottom: 0;
    width: calc(100 * var(--u));
    margin-left: calc(-50 * var(--u));
  }
  .plane--sky :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  /* ---------- The strips, each tucked behind the one in front ---------- */
  .scene :global(.strip) {
    position: absolute;
    left: 50%;
    height: auto;
    max-width: none;
    translate: -50% 0;
  }
  .backdrop {
    --gh: calc(var(--gw) / 8.28);
    --hh: calc(var(--hw) / 3.93);
    --mh: calc(var(--mw) / 3.64);
    /* the hills' top edge: their valley (55% down the strip) sits on the meadow edge */
    --hills-b: calc(var(--g) + var(--hh) * 0.55 - var(--hh));
    /* the mountains reach down past the hills' deepest valley */
    --mountains-b: calc(var(--hills-b) + var(--hh) * 0.34);
  }
  .plane--mountains :global(.strip) {
    bottom: var(--mountains-b);
    width: var(--mw);
    /* the castle stands above the village */
    translate: calc(var(--castle-x) * var(--u) - 66%) 0;
    filter: drop-shadow(0 -0.3rem 1rem rgb(0 0 0 / 0.45));
  }
  .plane--hills :global(.strip) {
    bottom: var(--hills-b);
    width: var(--hw);
    filter: drop-shadow(0 -0.3rem 1rem rgb(0 0 0 / 0.5));
  }
  /* the meadow edge at --g, then the meadow runs on as ground down to the playboard */
  .plane--meadow :global(.strip) {
    bottom: calc(var(--g) - var(--gh));
    width: var(--gw);
    filter: drop-shadow(0 -0.3rem 1rem rgb(0 0 0 / 0.5));
  }
  .plane--meadow::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: calc(var(--g) - var(--gh) + 2px);
    background: linear-gradient(rgb(22 39 38), rgb(15 29 28));
  }
  .plane--field :global(.strip) {
    --fh: calc(var(--fiw) / 8.28);
    bottom: calc(var(--g) - var(--gw) / 8.28 * 0.5 - var(--fh));
    width: var(--fiw);
    filter: brightness(0.9) drop-shadow(0 -0.4rem 0.9rem rgb(0 0 0 / 0.5));
  }
  .plane--front :global(.strip) {
    bottom: calc(var(--lip) - var(--fw) / 8.28);
    width: var(--fw);
    filter: brightness(0.82) drop-shadow(0 -0.4rem 0.9rem rgb(0 0 0 / 0.55));
  }

  /* ---------- Sky ---------- */
  .c-moon {
    left: 54%;
    bottom: calc(var(--mountains-b) + var(--mh) * 0.55);
    width: 15%;
  }
  .c-cloud2 {
    left: 76%;
    bottom: calc(var(--mountains-b) + var(--mh) * 0.9);
    width: 10%;
  }
  .star {
    position: absolute;
    top: calc(var(--y) * 0.32%);
    width: 3px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff3d1;
    box-shadow: 0 0 6px rgb(255 243 209 / 0.8);
    animation: twinkle 3.6s ease-in-out var(--d) infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.2;
      transform: scale(0.6);
    }
  }

  /* ---------- The village: one cluster on the meadow, church beside the houses ---------- */
  .c-houses {
    left: 50%;
    bottom: calc(var(--g) - 2.6 * var(--u));
    width: 22%;
  }
  .c-church {
    left: 45.5%;
    bottom: calc(var(--g) - 1.6 * var(--u));
    width: 6.4%;
  }
  .c-pine1 {
    left: 40.5%;
    bottom: calc(var(--g) - 2.4 * var(--u));
    width: 5.6%;
  }
  .c-pine2 {
    left: 71%;
    bottom: calc(var(--g) - 1.8 * var(--u));
    width: 4.6%;
  }
  .c-fence {
    left: 75%;
    bottom: calc(var(--g) - 3.4 * var(--u));
    width: 6%;
  }
  .fly {
    position: absolute;
    bottom: calc((var(--fly-from) + var(--y) * var(--fly-span)) * var(--u));
    width: 4px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffd27a;
    box-shadow: 0 0 8px 2px rgb(255 196 90 / 0.55);
    opacity: 0;
    animation: fly var(--t) ease-in-out var(--d) infinite;
  }
  @keyframes fly {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    20% {
      opacity: 0.9;
    }
    50% {
      transform: translate(1rem, -1.5rem);
      opacity: 0.5;
    }
    80% {
      opacity: 0.85;
      transform: translate(-0.7rem, -0.6rem);
    }
  }

  /* ---------- Wings ---------- */
  .c-stones {
    left: 0;
    bottom: calc(6 * var(--u));
    width: 9%;
  }
  .c-bush1 {
    left: 13%;
    bottom: calc(7 * var(--u));
    width: 12%;
  }
  .c-bush2 {
    left: 88%;
    bottom: calc(8 * var(--u));
    width: 12%;
  }

  /* ---------- Puppets standing in the playboard ---------- */
  .pp {
    position: absolute;
    bottom: calc(1.4 * var(--u));
    transform-origin: 50% 100%;
    perspective: 70rem;
    transition:
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease;
    animation: hold 5s ease-in-out infinite;
  }
  /* a soft shadow where the puppet meets the ground */
  .pp::before {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -4%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
  }
  /* sizes only: whether a board layer shows is up to `.is-3d` (global.css) */
  .pp :global(.face),
  .pp :global(.frame) {
    width: 100%;
    height: auto;
  }
  .pp :global(.frame) {
    display: block;
  }
  .pp--phone > :global(picture) {
    display: contents;
  }
  @keyframes hold {
    0%,
    100% {
      rotate: -1deg;
    }
    50% {
      rotate: 1deg;
    }
  }
  .pp--wolf {
    left: 5%;
    width: 18%;
    transform: translateY(110%);
    animation-delay: -3s;
  }
  .pp--villager {
    left: 27%;
    width: 12.5%;
    transform: translateX(-90vw) rotate(-8deg);
  }
  .pp--seer {
    left: 40%;
    width: 15%;
    transform: translateY(110%);
    animation-delay: -2s;
  }
  .pp--phone {
    animation-delay: -4s;
  }
  .pp--phone-a {
    left: 57%;
    width: 11%;
    transform: translateX(90vw) rotate(12deg);
  }
  .pp--phone-b {
    left: 69.5%;
    width: 9.5%;
    transform: translateY(120%) rotate(-6deg);
    animation-delay: -1s;
  }
  .pp--maid {
    left: 83%;
    width: 11%;
    transform: translateX(90vw) rotate(8deg);
    animation-delay: -1.5s;
  }
  /* beat 1: villagers come in from both sides */
  .b1 .pp--villager,
  .b1 .pp--maid,
  /* beat 2: the werewolf rises from behind the playboard */
  .b2 .pp--wolf,
  /* beat 3: the phone is held in */
  .b3 .pp--phone-a,
  /* beat 4: night, the seer joins */
  .b4 .pp--seer {
    transform: none;
  }
  .b4 .pp--phone-b {
    transform: rotate(3deg);
  }
  .b4:not(.b5) .backdrop {
    filter: brightness(0.7) saturate(0.9);
  }

  /* ---------- Turning: the puppet spins round, its board edge flashes, then its mirrored
     print shows. In the end every eye is on the wolf: the villager turns at beat 2, the
     seer at beat 5, the maid already looks his way. ---------- */
  .flip {
    position: relative;
    transform-style: preserve-3d;

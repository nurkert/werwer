---
import Base from '../../layouts/Base.astro';
import { repoUrl } from '../../lib/docs';
import { loadImprint } from '../../lib/imprint';
import '../../styles/prose.css';

const imprint = await loadImprint();
---

<Base title="Impressum – Whowolf" description="Impressum der Website whowolf.de.">
  <main class="container legal">
    <article class="prose">
      <h1>Impressum</h1>
      {
        imprint ? (
          <Fragment set:html={imprint.html} />
        ) : (
          <>
            <p>
              Diese Seite wurde aus einer Kopie (Fork) des Whowolf-Projekts gebaut. Wer sie öffentlich betreibt, braucht in der Regel ein eigenes
              Impressum.
            </p>
            <p>
              Betreiber hinterlegen dafür in ihrem Repository die Variable <code>IMPRINT_URL</code> mit der Adresse ihrer Impressums-Seite. Sie
              wird beim Build eingelesen. Das Originalprojekt findest du auf <a href={repoUrl}>GitHub</a>.
            </p>
          </>
        )
      }
    </article>
  </main>
</Base>

<style>
  .legal {
    padding-block: var(--space-5) var(--space-6);
  }
</style>

---
import { getCollection } from 'astro:content';

import Docs from '../../layouts/Docs.astro';
import { docSummary, docTitle, groupDocs, repoUrl } from '../../lib/docs';

const groups = groupDocs(await getCollection('docs'));
---

<Docs title="Docs – Whowolf" description="Vision, Spielregeln, Architektur, Sicherheitskonzept und Entscheidungen von Whowolf, direkt aus dem Repository.">
  <header class="intro">
    <h1>Docs</h1>
    <p>
      Alles, was Whowolf ausmacht: Spielregeln, Architektur, Sicherheitskonzept und jede Entscheidung. Die Seiten werden automatisch aus dem
      Ordner <a href={`${repoUrl}/tree/main/docs`}>docs/</a> im Repository erzeugt und sind deshalb immer aktuell. Die Planungsdokumente sind auf
      Deutsch.
    </p>
  </header>

  {
    groups.map((group) => (
      <section class="group" aria-labelledby={`g-${group.title}`}>
        <h2 id={`g-${group.title}`}>{group.title}</h2>
        <ul>
          {group.items.map((entry) => (
            <li>
              <a href={`/docs/${entry.id}/`}>
                <strong>{docTitle(entry)}</strong>
                <span>{docSummary(entry)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Docs>

<style>
  .intro h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
  }
  .intro p {
    margin-top: var(--space-2);
    max-width: 62ch;
    color: var(--moon-200);
  }
  .group {
    margin-top: var(--space-5);
  }
  .group h2 {
    font-size: 1.6rem;
    color: var(--gold-500);
  }
  .group ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .group a {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: var(--space-3);
    border-radius: var(--radius-m);
    border: 1px solid var(--night-500);
    color: var(--moon-100);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.35s var(--ease-puppet);
  }
  .group a:hover {
    border-color: var(--gold-500);
    transform: translateY(-3px);
  }
  .group strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
  }
  .group span {
    font-size: 0.95rem;
    color: var(--moon-200);
  }
  @media (prefers-reduced-motion: reduce) {
    .group a:hover {
      transform: none;
    }
  }
</style>

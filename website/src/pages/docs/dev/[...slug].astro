---
import { getCollection, render } from 'astro:content';

import Docs from '../../../layouts/Docs.astro';
import { devBase, devNav, docSummary, docTitle, repoUrl, sourcePath } from '../../../lib/docs';
import { path } from '../../../i18n/ui';
import '../../../styles/prose.css';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = docTitle(entry);
const source = sourcePath(entry);
const groups = devNav(await getCollection('docs'), entry.id);
---

<Docs
  lang="de"
  title={`${title} – Whowolf für Entwickler`}
  description={docSummary(entry) || title}
  home={{ href: devBase, label: 'Für Entwickler' }}
  groups={groups}
  aside={{ href: path('docs', 'de'), label: 'Zur Spielanleitung' }}
  headings={headings}
  navLabel="Planungsdokumente"
  noindex
  tocLabel="Auf dieser Seite"
>
  <article class="prose">
    <Content />
  </article>
  <p class="doc-source">
    Diese Seite wird automatisch aus <a href={`${repoUrl}/blob/main/${source}`}>{source}</a> erzeugt.
    <a href={`${repoUrl}/edit/main/${source}`}>Auf GitHub bearbeiten</a>
  </p>
</Docs>

<style>
  .doc-source {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid #b98a43;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .doc-source a + a {
    margin-left: var(--space-2);
  }
</style>
